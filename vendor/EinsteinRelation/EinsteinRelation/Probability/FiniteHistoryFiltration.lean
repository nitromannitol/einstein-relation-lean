import EinsteinRelation.Regeneration.Construction

/-! # Monotonicity of the exact finite-history sigma-algebras

Source `paper/main.tex:353–374,412–420`. The exact finite-history sigma-algebra
`finiteHistorySigma Δ n` is generated by the literal path evaluations `z.1 t` for
`0 ≤ t ≤ nΔ` and the Bernoulli bits `z.2 k` for `k < n`. Both index sets grow with `n`,
so the finite-history sigma-algebras form a filtration. No positivity of `Δ` is used.
-/

open scoped NNReal ENNReal

namespace EinsteinRelation.Regeneration

/-- Source `paper/main.tex:353–374,412–420`. A longer window keeps every generator of a shorter
one: the path through `mΔ ≤ nΔ` and the bits strictly before `m` are among those before `n`. -/
theorem finiteHistorySigma_mono {d : ℕ} (Δ : ℝ≥0) {m n : ℕ} (hmn : m ≤ n) :
    finiteHistorySigma (d := d) Δ m ≤ finiteHistorySigma Δ n := by
  have hΔ : (m : ℝ≥0) * Δ ≤ (n : ℝ≥0) * Δ :=
    mul_le_mul_of_nonneg_right (Nat.cast_le.mpr hmn) zero_le
  unfold finiteHistorySigma
  apply sup_le
  · apply iSup_le
    intro t
    have ht : (t : ℝ≥0) ∈ Set.Icc (0 : ℝ≥0) ((n : ℝ≥0) * Δ) :=
      Set.mem_Icc.mpr ⟨(Set.mem_Icc.mp t.2).1, le_trans (Set.mem_Icc.mp t.2).2 hΔ⟩
    exact le_sup_of_le_left
      (le_iSup_of_le (⟨t.1, ht⟩ : Set.Icc (0 : ℝ≥0) ((n : ℝ≥0) * Δ)) le_rfl)
  · apply iSup_le
    intro k
    exact le_sup_of_le_right
      (le_iSup_of_le (⟨k.1, lt_of_lt_of_le k.2 hmn⟩ : {k : ℕ // k < n}) le_rfl)

end EinsteinRelation.Regeneration
