/-! # Finite-history `L²` approximation

Source `paper/main.tex:412–420`, with the exact finite-history sigma-algebras
`finiteHistorySigma Δ n` of `paper/main.tex:353–374`. Every square-integrable observation of
the coupled sample is an `L²` limit of conditional expectations given the finite-history
sigma-algebras. The route is: the finite-history sigma-algebras form a filtration whose
supremum is the product sigma-algebra (the path Borel sigma-algebra is generated by countably
many evaluations, via the Polish decoder); a bounded observation then converges in `L²` by
Lévy's upward theorem together with uniform integrability; simple functions approximate an
arbitrary `L²` observation.
-/

open MeasureTheory Filter Topology
open scoped NNReal ENNReal

namespace EinsteinRelation.Regeneration

/-- The exact finite-history sigma-algebras form a filtration indexed by the grid length. -/
noncomputable def finiteHistoryFiltration {d : ℕ} (Δ : ℝ≥0) :
    Filtration ℕ (inferInstance : MeasurableSpace (CoupledSample d)) where
  seq n := finiteHistorySigma (d := d) Δ n
  mono' _ _ hmn := finiteHistorySigma_mono Δ hmn
  le' n := EinsteinRelation.Probability.finiteHistorySigma_le Δ n

/-- A path coordinate at a time in the window `[0, nΔ]` is measurable for `finiteHistorySigma`. -/
private theorem comap_path_le_finiteHistorySigma {d : ℕ} (Δ : ℝ≥0) (n : ℕ) (t : ℝ≥0)
    (ht : t ∈ Set.Icc (0 : ℝ≥0) ((n : ℝ≥0) * Δ)) :
    MeasurableSpace.comap (fun z : CoupledSample d => z.1 t) inferInstance ≤
      finiteHistorySigma (d := d) Δ n := by
  unfold finiteHistorySigma
  exact le_sup_of_le_left (le_iSup_of_le (⟨t, ht⟩ : Set.Icc (0 : ℝ≥0) ((n : ℝ≥0) * Δ)) le_rfl)

/-- A Bernoulli bit strictly before `n` is measurable for `finiteHistorySigma`. -/
private theorem comap_bit_le_finiteHistorySigma {d : ℕ} (Δ : ℝ≥0) (n k : ℕ) (hk : k < n) :
    MeasurableSpace.comap (fun z : CoupledSample d => z.2 k) inferInstance ≤
      finiteHistorySigma (d := d) Δ n := by
  unfold finiteHistorySigma
  exact le_sup_of_le_right (le_iSup_of_le (⟨k, hk⟩ : {k : ℕ // k < n}) le_rfl)

/-- Coordinatewise measurability for a product σ-algebra, relative to a fixed sub-σ-algebra `M`. -/
private theorem measurable_pi_of_coords_le {Ω ι : Type*} {E : ι → Type*}
    [mE : ∀ i, MeasurableSpace (E i)] (M : MeasurableSpace Ω) (f : Ω → ∀ i, E i)
    (hf : ∀ i, @Measurable Ω (E i) M (mE i) (fun ω => f ω i)) :
    @Measurable Ω (∀ i, E i) M MeasurableSpace.pi f := by
  rw [measurable_iff_comap_le, MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  refine iSup_le fun i => ?_
  rw [MeasurableSpace.comap_comp]
  exact measurable_iff_comap_le.mp (hf i)

/-- The finite-history sigma-algebras exhaust the product sigma-algebra on the coupled sample.
The path Borel sigma-algebra is the countable-evaluation sigma-algebra through the Polish
decoder `exists_measurable_continuousMap_decoder`, and each evaluation time lies in some window. -/
private theorem le_iSup_finiteHistorySigma {d : ℕ} (Δ : ℝ≥0) (hΔ : 0 < Δ) :
    (inferInstance : MeasurableSpace (CoupledSample d)) ≤
      ⨆ n : ℕ, finiteHistorySigma (d := d) Δ n := by
  haveI : PolishSpace (Path d) := by
    haveI : CompleteSpace (Path d) := inferInstance
    haveI : Filter.IsCountablyGenerated (uniformity (Path d)) := inferInstance
    haveI : SecondCountableTopology (Path d) := inferInstance
    infer_instance
  obtain ⟨D, hDm, hDinv⟩ :=
    EinsteinRelation.Probability.exists_measurable_continuousMap_decoder (X := ℝ≥0) (E := Vec d)
  set M : MeasurableSpace (CoupledSample d) := ⨆ n : ℕ, finiteHistorySigma (d := d) Δ n
  have hpath : ∀ t : ℝ≥0,
      MeasurableSpace.comap (fun z : CoupledSample d => z.1 t) inferInstance ≤ M := by
    intro t
    obtain ⟨n, hn⟩ := exists_nat_ge (t / Δ)
    have ht : t ≤ (n : ℝ≥0) * Δ := (div_le_iff₀ hΔ).mp hn
    exact (comap_path_le_finiteHistorySigma Δ n t ⟨zero_le, ht⟩).trans
      (le_iSup (fun m : ℕ => finiteHistorySigma (d := d) Δ m) n)
  have hbit : ∀ k : ℕ,
      MeasurableSpace.comap (fun z : CoupledSample d => z.2 k) inferInstance ≤ M := by
    intro k
    exact (comap_bit_le_finiteHistorySigma Δ (k + 1) k (Nat.lt_succ_self k)).trans
      (le_iSup (fun m : ℕ => finiteHistorySigma (d := d) Δ m) (k + 1))
  have hΨ : @Measurable (CoupledSample d) (ℝ≥0 → Vec d) M MeasurableSpace.pi
      (fun z t => z.1 t) :=
    measurable_pi_of_coords_le M _ fun t => measurable_iff_comap_le.mpr (hpath t)
  have hfst : @Measurable (CoupledSample d) (Path d) M inferInstance (fun z => z.1) := by
    have heq : (fun z : CoupledSample d => z.1) =
        D ∘ fun (z : CoupledSample d) (t : ℝ≥0) => z.1 t :=
      funext fun z => (hDinv z.1).symm
    rw [heq]
    exact hDm.comp hΨ
  have hsnd : @Measurable (CoupledSample d) (ℕ → Bool) M MeasurableSpace.pi (fun z => z.2) :=
    measurable_pi_of_coords_le M _ fun k => measurable_iff_comap_le.mpr (hbit k)
  show MeasurableSpace.comap (fun z : CoupledSample d => z.1) inferInstance ⊔
      MeasurableSpace.comap (fun z : CoupledSample d => z.2) inferInstance ≤ M
  exact sup_le (measurable_iff_comap_le.mp hfst) (measurable_iff_comap_le.mp hsnd)

/-- The conditional expectation of a function bounded by `R` is bounded by `R` almost surely,
so the truncation indicator at level `R + 1` vanishes almost surely. -/
private theorem indicator_threshold_ae_eq_zero {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (g : Ω → ℝ) (R : ℝ≥0) (hg : ∀ᵐ x ∂μ, |g x| ≤ R) :
    {x | R + 1 ≤ ‖g x‖₊}.indicator g =ᵐ[μ] 0 := by
  filter_upwards [hg] with x hx
  have hnot : x ∉ {x | R + 1 ≤ ‖g x‖₊} := by
    intro hmem
    have hmem' : R + 1 ≤ ‖g x‖₊ := hmem
    have h1 : ((R + 1 : ℝ≥0) : ℝ) ≤ ‖g x‖ := NNReal.coe_le_coe.mpr hmem'
    rw [Real.norm_eq_abs] at h1
    push_cast at h1
    linarith
  exact Set.indicator_of_notMem hnot g

/-- Conditional expectations given the finite-history sigma-algebras are strongly measurable
for them. -/
private theorem aestronglyMeasurable_condExp_finiteHistory {d : ℕ}
    (μ : Measure (CoupledSample d)) (Δ : ℝ≥0) (h : CoupledSample d → ℝ) (n : ℕ) :
    AEStronglyMeasurable (μ[h|finiteHistorySigma (d := d) Δ n]) μ :=
  (stronglyMeasurable_condExp.mono
    (EinsteinRelation.Probability.finiteHistorySigma_le (d := d) Δ n)).aestronglyMeasurable

/-- A bounded measurable observation is approximated in `L²` by its conditional expectations
given the finite-history sigma-algebras: Lévy's upward theorem gives almost sure convergence, and
the uniform bound gives uniform integrability in `L²`. -/
private theorem tendsto_eLpNorm_condExp_finiteHistory_of_bound {d : ℕ}
    (μ : Measure (CoupledSample d)) [IsProbabilityMeasure μ] (Δ : ℝ≥0) (hΔ : 0 < Δ)
    (h : CoupledSample d → ℝ) (hh : Measurable h) (R : ℝ≥0) (hR : ∀ z, |h z| ≤ R) :
    Tendsto (fun n : ℕ => eLpNorm (μ[h|finiteHistorySigma (d := d) Δ n] - h) 2 μ) atTop
      (𝓝 0) := by
  have hbdd : ∀ᵐ z ∂μ, |h z| ≤ R := ae_of_all μ hR
  have hnorm : ∀ᵐ z ∂μ, ‖h z‖ ≤ (R : ℝ) :=
    ae_of_all μ fun z => by rw [Real.norm_eq_abs]; exact hR z
  have hint : Integrable h μ := Integrable.of_bound hh.aestronglyMeasurable R hnorm
  have hmem : MemLp h 2 μ := MemLp.of_bound hh.aestronglyMeasurable R hnorm
  have hM : @Measurable (CoupledSample d) ℝ (⨆ n : ℕ, finiteHistorySigma (d := d) Δ n)
      inferInstance h :=
    hh.mono (le_iSup_finiteHistorySigma Δ hΔ) le_rfl
  have hae : ∀ᵐ z ∂μ, Tendsto (fun n : ℕ => μ[h|finiteHistorySigma (d := d) Δ n] z) atTop
      (𝓝 (h z)) :=
    hint.tendsto_ae_condExp (ℱ := finiteHistoryFiltration (d := d) Δ) hM.stronglyMeasurable
  have hui : UnifIntegrable (fun n : ℕ => μ[h|finiteHistorySigma (d := d) Δ n]) 2 μ := by
    refine unifIntegrable_of one_le_two (by simp)
      (fun n => aestronglyMeasurable_condExp_finiteHistory μ Δ h n) ?_
    intro ε _
    refine ⟨R + 1, fun n => ?_⟩
    have hG : ∀ᵐ z ∂μ, |μ[h|finiteHistorySigma (d := d) Δ n] z| ≤ R :=
      ae_bdd_condExp_of_ae_bdd hbdd
    show eLpNorm ({z | R + 1 ≤ ‖μ[h|finiteHistorySigma (d := d) Δ n] z‖₊}.indicator
      (μ[h|finiteHistorySigma (d := d) Δ n])) 2 μ ≤ ε
    rw [eLpNorm_congr_ae
      (indicator_threshold_ae_eq_zero (μ[h|finiteHistorySigma (d := d) Δ n]) R hG), eLpNorm_zero]
    exact zero_le
  exact tendsto_Lp_finite_of_tendsto_ae one_le_two (by simp)
    (fun n => aestronglyMeasurable_condExp_finiteHistory μ Δ h n) hmem hui hae

/-- Source `paper/main.tex:412–420`. For a probability law on the coupled sample, every
square-integrable observation is approximated in `L²`, to any positive tolerance, by a function
measurable for an exact finite-history sigma-algebra `finiteHistorySigma Δ n`. -/
theorem exists_finiteHistory_Lp_approximation {d : ℕ} (μ : Measure (CoupledSample d))
    [IsProbabilityMeasure μ] (Δ : ℝ≥0) (hΔ : 0 < Δ) (F : CoupledSample d → ℝ) (hF : MemLp F 2 μ)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ n : ℕ, ∃ G : CoupledSample d → ℝ,
      @Measurable (CoupledSample d) ℝ (finiteHistorySigma Δ n) inferInstance G ∧
      MemLp G 2 μ ∧ eLpNorm (fun z => G z - F z) 2 μ < ENNReal.ofReal ε := by
  obtain ⟨s, hsF, hsMem⟩ :=
    hF.exists_simpleFunc_eLpNorm_sub_lt (by simp) (ENNReal.ofReal_pos.mpr (half_pos hε)).ne'
  obtain ⟨R, hR⟩ : ∃ R : ℝ≥0, ∀ z, |(s : CoupledSample d → ℝ) z| ≤ R := by
    obtain ⟨C, hC⟩ := s.exists_forall_norm_le
    exact ⟨C.toNNReal, fun z => by
      rw [← Real.norm_eq_abs]
      exact (hC z).trans (Real.le_coe_toNNReal C)⟩
  have hT := tendsto_eLpNorm_condExp_finiteHistory_of_bound μ Δ hΔ (s : CoupledSample d → ℝ)
    s.measurable R hR
  obtain ⟨n, hn⟩ := ((tendsto_order.1 hT).2 (ENNReal.ofReal (ε / 2))
    (ENNReal.ofReal_pos.mpr (half_pos hε))).exists
  refine ⟨n, μ[(s : CoupledSample d → ℝ)|finiteHistorySigma (d := d) Δ n], ?_, hsMem.condExp one_le_two, ?_⟩
  · exact (stronglyMeasurable_condExp :
      @StronglyMeasurable (CoupledSample d) ℝ _ (finiteHistorySigma (d := d) Δ n)
        (μ[(s : CoupledSample d → ℝ)|finiteHistorySigma (d := d) Δ n])).measurable
  · have hGae : AEStronglyMeasurable
        (μ[(s : CoupledSample d → ℝ)|finiteHistorySigma (d := d) Δ n]) μ :=
      aestronglyMeasurable_condExp_finiteHistory μ Δ _ n
    have hsae : AEStronglyMeasurable (s : CoupledSample d → ℝ) μ := s.aestronglyMeasurable
    have hFae : AEStronglyMeasurable F μ := hF.aestronglyMeasurable
    have hsplit : (fun z => μ[(s : CoupledSample d → ℝ)|finiteHistorySigma (d := d) Δ n] z - F z)
        = (μ[(s : CoupledSample d → ℝ)|finiteHistorySigma (d := d) Δ n] - (s : CoupledSample d → ℝ))
          + ((s : CoupledSample d → ℝ) - F) := by
      funext z
      simp only [Pi.add_apply, Pi.sub_apply]
      ring
    have hneg : ((s : CoupledSample d → ℝ) - F) = -(F - (s : CoupledSample d → ℝ)) := by
      funext z
      simp only [Pi.sub_apply, Pi.neg_apply]
      ring
    rw [hsplit]
    calc eLpNorm (μ[(s : CoupledSample d → ℝ)|finiteHistorySigma (d := d) Δ n]
            - (s : CoupledSample d → ℝ) + ((s : CoupledSample d → ℝ) - F)) 2 μ
        ≤ eLpNorm (μ[(s : CoupledSample d → ℝ)|finiteHistorySigma (d := d) Δ n]
            - (s : CoupledSample d → ℝ)) 2 μ + eLpNorm ((s : CoupledSample d → ℝ) - F) 2 μ :=
          eLpNorm_add_le one_le_two
      _ = eLpNorm (μ[(s : CoupledSample d → ℝ)|finiteHistorySigma (d := d) Δ n]
            - (s : CoupledSample d → ℝ)) 2 μ + eLpNorm (F - (s : CoupledSample d → ℝ)) 2 μ := by
          rw [hneg, eLpNorm_neg]
      _ < ENNReal.ofReal (ε / 2) + ENNReal.ofReal (ε / 2) := ENNReal.add_lt_add hn hsF
      _ = ENNReal.ofReal ε := by
          rw [← ENNReal.ofReal_add (half_pos hε).le (half_pos hε).le]
          congr 1
          ring

end EinsteinRelation.Regeneration
