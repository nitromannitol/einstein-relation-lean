import EinsteinRelation.Sharpness.CoordinateIterates
import EinsteinRelation.Sharpness.NoiseFieldDerivatives
import EinsteinRelation.Sharpness.NoiseFieldLocality
import Mathlib.Analysis.Calculus.FDeriv.Const
import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic
import Mathlib.MeasureTheory.MeasurableSpace.Basic
import Mathlib.Order.CompleteLattice.Basic
import Mathlib.Topology.Algebra.Support
import Mathlib.Topology.Closure

/-! # Local observations of the actual iterated derivatives of the smoothed field

Source: `paper/main.tex`, proof of Proposition 7.1, Step 1, lines 1212–1231. Every actual iterated
coordinate derivative of the literal field `h ≔ ζ * tanh(K * W)` is the same outer convolution with
the derivative of the fixed kernel `ζ`. The compact support containment is a property of this
kernel derivative: its support lies in `tsupport ζ`. Hence each such derivative at a point `x`
is a measurable function of the same compact observations `(K * W)(x - y)`, `y ∈ tsupport ζ`,
that govern `h` itself. This containment concerns the kernel derivative only; it is not a claim
about the support of a coordinate derivative of `h`. The results add no global noise sigma, no
law of `W`, and no regularity or finite-range assumption. -/

open MeasureTheory

namespace EinsteinRelation.Sharpness

/-- One actual coordinate derivative does not enlarge the topological support. Outside
`tsupport f` the Fréchet derivative vanishes, so its value in the direction `unitVector i`
vanishes there too. -/
private theorem tsupport_coordinateDerivative_subset {d : ℕ} (i : Fin d) (f : Vec d → ℝ) :
    tsupport (coordinateDerivative i f) ⊆ tsupport f := by
  refine closure_minimal ?_ (isClosed_tsupport f)
  intro x hx
  by_contra hfx
  have hzero : coordinateDerivative i f x = 0 := by
    simp only [coordinateDerivative, fderiv_of_notMem_tsupport ℝ hfx,
      ContinuousLinearMap.zero_apply]
  exact (Function.mem_support.mp hx) hzero

/-- Iterated actual coordinate derivatives do not enlarge the topological support. -/
theorem tsupport_iteratedCoordinateDerivative_subset {d : ℕ}
    (g : Vec d → ℝ) (is : List (Fin d)) :
  tsupport (iteratedCoordinateDerivative is g) ⊆ tsupport g := by
  induction is with
  | nil => exact subset_rfl
  | cons i is ih =>
    rw [iteratedCoordinateDerivative_cons]
    exact (tsupport_coordinateDerivative_subset i (iteratedCoordinateDerivative is g)).trans ih

/-- The actual iterated coordinate derivative of the supplied compact smooth test `ζ`, packaged as
a compact smooth test. No kernel is chosen: this is exactly the derivative of the given `ζ`. -/
private noncomputable def iteratedDerivativeTest {d : ℕ} (is : List (Fin d)) (ζ : NoiseTest d) :
    NoiseTest d where
  toFun := iteratedCoordinateDerivative is (ζ : Vec d → ℝ)
  contDiff' := contDiff_iteratedCoordinateDerivative (ζ : Vec d → ℝ) ζ.contDiff is
  hasCompactSupport' :=
    hasCompactSupport_iteratedCoordinateDerivative (ζ : Vec d → ℝ) ζ.hasCompactSupport is
  tsupport_subset' := Set.subset_univ _

/-- Source: `paper/main.tex`, proof of Proposition 7.1, Step 1, lines 1212–1231. For a compact
smooth test `ζ`, a kernel `K`, and an actual sample `W`, each actual iterated coordinate derivative
of the literal field `ζ * tanh(K * W)` at `x` is measurable with respect to the sigma algebra
generated by the observations `(K * W)(x - y)` with `y ∈ tsupport ζ`. The index set is `tsupport ζ`,
not `{y | ζ y ≠ 0}`: a derivative of `ζ` can be nonzero at a point where `ζ` itself vanishes, and
such a point lies in `tsupport ζ`. -/
theorem measurable_iterated_smoothedNoiseField_local {Ω : Type*} {d : ℕ}
    (W : Ω → NoiseSample d) (ζ K : NoiseTest d) (is : List (Fin d)) (x : Vec d) :
  @Measurable Ω ℝ
    (⨆ y : tsupport (ζ : Vec d → ℝ), (borel ℝ).comap
      (fun ω => mollifiedNoise (W ω) K (x-y.1))) (borel ℝ)
    (fun ω => iteratedCoordinateDerivative is (smoothedNoiseField ζ K (W ω)) x) := by
  have hpt : ∀ ω : Ω, iteratedCoordinateDerivative is (smoothedNoiseField ζ K (W ω)) x =
      smoothedNoiseField (iteratedDerivativeTest is ζ) K (W ω) x :=
    fun ω => iteratedCoordinateDerivative_smoothedNoiseField ζ K (W ω) is x
  have hfun : (fun ω => iteratedCoordinateDerivative is (smoothedNoiseField ζ K (W ω)) x) =
      fun ω => smoothedNoiseField (iteratedDerivativeTest is ζ) K (W ω) x :=
    funext hpt
  have hsub : (⨆ y : {y : Vec d // iteratedDerivativeTest is ζ y ≠ 0},
      (borel ℝ).comap (fun ω => mollifiedNoise (W ω) K (x-y.1))) ≤
      ⨆ y : tsupport (ζ : Vec d → ℝ), (borel ℝ).comap
        (fun ω => mollifiedNoise (W ω) K (x-y.1)) := by
    refine iSup_le fun y => ?_
    have hderiv : y.1 ∈ tsupport (iteratedCoordinateDerivative is (ζ : Vec d → ℝ)) :=
      subset_tsupport (iteratedDerivativeTest is ζ : Vec d → ℝ) (Function.mem_support.mpr y.2)
    have hζ : y.1 ∈ tsupport (ζ : Vec d → ℝ) :=
      tsupport_iteratedCoordinateDerivative_subset (ζ : Vec d → ℝ) is hderiv
    exact le_iSup_of_le (⟨y.1, hζ⟩ : tsupport (ζ : Vec d → ℝ)) le_rfl
  rw [hfun]
  exact (measurable_smoothedNoiseField_local W (iteratedDerivativeTest is ζ) K x).mono hsub le_rfl

end EinsteinRelation.Sharpness
