import EinsteinRelation.Sharpness.NoiseField
import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic
import Mathlib.MeasureTheory.Function.StronglyMeasurable.Basic
import Mathlib.MeasureTheory.Group.Arithmetic
import Mathlib.MeasureTheory.Integral.Bochner.Basic
import Mathlib.MeasureTheory.MeasurableSpace.Basic
import Mathlib.MeasureTheory.MeasurableSpace.Constructions

/-! # Local measurability of the literal smoothed field

Source paper/main.tex1212–1216: the literal field `h = ζ * tanh(K * W)` at a point `x` depends
measurably only on the actual local observations `W ↦ (K * W)(x - y)` at the points `y` where
`ζ y ≠ 0`, the ones entering its compact convolution. This is internal infrastructure for
finite-range sigma independence. It introduces no global noise sigma, no law of `W`, and no
assumed local-field or sharpness result. -/

open MeasureTheory

namespace EinsteinRelation.Sharpness

private theorem continuous_locality_tanh : Continuous Real.tanh := by
  have heq : Real.tanh = fun t => Real.sinh t / Real.cosh t :=
    funext Real.tanh_eq_sinh_div_cosh
  rw [heq]
  exact Real.continuous_sinh.div₀ Real.continuous_cosh (fun t => (Real.cosh_pos t).ne')

/-- The literal smoothed field is measurable for any sigma algebra on the sample space that makes
each actual observation `ω ↦ (K * W ω)(x - y)` with `ζ y ≠ 0` measurable. -/
private theorem measurable_smoothedNoiseField_of_local {Ω : Type*} [MeasurableSpace Ω]
    {d : ℕ} (W : Ω → NoiseSample d) (ζ K : NoiseTest d) (x : Vec d)
    (hobs : ∀ y : Vec d, ζ y ≠ 0 → Measurable (fun ω => mollifiedNoise (W ω) K (x - y))) :
    Measurable (fun ω => smoothedNoiseField ζ K (W ω) x) := by
  have hT : ∀ y : Vec d,
      Measurable (fun ω : Ω => ζ y * Real.tanh (mollifiedNoise (W ω) K (x - y))) := by
    intro y
    by_cases hy : ζ y = 0
    · simp only [hy, zero_mul]
      exact measurable_const
    · exact (continuous_locality_tanh.measurable.comp (hobs y hy)).const_mul (ζ y)
  have hcont : ∀ ω : Ω,
      Continuous (fun y : Vec d => ζ y * Real.tanh (mollifiedNoise (W ω) K (x - y))) :=
    fun ω => ζ.contDiff.continuous.mul (continuous_locality_tanh.comp
      ((continuous_mollifiedNoise (W ω) K).comp (continuous_const.sub continuous_id)))
  have hU : Measurable (fun p : Ω × Vec d =>
      ζ p.2 * Real.tanh (mollifiedNoise (W p.1) K (x - p.2))) :=
    (MeasureTheory.measurable_uncurry_of_continuous_of_measurable
      (u := fun (y : Vec d) (ω : Ω) => ζ y * Real.tanh (mollifiedNoise (W ω) K (x - y)))
      hcont hT).comp measurable_swap
  have hsm : StronglyMeasurable (fun p : Ω × Vec d =>
      ζ p.2 * Real.tanh (mollifiedNoise (W p.1) K (x - p.2))) :=
    hU.stronglyMeasurable
  exact hsm.integral_prod_right'.measurable

/-- The literal smoothed field `ζ * tanh(K * W)` is measurable with respect to the sigma algebra
generated by the actual local observations `(K * W)(x - y)` with `ζ y ≠ 0`. This is the internal
local-observation sigma algebra, not a global noise sigma. -/
theorem measurable_smoothedNoiseField_local {Ω : Type*} {d : ℕ}
    (W : Ω → NoiseSample d) (ζ K : NoiseTest d) (x : Vec d) :
  @Measurable Ω ℝ
    (⨆ y : {y : Vec d // ζ y ≠ 0}, (borel ℝ).comap
      (fun ω => mollifiedNoise (W ω) K (x-y.1))) (borel ℝ)
    (fun ω => smoothedNoiseField ζ K (W ω) x) :=
  @measurable_smoothedNoiseField_of_local Ω
    (⨆ y : {y : Vec d // ζ y ≠ 0}, (borel ℝ).comap
      (fun ω => mollifiedNoise (W ω) K (x-y.1))) d W ζ K x
    (fun y hy => measurable_iff_comap_le.mpr
      (le_iSup (fun y' : {y : Vec d // ζ y ≠ 0} => (borel ℝ).comap
        (fun ω => mollifiedNoise (W ω) K (x-y'.1))) ⟨y, hy⟩))

/-- Two actual samples that agree on every local observation `(K * ·)(x - y)` with `ζ y ≠ 0`
have the same literal smoothed field at `x`. The pointwise integrands agree everywhere: where
`ζ y = 0` both vanish, and elsewhere the hypothesis gives equal observations. -/
theorem smoothedNoiseField_eq_of_local_observations {d : ℕ}
    (ζ K : NoiseTest d) (W W' : NoiseSample d) (x : Vec d)
    (heq : ∀ y : Vec d, ζ y ≠ 0 → mollifiedNoise W K (x-y) = mollifiedNoise W' K (x-y)) :
  smoothedNoiseField ζ K W x = smoothedNoiseField ζ K W' x := by
  simp only [smoothedNoiseField_apply]
  congr 1
  funext y
  by_cases hy : ζ y = 0
  · simp only [hy, zero_mul]
  · simp only [heq y hy]

end EinsteinRelation.Sharpness
