import EinsteinRelation.Sharpness.NoiseKernel

/-! # The generic scalar white-noise input

AKM, Definition 5.1, Proposition 5.14 and Remark 5.15, printed pp. 192,
201–202. The input asks only for a law on genuine distributions, observed by
compact smooth test evaluations. It does not assume the manuscript's bounded
smooth finite-range field or any sharpness conclusion.

The measurable space below is generated by evaluations; no assertion about the
Borel sigma algebra of the compact-convergence dual topology is made. The
existence proposition is an explicit external hypothesis, not a project axiom.
-/

open MeasureTheory

namespace EinsteinRelation.External

open Sharpness

/-- The sigma algebra generated by all actual compact smooth test evaluations. -/
noncomputable def noiseSigma (d : ℕ) : MeasurableSpace (NoiseSample d) :=
  ⨆ f : NoiseTest d, (borel ℝ).comap (fun W : NoiseSample d => W f)

noncomputable instance (d : ℕ) : MeasurableSpace (NoiseSample d) := noiseSigma d

/-- Every evaluation is measurable by the defining observation sigma algebra. -/
theorem measurable_noiseEvaluation {d : ℕ} (f : NoiseTest d) :
    Measurable (fun W : NoiseSample d => W f) := by
  rw [measurable_iff_comap_le]
  exact le_iSup (fun g : NoiseTest d => (borel ℝ).comap (fun W : NoiseSample d => W g)) f

/-- Unit-variance scalar white noise, restricted to its legitimate smooth compact
tests. Simultaneous samplewise linearity and continuity are supplied by the
actual `Distribution` carrier, while this clause specifies each Gaussian law. -/
def IsWhiteNoiseLaw {d : ℕ} (P : Measure (NoiseSample d)) : Prop :=
  IsProbabilityMeasure P ∧ ∀ (f : NoiseTest d) (r : ℝ),
    (∫ W, Complex.exp (Complex.I * (r : ℂ) * (W f : ℂ)) ∂P) =
      Complex.exp (((-(1 / 2 : ℝ)) * r ^ 2 * ∫ y : Vec d, (f y) ^ 2) : ℂ)

/-- The permitted generic existence input from AKM Proposition 5.14. This is
only a proposition to be supplied explicitly by a conditional theorem. -/
def WhiteNoiseExistence (d : ℕ) : Prop :=
  ∃ P : Measure (NoiseSample d), IsWhiteNoiseLaw P

/-- The contract has a concrete first consumer at the actual translated kernel:
the convolution is measurable and its characteristic function has the Gaussian
formula with parameter `∫ K²`. -/
theorem IsWhiteNoiseLaw.mollifiedNoise {d : ℕ} {P : Measure (NoiseSample d)}
    (hP : IsWhiteNoiseLaw P) (K : NoiseTest d) (x : Vec d) :
    Measurable (fun W : NoiseSample d => Sharpness.mollifiedNoise W K x) ∧
    ∀ r : ℝ,
      (∫ W, Complex.exp (Complex.I * (r : ℂ) *
          (Sharpness.mollifiedNoise W K x : ℂ)) ∂P) =
        Complex.exp (((-(1 / 2 : ℝ)) * r ^ 2 * ∫ y : Vec d, (K y) ^ 2) : ℂ) := by
  letI : IsProbabilityMeasure P := hP.1
  exact ⟨measurable_noiseEvaluation (kernelTest K x),
    fun r => mollifiedNoise_characteristic P id hP.2 K x r⟩

/-- The existence input supplies one actual distribution law and its genuine
convolution observations at every point. All subsequent bounded smoothing,
stationarity, finite range and nondegeneracy arguments remain internal. -/
theorem WhiteNoiseExistence.has_mollifiedNoise {d : ℕ} (h : WhiteNoiseExistence d)
    (K : NoiseTest d) :
    ∃ P : Measure (NoiseSample d), IsWhiteNoiseLaw P ∧ ∀ x : Vec d,
      Measurable (fun W : NoiseSample d => Sharpness.mollifiedNoise W K x) ∧
      ∀ r : ℝ,
        (∫ W, Complex.exp (Complex.I * (r : ℂ) *
            (Sharpness.mollifiedNoise W K x : ℂ)) ∂P) =
          Complex.exp (((-(1 / 2 : ℝ)) * r ^ 2 * ∫ y : Vec d, (K y) ^ 2) : ℂ) := by
  obtain ⟨P, hP⟩ := h
  exact ⟨P, hP, fun x => hP.mollifiedNoise K x⟩

end EinsteinRelation.External
