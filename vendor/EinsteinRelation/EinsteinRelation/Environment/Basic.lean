import Mathlib.Analysis.SpecialFunctions.Sqrt
import Mathlib.Topology.ContinuousMap.Algebra
import Mathlib.Topology.Instances.Matrix
import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic
import Mathlib.Probability.Independence.Basic

/-! # Coefficient pairs and their translation law

Vectors use coordinate functions. All geometric bounds below use the explicitly
defined Euclidean norm, including the operator norm bound for matrix differences.
-/

open MeasureTheory
open scoped BigOperators Matrix

namespace EinsteinRelation

abbrev Vec (d : ℕ) := Fin d → ℝ
abbrev Mat (d : ℕ) := Matrix (Fin d) (Fin d) ℝ

/-- Euclidean scalar product in coordinates. -/
def dot {d : ℕ} (x y : Vec d) : ℝ := ∑ i, x i * y i

/-- Squared Euclidean norm, without a change of the ambient function norm instance. -/
def euclideanSq {d : ℕ} (x : Vec d) : ℝ := dot x x

/-- The Euclidean norm used in all source-facing estimates. -/
noncomputable def euclideanNorm {d : ℕ} (x : Vec d) : ℝ := Real.sqrt (euclideanSq x)

/-- A coordinate unit vector; the force direction is `unitVector ⟨0, hd⟩`. -/
def unitVector {d : ℕ} (i : Fin d) : Vec d := Pi.single i 1

/-- A continuous coefficient field and continuous scalar field. For the physical
environment these are `(a₀,V)`; for the reduced environment they are `(a,μ)`. -/
abbrev FieldPair (d : ℕ) := C(Vec d, Mat d) × C(Vec d, ℝ)

instance (d : ℕ) : MeasurableSpace (Mat d) := borel (Mat d)
instance (d : ℕ) : BorelSpace (Mat d) := ⟨rfl⟩
instance (d : ℕ) : MeasurableSpace (FieldPair d) := borel (FieldPair d)
instance (d : ℕ) : BorelSpace (FieldPair d) := ⟨rfl⟩

/-- Translation of both components of a coefficient pair. -/
def translate {d : ℕ} (x : Vec d) (ω : FieldPair d) : FieldPair d :=
  (⟨fun y => ω.1 (x + y), ω.1.continuous.comp (continuous_const.add continuous_id)⟩,
   ⟨fun y => ω.2 (x + y), ω.2.continuous.comp (continuous_const.add continuous_id)⟩)

@[simp] theorem translate_matrix {d : ℕ} (x y : Vec d) (ω : FieldPair d) :
    (translate x ω).1 y = ω.1 (x + y) := rfl

@[simp] theorem translate_scalar {d : ℕ} (x y : Vec d) (ω : FieldPair d) :
    (translate x ω).2 y = ω.2 (x + y) := rfl

@[simp] theorem translate_zero {d : ℕ} (ω : FieldPair d) : translate 0 ω = ω := by
  apply Prod.ext <;> ext y <;> simp [translate]

theorem translate_add {d : ℕ} (x y : Vec d) (ω : FieldPair d) :
    translate x (translate y ω) = translate (x + y) ω := by
  apply Prod.ext <;> ext z <;> simp [translate, add_left_comm, add_assoc]

/-- The σ-algebra generated by the joint field restricted to a set. -/
def localSigma {d : ℕ} (U : Set (Vec d)) : MeasurableSpace (FieldPair d) :=
  ⨆ x : U, MeasurableSpace.comap (fun ω : FieldPair d => (ω.1 x, ω.2 x)) inferInstance

/-- Invariance of the joint law under every spatial translation. -/
def IsStationary {d : ℕ} (Q : Measure (FieldPair d)) : Prop :=
  ∀ x : Vec d, Measure.map (translate x) Q = Q

/-- Joint finite range of dependence. The lower bound `s > r₀` records a strict
gap between the sets, including when their distance infimum is not attained. -/
def HasFiniteRange {d : ℕ} (r₀ : ℝ) (Q : Measure (FieldPair d)) : Prop :=
  ∀ U W : Set (Vec d), MeasurableSet U → MeasurableSet W →
    (∃ s : ℝ, r₀ < s ∧ ∀ x ∈ U, ∀ y ∈ W, s ≤ euclideanNorm (x - y)) →
    ProbabilityTheory.Indep (localSigma U) (localSigma W) Q

/-- Pointwise symmetric ellipticity in the Euclidean quadratic form. -/
def IsElliptic {d : ℕ} (Λ : ℝ) (a : Vec d → Mat d) : Prop :=
  ∀ x, (a x).transpose = a x ∧ ∀ ξ : Vec d,
    Λ⁻¹ * euclideanSq ξ ≤ dot ξ ((a x).mulVec ξ) ∧
    dot ξ ((a x).mulVec ξ) ≤ Λ * euclideanSq ξ

/-- Lipschitz regularity of a matrix field in the Euclidean operator norm. -/
def IsOperatorLipschitz {d : ℕ} (L : ℝ) (a : Vec d → Mat d) : Prop :=
  ∀ x y ξ : Vec d,
    euclideanNorm ((a x - a y).mulVec ξ) ≤
      L * euclideanNorm (x - y) * euclideanNorm ξ

/-- Assumption 1.1 (S1)--(S3) on a single physical environment. -/
def IsRegular {d : ℕ} (Λ₀ : ℝ) (ω : FieldPair d) : Prop :=
  IsElliptic Λ₀ ω.1 ∧ (∀ x, |ω.2 x| ≤ Λ₀) ∧
  IsOperatorLipschitz Λ₀ ω.1 ∧
  ∀ x y, |ω.2 x - ω.2 y| ≤ Λ₀ * euclideanNorm (x - y)

/-- The joint environment law of Assumption 1.1. No isotropy is imposed. -/
structure EnvironmentLaw (d : ℕ) (Λ₀ r₀ : ℝ) where
  measure : Measure (FieldPair d)
  probability : IsProbabilityMeasure measure
  ellipticity_parameter : 1 ≤ Λ₀
  range_parameter : 1 ≤ r₀
  regular : ∀ᵐ ω ∂measure, IsRegular Λ₀ ω
  stationary : IsStationary measure
  finiteRange : HasFiniteRange r₀ measure

instance {d : ℕ} {Λ₀ r₀ : ℝ} (Q : EnvironmentLaw d Λ₀ r₀) :
    IsProbabilityMeasure Q.measure := Q.probability

end EinsteinRelation
