open EinsteinRelation

abbrev LatticeIndex (d : ℕ) := Fin d → ℤ

def latticeShift {d : ℕ} (z : LatticeIndex d) : Vec d := fun i => (z i : ℝ)

theorem euclideanSq_smul {d : ℕ} (c : ℝ) (x : Vec d) :
    euclideanSq (c • x) = c ^ 2 * euclideanSq x := by
  change (∑ i, (c * x i) * (c * x i)) = c ^ 2 * ∑ i, x i * x i
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  ring

theorem euclideanNorm_smul {d : ℕ} (c : ℝ) (hc : 0 ≤ c) (x : Vec d) :
    euclideanNorm (c • x) = c * euclideanNorm x := by
  unfold euclideanNorm
  rw [euclideanSq_smul, Real.sqrt_mul (sq_nonneg c), Real.sqrt_sq_eq_abs,
    abs_of_nonneg hc]

/-- The compactly supported smooth scalar tests used to observe AKM coefficients. -/
structure SmoothCompactTest (d : ℕ) where
  toFun : Vec d → ℝ
  smooth : ContDiff ℝ (⊤ : ℕ∞) toFun
  compact : HasCompactSupport toFun

instance {d : ℕ} : CoeFun (SmoothCompactTest d) (fun _ => Vec d → ℝ) :=
  ⟨SmoothCompactTest.toFun⟩

/-- A coefficient in the locally integrable elliptic carrier of AKM (0.6)--(0.11),
from the pinned 2019 book PDF SHA-256
`fb5da48f60f1a23eb57b82088fd3ede9a45fe2baa1748c84b01cca2262643d65`.
Each entry is locally integrable for volume, with no Borel or continuity condition;
the source coefficient σ-algebra observes these fields only through test integrals. -/
structure Coefficient (d : ℕ) (K : ℝ) where
  field : Vec d → Mat d
  locally_integrable : ∀ i j, LocallyIntegrable (fun x => field x i j) volume
  symmetric : ∀ x, (field x).transpose = field x
  elliptic : ∀ x ξ, euclideanSq ξ ≤ dot ξ ((field x).mulVec ξ) ∧
    dot ξ ((field x).mulVec ξ) ≤ K * euclideanSq ξ

instance {d : ℕ} {K : ℝ} : CoeFun (Coefficient d K) (fun _ => Vec d → Mat d) :=
  ⟨Coefficient.field⟩

/-- The cited AKM sigma algebra is generated by compactly supported smooth test
integrals of every matrix entry. -/
noncomputable def testIntegral {d : ℕ} {K : ℝ} (A : Coefficient d K)
    (u : SmoothCompactTest d) (i j : Fin d) : ℝ :=
  ∫ x, u x * A.field x i j

theorem integrable_testIntegrand {d : ℕ} {K : ℝ} (A : Coefficient d K)
    (u : SmoothCompactTest d) (i j : Fin d) :
    Integrable (fun x => u x * A.field x i j) volume := by
  simpa [smul_eq_mul] using
    (A.locally_integrable i j).integrable_smul_left_of_hasCompactSupport
      u.smooth.continuous u.compact

/-- AKM's full coefficient sigma algebra, defined by the test-integral observables. -/
noncomputable def coefficientSigma {d : ℕ} {K : ℝ} : MeasurableSpace (Coefficient d K) :=
  ⨆ u : SmoothCompactTest d, ⨆ i : Fin d, ⨆ j : Fin d,
    MeasurableSpace.comap (fun A : Coefficient d K => testIntegral A u i j) inferInstance

noncomputable instance {d : ℕ} {K : ℝ} : MeasurableSpace (Coefficient d K) := coefficientSigma

/-- The local coefficient sigma algebra from AKM, generated by tests supported in `U`. -/
noncomputable def localSigma {d : ℕ} {K : ℝ} (U : Set (Vec d)) : MeasurableSpace (Coefficient d K) :=
  ⨆ u : {u : SmoothCompactTest d // tsupport u.toFun ⊆ U},
    ⨆ i : Fin d, ⨆ j : Fin d,
      MeasurableSpace.comap (fun A : Coefficient d K => testIntegral A u.1 i j) inferInstance

noncomputable def ellipticityScale (L : ℝ) : ℝ := Real.exp (2 * L) * L

noncomputable def AKMUpperEllipticity (L : ℝ) : ℝ := ellipticityScale L * ellipticityScale L

theorem ellipticityScale_pos {L : ℝ} (hL : 1 ≤ L) : 0 < ellipticityScale L :=
  mul_pos (Real.exp_pos _) (lt_of_lt_of_le zero_lt_one hL)

theorem ellipticityScale_lower_identity {L : ℝ} (hL : 1 ≤ L) :
    ellipticityScale L * (Real.exp (-2 * L) * L⁻¹) = 1 := by
  have hL0 : L ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one hL)
  unfold ellipticityScale
  calc
    Real.exp (2 * L) * L * (Real.exp (-2 * L) * L⁻¹) =
        (Real.exp (2 * L) * Real.exp (-2 * L)) * (L * L⁻¹) := by ring
    _ = 1 := by rw [← Real.exp_add]; simp [hL0]

theorem smul_matrix_energy {d : ℕ} (c : ℝ) (A : Mat d) (ξ : Vec d) :
    dot ξ ((c • A).mulVec ξ) = c * dot ξ (A.mulVec ξ) := by
  change dotProduct ξ ((c • A).mulVec ξ) = c * dotProduct ξ (A.mulVec ξ)
  rw [Matrix.smul_mulVec, dotProduct_smul, smul_eq_mul]

def translateDomain {d : ℕ} (y : Vec d) : Vec d ≃ₜ Vec d where
  toFun := fun x => y + x
  invFun := fun x => -y + x
  left_inv := by intro x; simp
  right_inv := by intro x; simp
  continuous_toFun := continuous_const.add continuous_id
  continuous_invFun := continuous_const.add continuous_id

theorem locallyIntegrable_translate {d : ℕ} (y : Vec d) {f : Vec d → ℝ}
    (hf : LocallyIntegrable f volume) : LocallyIntegrable (fun x => f (y + x)) volume := by
  let e := translateDomain y
  have hmp : MeasurePreserving e volume volume := by
    simpa [e, translateDomain] using measurePreserving_add_left (volume : Measure (Vec d)) y
  have hmap : Measure.map e volume = volume := hmp.map_eq
  have hf' : LocallyIntegrable f (Measure.map e volume) := by rw [hmap]; exact hf
  exact (locallyIntegrable_map_homeomorph e).1 hf'

/-- AKM's lattice translation on the concrete locally integrable coefficient carrier. -/
noncomputable def translateCoefficient {d : ℕ} {K : ℝ} (y : Vec d) :
    Coefficient d K → Coefficient d K := fun A => {
  field := fun x => A.field (y + x)
  locally_integrable := by
    intro i j
    exact locallyIntegrable_translate y (A.locally_integrable i j)
  symmetric := fun x => A.symmetric (y + x)
  elliptic := fun x ξ => A.elliptic (y + x) ξ
}

def translateTest {d : ℕ} (y : Vec d) (u : SmoothCompactTest d) : SmoothCompactTest d := by
  let e := translateDomain y
  refine ⟨fun x => u (e.symm x), ?_, ?_⟩
  · exact u.smooth.comp (contDiff_const.add contDiff_id)
  · rw [HasCompactSupport, tsupport]
    have hsupp : Function.support (fun x => u (e.symm x)) = e '' Function.support u := by
      ext x
      constructor
      · intro hx
        exact ⟨e.symm x, hx, e.apply_symm_apply x⟩
      · rintro ⟨x, hx, rfl⟩
        simpa using hx
    rw [hsupp, ← e.image_closure]
    exact u.compact.image e.continuous

theorem testIntegral_translate {d : ℕ} {K : ℝ} (y : Vec d)
    (A : Coefficient d K) (u : SmoothCompactTest d) (i j : Fin d) :
    testIntegral (translateCoefficient y A) u i j =
      testIntegral A (translateTest y u) i j := by
  let e := translateDomain y
  have hmp : MeasurePreserving e volume volume := by
    simpa [e, translateDomain] using measurePreserving_add_left (volume : Measure (Vec d)) y
  have h := hmp.integral_comp e.measurableEmbedding
    (fun x => u (e.symm x) * A.field x i j)
  simpa [testIntegral, translateCoefficient, translateTest, e, translateDomain,
    add_assoc] using h

theorem measurable_translateCoefficient {d : ℕ} {K : ℝ} (y : Vec d) :
    Measurable (translateCoefficient (d := d) (K := K) y) := by
  rw [measurable_iff_comap_le]
  change (coefficientSigma (d := d) (K := K)).comap
    (translateCoefficient y) ≤ coefficientSigma (d := d) (K := K)
  unfold coefficientSigma
  rw [MeasurableSpace.comap_iSup]
  apply iSup_le
  intro u
  rw [MeasurableSpace.comap_iSup]
  apply iSup_le
  intro i
  rw [MeasurableSpace.comap_iSup]
  apply iSup_le
  intro j
  have hcomp : (fun A : Coefficient d K =>
      testIntegral (translateCoefficient y A) u i j) =
      (fun A => testIntegral A (translateTest y u) i j) := by
    funext A
    exact testIntegral_translate y A u i j
  rw [MeasurableSpace.comap_comp]
  change MeasurableSpace.comap
    (fun A : Coefficient d K => testIntegral (translateCoefficient y A) u i j)
    inferInstance ≤ _
  rw [hcomp]
  exact le_iSup_of_le (translateTest y u)
    (le_iSup_of_le i (le_iSup_of_le j le_rfl))

def AKMFiniteRange {d : ℕ} {K : ℝ} (P : Measure (Coefficient d K)) : Prop :=
  ∀ U W : Set (Vec d), MeasurableSet U → MeasurableSet W →
    (∃ s : ℝ, 1 < s ∧ ∀ x ∈ U, ∀ y ∈ W, s ≤ euclideanNorm (x - y)) →
    ProbabilityTheory.Indep (localSigma U) (localSigma W) P

/-- The actual reduced coefficient, dilated by `r₀` and multiplied by the
ellipticity factor `exp(2L) * L`, putting the matrix field in AKM's interval
`[1,K]`. The rescaling used for paper/main.tex:700--702. -/
noncomputable def project {d : ℕ} {L r₀ : ℝ} (hL : 1 ≤ L)
    (ω : {ω : FieldPair d // IsRegular L ω}) :
    Coefficient d (AKMUpperEllipticity L) := by
  let B := ellipticityScale L
  let f : Vec d → Mat d := fun x => B • reducedCoefficient ω.1 (r₀ • x)
  have hf : Continuous f := by
    dsimp [f, B, ellipticityScale]
    exact (((Real.continuous_exp.comp (continuous_const.mul ω.1.2.continuous)).smul
        ω.1.1.continuous).const_smul (Real.exp (2 * L) * L)).comp (continuous_id.const_smul r₀)
  refine ⟨f, ?_, ?_, ?_⟩
  · intro i j
    exact (continuous_apply j).comp ((continuous_apply i).comp hf) |>.locallyIntegrable
  · intro x
    change (B • reducedCoefficient ω.1 (r₀ • x)).transpose = B • reducedCoefficient ω.1 (r₀ • x)
    rw [Matrix.transpose_smul, reducedCoefficient_transpose]
    exact (ω.2.1 (r₀ • x)).1
  · intro x ξ
    have hred := reducedCoefficient_energy_bounds ω.1 (r₀ • x) ξ L hL ω.2
    have hB : 0 ≤ B := (ellipticityScale_pos hL).le
    have hscale := ellipticityScale_lower_identity hL
    have hscaleB : B * (Real.exp (-2 * L) * L⁻¹) = 1 := by
      simpa [B] using hscale
    constructor
    · rw [smul_matrix_energy]
      calc
        euclideanSq ξ = B * ((Real.exp (-2 * L) * L⁻¹) * euclideanSq ξ) := by
          calc
            _ = (B * (Real.exp (-2 * L) * L⁻¹)) * euclideanSq ξ := by
              rw [hscaleB]
              simp
            _ = _ := mul_assoc _ _ _
        _ ≤ B * dot ξ ((reducedCoefficient ω.1 (r₀ • x)).mulVec ξ) :=
          mul_le_mul_of_nonneg_left hred.1 hB
    · rw [smul_matrix_energy]
      calc
        B * dot ξ ((reducedCoefficient ω.1 (r₀ • x)).mulVec ξ) ≤
            B * ((Real.exp (2 * L) * L) * euclideanSq ξ) :=
          mul_le_mul_of_nonneg_left hred.2 hB
        _ = AKMUpperEllipticity L * euclideanSq ξ := by
          dsimp [B, AKMUpperEllipticity, ellipticityScale]
          ring

/-- The exact random-variable convention (0.41)--(0.42) of the cited book. -/
theorem measurable_testIntegral {d : ℕ} {K : ℝ} (u : SmoothCompactTest d)
    (i j : Fin d) : Measurable (fun A : Coefficient d K => testIntegral A u i j) := by
  rw [measurable_iff_comap_le]
  exact le_iSup_of_le u (le_iSup_of_le i (le_iSup_of_le j le_rfl))

theorem measurable_project_testIntegral {d : ℕ} {L r₀ : ℝ} (hL : 1 ≤ L)
    (u : SmoothCompactTest d) (i j : Fin d) :
    Measurable (fun ω : ReductionImageV3.PhysicalField d L =>
      testIntegral (project (r₀ := r₀) hL ω) u i j) := by
  change Measurable (fun ω : ReductionImageV3.PhysicalField d L =>
    ∫ x, u x * (ellipticityScale L • reducedCoefficient ω.1 (r₀ • x)) i j)
  have hphys : Continuous
      (fun p : ReductionImageV3.PhysicalField d L × Vec d => (p.1 : FieldPair d)) :=
    continuous_subtype_val.comp continuous_fst
  have hscale : Continuous (fun x : Vec d => r₀ • x) := continuous_id.const_smul r₀
  have ha : Continuous (fun p : ReductionImageV3.PhysicalField d L × Vec d =>
      (p.1 : FieldPair d).1 (r₀ • p.2)) := hphys.fst.eval (hscale.comp continuous_snd)
  have hV : Continuous (fun p : ReductionImageV3.PhysicalField d L × Vec d =>
      (p.1 : FieldPair d).2 (r₀ • p.2)) := hphys.snd.eval (hscale.comp continuous_snd)
  have hclock : Continuous (fun p : ReductionImageV3.PhysicalField d L × Vec d =>
      Real.exp (-2 * (p.1 : FieldPair d).2 (r₀ • p.2))) :=
    Real.continuous_exp.comp (continuous_const.mul hV)
  have hred : Continuous (fun p : ReductionImageV3.PhysicalField d L × Vec d =>
      Real.exp (-2 * (p.1 : FieldPair d).2 (r₀ • p.2)) •
        (p.1 : FieldPair d).1 (r₀ • p.2)) := hclock.smul ha
  have hscaled : Continuous (fun p : ReductionImageV3.PhysicalField d L × Vec d =>
      ellipticityScale L •
        (Real.exp (-2 * (p.1 : FieldPair d).2 (r₀ • p.2)) •
          (p.1 : FieldPair d).1 (r₀ • p.2))) := hred.const_smul (ellipticityScale L)
  have hentry : Continuous (fun p : ReductionImageV3.PhysicalField d L × Vec d =>
      (ellipticityScale L • reducedCoefficient (p.1 : FieldPair d) (r₀ • p.2)) i j) := by
    simpa only [Function.comp_def, reducedCoefficient, clockDensity] using!
        (continuous_apply j).comp ((continuous_apply i).comp hscaled)
  have hu : Continuous (fun p : ReductionImageV3.PhysicalField d L × Vec d => u p.2) :=
    u.smooth.continuous.comp continuous_snd
  have hjoint : Continuous (fun p : ReductionImageV3.PhysicalField d L × Vec d =>
      u p.2 * (ellipticityScale L • reducedCoefficient (p.1 : FieldPair d)
        (r₀ • p.2)) i j) := hu.mul hentry
  exact hjoint.stronglyMeasurable.integral_prod_right'.measurable

private theorem measurable_localPairEval {d : ℕ} (S : Set (Vec d))
    (x : Vec d) (hx : x ∈ S) :
    @Measurable (FieldPair d) (Mat d × ℝ) (EinsteinRelation.localSigma S) inferInstance
      (fun ω => (ω.1 x, ω.2 x)) := by
  rw [measurable_iff_comap_le]
  unfold EinsteinRelation.localSigma
  exact le_iSup_of_le ⟨x, hx⟩ le_rfl

private theorem measurable_physicalLocalPairEval {d : ℕ} {L : ℝ}
    (S : Set (Vec d)) (x : Vec d) (hx : x ∈ S) :
    @Measurable (ReductionImageV3.PhysicalField d L) (Mat d × ℝ)
      ((EinsteinRelation.localSigma S).comap (Subtype.val : ReductionImageV3.PhysicalField d L → FieldPair d))
      inferInstance (fun ω => ((ω.1 : FieldPair d).1 x, (ω.1 : FieldPair d).2 x)) := by
  exact (measurable_localPairEval S x hx).comp
    (show @Measurable (ReductionImageV3.PhysicalField d L) (FieldPair d)
        ((EinsteinRelation.localSigma S).comap
          (Subtype.val : ReductionImageV3.PhysicalField d L → FieldPair d))
        (EinsteinRelation.localSigma S) Subtype.val from
      (measurable_iff_comap_le).2 le_rfl)

private def dilateSet {d : ℕ} (r₀ : ℝ) (S : Set (Vec d)) : Set (Vec d) :=
  (fun x => r₀ • x) '' S

private theorem dilateSet_measurable {d : ℕ} {r₀ : ℝ} (hr₀ : 0 < r₀)
    {S : Set (Vec d)} (hS : MeasurableSet S) : MeasurableSet (dilateSet r₀ S) := by
  let e : Vec d ≃ₜ Vec d := Homeomorph.smulOfNeZero r₀ hr₀.ne'
  have he : e '' S = dilateSet r₀ S := by
    ext x
    simp [dilateSet, e, Homeomorph.smulOfNeZero]
  rw [← he]
  exact e.measurableEmbedding.measurableSet_image.mpr hS

theorem measurable_project_testIntegral_local {d : ℕ} {L r₀ : ℝ}
    (hL : 1 ≤ L) (U : Set (Vec d)) (u : SmoothCompactTest d)
    (hu : tsupport u.toFun ⊆ U) (i j : Fin d) :
    @Measurable (ReductionImageV3.PhysicalField d L) ℝ
      ((EinsteinRelation.localSigma (dilateSet r₀ U)).comap
        (Subtype.val : ReductionImageV3.PhysicalField d L → FieldPair d)) inferInstance
      (fun ω => testIntegral (project (r₀ := r₀) hL ω) u i j) := by
  letI : MeasurableSpace (ReductionImageV3.PhysicalField d L) :=
    (EinsteinRelation.localSigma (dilateSet r₀ U)).comap
      (Subtype.val : ReductionImageV3.PhysicalField d L → FieldPair d)
  let f : Vec d → ReductionImageV3.PhysicalField d L → ℝ := fun x ω =>
    u x * (ellipticityScale L • reducedCoefficient ω.1 (r₀ • x)) i j
  have hcont : ∀ ω, Continuous (fun x => f x ω) := by
    intro ω
    have hscale : Continuous (fun x : Vec d => r₀ • x) := continuous_id.const_smul r₀
    have ha : Continuous (fun x : Vec d => ω.1.1 (r₀ • x)) :=
      ω.1.1.continuous.comp hscale
    have hV : Continuous (fun x : Vec d => ω.1.2 (r₀ • x)) :=
      ω.1.2.continuous.comp hscale
    have hred : Continuous (fun x : Vec d =>
        Real.exp (-2 * ω.1.2 (r₀ • x)) • ω.1.1 (r₀ • x)) :=
      (Real.continuous_exp.comp (continuous_const.mul hV)).smul ha
    have hscaled : Continuous (fun x : Vec d =>
        ellipticityScale L •
          (Real.exp (-2 * ω.1.2 (r₀ • x)) • ω.1.1 (r₀ • x))) :=
      hred.const_smul (ellipticityScale L)
    have hentry : Continuous (fun x : Vec d =>
        (ellipticityScale L • reducedCoefficient ω.1 (r₀ • x)) i j) := by
      simpa only [Function.comp_def, reducedCoefficient, clockDensity] using!
        (continuous_apply j).comp ((continuous_apply i).comp hscaled)
    exact u.smooth.continuous.mul hentry
  have hmeas : ∀ x, Measurable (f x) := by
    intro x
    by_cases hx : x ∈ tsupport u.toFun
    · have hxU : x ∈ U := hu hx
      have hscaled : r₀ • x ∈ dilateSet r₀ U := ⟨x, hxU, rfl⟩
      have hpair := measurable_physicalLocalPairEval (L := L)
        (dilateSet r₀ U) (r₀ • x) hscaled
      have hred : Measurable (fun ω : ReductionImageV3.PhysicalField d L =>
          Real.exp (-2 * (ω.1 : FieldPair d).2 (r₀ • x)) •
            (ω.1 : FieldPair d).1 (r₀ • x)) := by
        exact (((Real.continuous_exp.comp (continuous_const.mul continuous_snd)).smul
          continuous_fst).measurable.comp hpair)
      have hscaled : Continuous (fun p : Mat d × ℝ =>
          ellipticityScale L • (Real.exp (-2 * p.2) • p.1)) :=
        ((Real.continuous_exp.comp (continuous_const.mul continuous_snd)).smul
            continuous_fst).const_smul (ellipticityScale L)
      have hentryPair : Continuous (fun p : Mat d × ℝ =>
          (ellipticityScale L • (Real.exp (-2 * p.2) • p.1)) i j) := by
        simpa only [Function.comp_def, reducedCoefficient, clockDensity] using!
        (continuous_apply j).comp ((continuous_apply i).comp hscaled)
      have hentry : Measurable (fun ω : ReductionImageV3.PhysicalField d L =>
          (ellipticityScale L •
            (Real.exp (-2 * (ω.1 : FieldPair d).2 (r₀ • x)) •
              (ω.1 : FieldPair d).1 (r₀ • x))) i j) :=
        hentryPair.measurable.comp hpair
      simpa [f, reducedCoefficient, clockDensity] using!
        (measurable_const.mul hentry)
    · have hzero : u.toFun x = 0 := by
        by_contra hne
        have hsupp : x ∈ Function.support u.toFun := by
          simpa [Function.mem_support] using hne
        apply hx
        simpa [tsupport] using subset_closure hsupp
      simp [f, hzero]
  have hjoint : Measurable (Function.uncurry f) :=
    MeasureTheory.measurable_uncurry_of_continuous_of_measurable hcont hmeas
  change Measurable (fun ω => ∫ x, f x ω ∂volume)
  exact hjoint.stronglyMeasurable.integral_prod_left'.measurable

theorem project_localSigma_comap_le {d : ℕ} {L r₀ : ℝ} (hL : 1 ≤ L)
    (U : Set (Vec d)) :
    (localSigma (d := d) (K := AKMUpperEllipticity L) U).comap
      (project (r₀ := r₀) hL) ≤
    (EinsteinRelation.localSigma (dilateSet r₀ U)).comap
      (Subtype.val : ReductionImageV3.PhysicalField d L → FieldPair d) := by
  unfold localSigma
  rw [MeasurableSpace.comap_iSup]
  apply iSup_le
  intro u
  rw [MeasurableSpace.comap_iSup]
  apply iSup_le
  intro i
  rw [MeasurableSpace.comap_iSup]
  apply iSup_le
  intro j
  rw [MeasurableSpace.comap_comp]
  exact (measurable_project_testIntegral_local hL U u.1 u.2 i j).comap_le

theorem physicalReferenceLaw_indep_local {d : ℕ} {L r₀ : ℝ}
    (Q : EnvironmentLaw d L r₀) (S T : Set (Vec d))
    (hS : MeasurableSet S) (hT : MeasurableSet T)
    (hgap : ∃ s : ℝ, r₀ < s ∧ ∀ x ∈ S, ∀ y ∈ T,
      s ≤ euclideanNorm (x - y)) :
    ProbabilityTheory.Indep
      ((EinsteinRelation.localSigma S).comap
        (Subtype.val : ReductionImageV3.PhysicalField d L → FieldPair d))
      ((EinsteinRelation.localSigma T).comap
        (Subtype.val : ReductionImageV3.PhysicalField d L → FieldPair d))
      (ReductionImageV3.physicalReferenceLaw Q) := by
  have hind := Q.finiteRange S T hS hT hgap
  rw [ProbabilityTheory.Indep_iff]
  intro s t hs ht
  rcases (MeasurableSpace.measurableSet_comap).1 hs with ⟨s', hs', rfl⟩
  rcases (MeasurableSpace.measurableSet_comap).1 ht with ⟨t', ht', rfl⟩
  have hsB : MeasurableSet s' :=
    EinsteinRelation.Probability.localSigma_le_borel S s' hs'
  have htB : MeasurableSet t' :=
    EinsteinRelation.Probability.localSigma_le_borel T t' ht'
  have hsource := (ProbabilityTheory.Indep_iff _ _ _).1 hind s' t' hs' ht'
  calc
    (ReductionImageV3.physicalReferenceLaw Q)
        (Subtype.val ⁻¹' s' ∩ Subtype.val ⁻¹' t') =
      ((ReductionImageV3.physicalReferenceLaw Q).map Subtype.val) (s' ∩ t') := by
        rw [← Set.preimage_inter]
        exact (Measure.map_apply measurable_subtype_coe (hsB.inter htB)).symm
    _ = Q.measure (s' ∩ t') := by
      rw [ReductionImageV3.physicalReferenceLaw_forget]
    _ = Q.measure s' * Q.measure t' := hsource
    _ = (ReductionImageV3.physicalReferenceLaw Q) (Subtype.val ⁻¹' s') *
        (ReductionImageV3.physicalReferenceLaw Q) (Subtype.val ⁻¹' t') := by
      rw [← Measure.map_apply measurable_subtype_coe hsB,
        ← Measure.map_apply measurable_subtype_coe htB,
        ReductionImageV3.physicalReferenceLaw_forget]

theorem coefficientLocalSigma_le_coefficientSigma {d : ℕ} {K : ℝ}
    (U : Set (Vec d)) :
    localSigma (d := d) (K := K) U ≤ coefficientSigma (d := d) (K := K) := by
  unfold localSigma
  apply iSup_le
  intro u
  apply iSup_le
  intro i
  apply iSup_le
  intro j
  unfold coefficientSigma
  exact le_iSup_of_le u.1 (le_iSup_of_le i (le_iSup_of_le j le_rfl))

theorem measurable_project {d : ℕ} {L r₀ : ℝ} (hL : 1 ≤ L) :
    Measurable (project (d := d) (L := L) (r₀ := r₀) hL) := by
  rw [measurable_iff_comap_le]
  change (coefficientSigma (d := d) (K := AKMUpperEllipticity L)).comap
    (project (d := d) (L := L) (r₀ := r₀) hL) ≤
      (inferInstance : MeasurableSpace (ReductionImageV3.PhysicalField d L))
  unfold coefficientSigma
  rw [MeasurableSpace.comap_iSup]
  apply iSup_le
  intro u
  rw [MeasurableSpace.comap_iSup]
  apply iSup_le
  intro i
  rw [MeasurableSpace.comap_iSup]
  apply iSup_le
  intro j
  rw [MeasurableSpace.comap_comp]
  exact (measurable_project_testIntegral (r₀ := r₀) hL u i j).comap_le

noncomputable def actualCoefficientLaw {d : ℕ} {L r₀ : ℝ}
    (Q : EnvironmentLaw d L r₀) : Measure (Coefficient d (AKMUpperEllipticity L)) :=
  Measure.map (project (d := d) (L := L) (r₀ := r₀) Q.ellipticity_parameter)
    (ReductionImageV3.physicalReferenceLaw Q)

theorem actualCoefficientLaw_indep_of_physicalLocalIndep {d : ℕ} {L r₀ : ℝ}
    (Q : EnvironmentLaw d L r₀) (U W : Set (Vec d))
    (hsource : ProbabilityTheory.Indep
      ((EinsteinRelation.localSigma (dilateSet r₀ U)).comap
        (Subtype.val : ReductionImageV3.PhysicalField d L → FieldPair d))
      ((EinsteinRelation.localSigma (dilateSet r₀ W)).comap
        (Subtype.val : ReductionImageV3.PhysicalField d L → FieldPair d))
      (ReductionImageV3.physicalReferenceLaw Q)) :
    ProbabilityTheory.Indep
      (localSigma (d := d) (K := AKMUpperEllipticity L) U)
      (localSigma (d := d) (K := AKMUpperEllipticity L) W)
      (actualCoefficientLaw Q) := by
  rw [ProbabilityTheory.Indep_iff]
  intro s t hs ht
  have hsB : MeasurableSet s :=
    coefficientLocalSigma_le_coefficientSigma U s hs
  have htB : MeasurableSet t :=
    coefficientLocalSigma_le_coefficientSigma W t ht
  have hsPull : MeasurableSet[
      (EinsteinRelation.localSigma (dilateSet r₀ U)).comap
        (Subtype.val : ReductionImageV3.PhysicalField d L → FieldPair d)]
      (project (r₀ := r₀) Q.ellipticity_parameter ⁻¹' s) := by
    apply project_localSigma_comap_le Q.ellipticity_parameter U
    exact ⟨s, hs, rfl⟩
  have htPull : MeasurableSet[
      (EinsteinRelation.localSigma (dilateSet r₀ W)).comap
        (Subtype.val : ReductionImageV3.PhysicalField d L → FieldPair d)]
      (project (r₀ := r₀) Q.ellipticity_parameter ⁻¹' t) := by
    apply project_localSigma_comap_le Q.ellipticity_parameter W
    exact ⟨t, ht, rfl⟩
  have hInd := (ProbabilityTheory.Indep_iff _ _ _).1 hsource
    (project (r₀ := r₀) Q.ellipticity_parameter ⁻¹' s)
    (project (r₀ := r₀) Q.ellipticity_parameter ⁻¹' t) hsPull htPull
  rw [actualCoefficientLaw,
    Measure.map_apply (measurable_project Q.ellipticity_parameter) (hsB.inter htB),
    Measure.map_apply (measurable_project Q.ellipticity_parameter) hsB,
    Measure.map_apply (measurable_project Q.ellipticity_parameter) htB,
    Set.preimage_inter]
  exact hInd

theorem actualCoefficientLaw_finiteRange {d : ℕ} {L r₀ : ℝ}
    (Q : EnvironmentLaw d L r₀) : AKMFiniteRange (actualCoefficientLaw Q) := by
  have hr₀ : 0 < r₀ := lt_of_lt_of_le zero_lt_one Q.range_parameter
  intro U W hU hW hgap
  rcases hgap with ⟨s, hs, hdist⟩
  have hscaledU : MeasurableSet (dilateSet r₀ U) := dilateSet_measurable hr₀ hU
  have hscaledW : MeasurableSet (dilateSet r₀ W) := dilateSet_measurable hr₀ hW
  have hscaledGap : ∃ t : ℝ, r₀ < t ∧ ∀ x ∈ dilateSet r₀ U,
      ∀ y ∈ dilateSet r₀ W, t ≤ euclideanNorm (x - y) := by
    refine ⟨r₀ * s, ?_, ?_⟩
    · have hmul := mul_lt_mul_of_pos_left hs hr₀
      nlinarith
    · intro x hx y hy
      rcases hx with ⟨x₀, hx₀, rfl⟩
      rcases hy with ⟨y₀, hy₀, rfl⟩
      have hdiff : (r₀ • x₀) - (r₀ • y₀) = r₀ • (x₀ - y₀) := by
        ext k
        simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
        ring
      rw [hdiff, euclideanNorm_smul r₀ hr₀.le]
      exact mul_le_mul_of_nonneg_left (hdist x₀ hx₀ y₀ hy₀) hr₀.le
  have hphysical := physicalReferenceLaw_indep_local Q (dilateSet r₀ U)
    (dilateSet r₀ W) hscaledU hscaledW hscaledGap
  exact actualCoefficientLaw_indep_of_physicalLocalIndep Q U W hphysical


def physicalTranslate {d : ℕ} {L : ℝ} (z : Vec d)
    (ω : ReductionImageV3.PhysicalField d L) : ReductionImageV3.PhysicalField d L :=
  ⟨translate z ω.1,
    (ActualImageLpStateTransport.isRegular_translate_iff z ω.1).2 ω.2⟩

theorem measurable_physicalTranslate {d : ℕ} {L : ℝ} (z : Vec d) :
    Measurable (physicalTranslate (d := d) (L := L) z) := by
  exact ((Probability.measurable_translate z).comp measurable_subtype_coe).subtype_mk
    (h := fun ω : ReductionImageV3.PhysicalField d L =>
      (ActualImageLpStateTransport.isRegular_translate_iff z ω.1).2 ω.2)

theorem physicalReduceHomeomorph_physicalTranslate {d : ℕ} {L : ℝ} (z : Vec d)
    (ω : ReductionImageV3.PhysicalField d L) :
    ReductionImageV3.physicalReduceHomeomorph (physicalTranslate z ω) =
      ActualImageLpStateTransport.reducedTranslate z
        (ReductionImageV3.physicalReduceHomeomorph ω) := by
  apply Subtype.ext
  exact reduce_translate ω.1 z

theorem physicalReferenceLaw_translation_invariant {d : ℕ} {L r₀ : ℝ}
    (Q : EnvironmentLaw d L r₀) (z : Vec d) :
    Measure.map (physicalTranslate (d := d) (L := L) z)
        (ReductionImageV3.physicalReferenceLaw Q) =
      ReductionImageV3.physicalReferenceLaw Q := by
  let e := ReductionImageV3.physicalReduceHomeomorph (d := d) (L := L)
  have hinj : Function.Injective (fun μ : Measure (ReductionImageV3.PhysicalField d L) =>
      Measure.map e μ) := e.toMeasurableEquiv.map_measurableEquiv_injective
  apply hinj
  have hcomp : e ∘ physicalTranslate z =
      ActualImageLpStateTransport.reducedTranslate z ∘ e := by
    funext ω
    exact (physicalReduceHomeomorph_physicalTranslate z ω).symm
  calc
    Measure.map e (Measure.map (physicalTranslate z)
        (ReductionImageV3.physicalReferenceLaw Q)) =
      Measure.map (ActualImageLpStateTransport.reducedTranslate z)
        (Measure.map e (ReductionImageV3.physicalReferenceLaw Q)) := by
          rw [Measure.map_map e.measurable (measurable_physicalTranslate z), hcomp]
          change Measure.map
              (ActualImageLpStateTransport.reducedTranslationMeasurableEquiv z ∘ e)
              (ReductionImageV3.physicalReferenceLaw Q) = _
          exact (Measure.map_map
            (ActualImageLpStateTransport.reducedTranslationMeasurableEquiv z).measurable
            e.measurable).symm
    _ = ReductionImageV3.actualReducedLaw Q := by
      rw [ActualImageLpStateTransport.actualReducedLaw_map_physicalReduceHomeomorph Q]
      exact ActualImageLpStateTransport.actualReducedLaw_translation_invariant Q z
    _ = Measure.map e (ReductionImageV3.physicalReferenceLaw Q) := by
      exact (ActualImageLpStateTransport.actualReducedLaw_map_physicalReduceHomeomorph Q).symm

theorem coefficient_ext {d : ℕ} {K : ℝ} {A B : Coefficient d K}
    (h : A.field = B.field) : A = B := by
  cases A with
  | mk fieldA integrableA symmetricA ellipticA =>
    cases B with
    | mk fieldB integrableB symmetricB ellipticB =>
      change fieldA = fieldB at h
      cases h
      rfl

theorem project_translation_covariant {d : ℕ} {L r₀ : ℝ} (hL : 1 ≤ L)
    (y : Vec d) (ω : ReductionImageV3.PhysicalField d L) :
    translateCoefficient y (project (r₀ := r₀) hL ω) =
      project (r₀ := r₀) hL (physicalTranslate (r₀ • y) ω) := by
  apply coefficient_ext
  funext x
  ext i j
  simp [translateCoefficient, project, physicalTranslate, reducedCoefficient,
    clockDensity, translate, smul_add, add_comm]

theorem actualCoefficientLaw_translation_invariant {d : ℕ} {L r₀ : ℝ}
    (Q : EnvironmentLaw d L r₀) (z : LatticeIndex d) :
    Measure.map (translateCoefficient (latticeShift z)) (actualCoefficientLaw Q) =
      actualCoefficientLaw Q := by
  change Measure.map (translateCoefficient (latticeShift z))
      (Measure.map (project (r₀ := r₀) Q.ellipticity_parameter)
        (ReductionImageV3.physicalReferenceLaw Q)) = _
  rw [Measure.map_map (measurable_translateCoefficient _)
    (measurable_project Q.ellipticity_parameter)]
  rw [show (translateCoefficient (latticeShift z) ∘
      project (r₀ := r₀) Q.ellipticity_parameter) =
      (project (r₀ := r₀) Q.ellipticity_parameter ∘
        physicalTranslate (r₀ • latticeShift z)) from by
        funext ω
        exact project_translation_covariant (r₀ := r₀) Q.ellipticity_parameter
          (latticeShift z) ω]
  rw [← Measure.map_map (measurable_project Q.ellipticity_parameter)
    (measurable_physicalTranslate (r₀ • latticeShift z)),
    physicalReferenceLaw_translation_invariant Q (r₀ • latticeShift z)]
  rfl

theorem actualCoefficientLaw_probability {d : ℕ} {L r₀ : ℝ}
    (Q : EnvironmentLaw d L r₀) : IsProbabilityMeasure (actualCoefficientLaw Q) := by
  letI : IsProbabilityMeasure (ReductionImageV3.physicalReferenceLaw Q) :=
    ReductionImageV3.physicalReferenceLaw_probability Q
  unfold actualCoefficientLaw
  infer_instance

/-- First actual-law consumer: every compact smooth matrix-entry observation of
the projected law is the corresponding observable of the physical law. -/
theorem actualCoefficientLaw_testIntegral_map {d : ℕ} {L r₀ : ℝ}
    (Q : EnvironmentLaw d L r₀) (u : SmoothCompactTest d) (i j : Fin d) :
    Measure.map (fun A : Coefficient d (AKMUpperEllipticity L) => testIntegral A u i j)
        (actualCoefficientLaw Q) =
      Measure.map (fun ω : ReductionImageV3.PhysicalField d L =>
        testIntegral (project (r₀ := r₀) Q.ellipticity_parameter ω) u i j)
        (ReductionImageV3.physicalReferenceLaw Q) := by
  rw [actualCoefficientLaw, Measure.map_map
    (measurable_testIntegral u i j)
    (measurable_project (r₀ := r₀) Q.ellipticity_parameter)]
  rfl

