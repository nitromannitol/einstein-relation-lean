import EinsteinRelation.Correctors.NestedConditionalLp
import EinsteinRelation.Carriers.RegenerationCorrectorTwins
import EinsteinRelation.TimeChange.EuclideanTransport

/-! # Conditioning on the coefficient balls of Proposition 5.3

Source: `paper/main.tex:953–973`. The coefficient observations here are exactly
the production observation σ-algebras. The nested conditional comparisons apply
to arbitrary integrable fields, including the Euclidean corrector gradient.
-/

open MeasureTheory
open scoped ENNReal
open EinsteinRelation.Carriers (reducedCoefficientObservationSigma)

namespace EinsteinRelation.Correctors

/-- Coefficient observations are generated by the literal evaluation map into
the product of matrix spaces. Source: `paper/main.tex:765–767,953–973`. -/
theorem reducedCoefficientObservationSigma_eq_comap_evaluation {d : ℕ} (U : Set (Vec d)) :
    reducedCoefficientObservationSigma U =
      (inferInstance : MeasurableSpace (U → Mat d)).comap
        (fun (ω : FieldPair d) (x : U) => ω.1 x) := by
  change (⨆ x : U, MeasurableSpace.comap (fun ω : FieldPair d => ω.1 x) inferInstance) =
    (⨆ x : U, MeasurableSpace.comap (fun a : U → Mat d => a x) inferInstance).comap _
  rw [MeasurableSpace.comap_iSup]
  simp only [MeasurableSpace.comap_comp]
  rfl

private theorem measurable_coefficient_evaluation {d : ℕ} (U : Set (Vec d)) :
    Measurable (fun (ω : FieldPair d) (x : U) => ω.1 x) :=
  measurable_pi_lambda _ fun x =>
    ((continuous_eval_const (x : Vec d)).comp continuous_fst).measurable

/-- Increasing the observed region increases its coefficient σ-algebra.
Source: the ball inclusions in `paper/main.tex:956–973`. -/
theorem reducedCoefficientObservationSigma_mono {d : ℕ} {U W : Set (Vec d)}
    (hUW : U ⊆ W) :
    reducedCoefficientObservationSigma U ≤ reducedCoefficientObservationSigma W := by
  apply iSup_le
  intro x
  exact le_iSup_of_le (⟨x.1, hUW x.2⟩ : W) le_rfl

variable {d : ℕ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  [CompleteSpace E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
  [StandardBorelSpace E]

/-- The conditional-mean comparison for actual reduced coefficient observations.
Source: `paper/main.tex:956–961,968–973`. -/
theorem eLpNorm_reduced_condExp_sub_condExp_le {μ : Measure (FieldPair d)}
    [IsProbabilityMeasure μ] {U W : Set (Vec d)} (hUW : U ⊆ W)
    {p : ℝ≥0∞} (hp : 1 ≤ p) (hpt : p ≠ ∞) {f : FieldPair d → E}
    (hf : Integrable f μ) :
    eLpNorm (μ[f | reducedCoefficientObservationSigma W] -
      μ[f | reducedCoefficientObservationSigma U]) p μ ≤
        eLpNorm (f - μ[f | reducedCoefficientObservationSigma U]) p μ := by
  have hm := reducedCoefficientObservationSigma_mono hUW
  rw [reducedCoefficientObservationSigma_eq_comap_evaluation W] at hm ⊢
  exact eLpNorm_condExp_comap_sub_condExp_le _ (measurable_coefficient_evaluation W)
    hm hp hpt hf

/-- The factor-two error comparison for actual coefficient observations.
Source: `paper/main.tex:959–961`. -/
theorem eLpNorm_reduced_sub_condExp_le_two_mul {μ : Measure (FieldPair d)}
    [IsProbabilityMeasure μ] {U W : Set (Vec d)} (hUW : U ⊆ W)
    {p : ℝ≥0∞} (hp : 1 ≤ p) (hpt : p ≠ ∞) {f : FieldPair d → E}
    (hf : Integrable f μ) :
    eLpNorm (f - μ[f | reducedCoefficientObservationSigma W]) p μ ≤
      2 * eLpNorm (f - μ[f | reducedCoefficientObservationSigma U]) p μ := by
  have hm := reducedCoefficientObservationSigma_mono hUW
  rw [reducedCoefficientObservationSigma_eq_comap_evaluation W] at hm ⊢
  exact eLpNorm_sub_condExp_comap_le_two_mul _ (measurable_coefficient_evaluation W)
    hm hp hpt hf

/-- The comparison after changing the normalization of a corrector, for actual
coefficient observations. Source: `paper/main.tex:953–961`. -/
theorem eLpNorm_reduced_condExp_add_sub_condExp_le {μ : Measure (FieldPair d)}
    [IsProbabilityMeasure μ] {U W : Set (Vec d)} (hUW : U ⊆ W)
    {p : ℝ≥0∞} (hp : 1 ≤ p) (hpt : p ≠ ∞) {f g : FieldPair d → E}
    (hf : Integrable f μ) (hg : Integrable g μ) :
    eLpNorm (μ[f + g | reducedCoefficientObservationSigma W] -
      μ[f | reducedCoefficientObservationSigma U]) p μ ≤
        eLpNorm (f - μ[f | reducedCoefficientObservationSigma U]) p μ + eLpNorm g p μ := by
  have hm := reducedCoefficientObservationSigma_mono hUW
  rw [reducedCoefficientObservationSigma_eq_comap_evaluation W] at hm ⊢
  exact eLpNorm_condExp_comap_add_sub_condExp_le _ (measurable_coefficient_evaluation W)
    hm hp hpt hf hg

/-- The common observation ball in Step 2 lies inside every conditioning ball
that occurs in the local average. Source: `paper/main.tex:956–961`. -/
theorem corrector_common_ball_subset {R : ℝ} (hR : 1 ≤ R) {y : Vec d}
    (hy : euclideanNorm y ≤ R) :
    {z : Vec d | euclideanNorm (z - 0) < 16 * R} ⊆
      {z : Vec d | euclideanNorm (z - y) < 32 * R} := by
  intro z hz
  have hneg : euclideanNorm (-y) = euclideanNorm y := by
    simpa using TimeChange.euclideanNorm_smul (-1) y
  have htri := TimeChange.euclideanNorm_add_le z (-y)
  rw [hneg, ← sub_eq_add_neg] at htri
  simp only [Set.mem_setOf_eq, sub_zero] at hz ⊢
  linarith

/-- The two nested conditional comparisons used for the dimension-two centered
values, with the paper's exact radii. Source: `paper/main.tex:953–961`. -/
theorem eLpNorm_corrector_local_centered_le {μ : Measure (FieldPair d)}
    [IsProbabilityMeasure μ] {R : ℝ} (hR : 1 ≤ R) {y : Vec d}
    (hy : euclideanNorm y ≤ R)
    {p : ℝ≥0∞} (hp : 1 ≤ p) (hpt : p ≠ ∞) {f g : FieldPair d → E}
    (hf : Integrable f μ) (hg : Integrable g μ) :
    eLpNorm (μ[f + g | reducedCoefficientObservationSigma
        {z : Vec d | euclideanNorm (z - y) < 32 * R}] -
      μ[f | reducedCoefficientObservationSigma
        {z : Vec d | euclideanNorm (z - 0) < 16 * R}]) p μ ≤
      2 * eLpNorm (f - μ[f | reducedCoefficientObservationSigma
        {z : Vec d | euclideanNorm (z - 0) < 8 * R}]) p μ + eLpNorm g p μ := by
  refine (eLpNorm_reduced_condExp_add_sub_condExp_le
    (corrector_common_ball_subset hR hy) hp hpt hf hg).trans (add_le_add ?_ le_rfl)
  exact eLpNorm_reduced_sub_condExp_le_two_mul (fun z hz => by
    simp only [Set.mem_setOf_eq] at hz ⊢
    linarith) hp hpt hf

/-- Conditioning the gradient on a shifted `B_{32R}` costs at most twice its
error conditioned on `B_{8R}`. Source: `paper/main.tex:968–973`. -/
theorem eLpNorm_corrector_local_gradient_error_le {μ : Measure (FieldPair d)}
    [IsProbabilityMeasure μ] {R : ℝ} (hR : 1 ≤ R) {y : Vec d}
    (hy : euclideanNorm y ≤ R)
    {p : ℝ≥0∞} (hp : 1 ≤ p) (hpt : p ≠ ∞) {f : FieldPair d → E}
    (hf : Integrable f μ) :
    eLpNorm (μ[f | reducedCoefficientObservationSigma
        {z : Vec d | euclideanNorm (z - y) < 32 * R}] - f) p μ ≤
      2 * eLpNorm (f - μ[f | reducedCoefficientObservationSigma
        {z : Vec d | euclideanNorm (z - 0) < 8 * R}]) p μ := by
  rw [eLpNorm_sub_comm]
  apply eLpNorm_reduced_sub_condExp_le_two_mul _ hp hpt hf
  exact Set.Subset.trans (fun z hz => by
    simp only [Set.mem_setOf_eq] at hz ⊢
    linarith) (corrector_common_ball_subset hR hy)

end EinsteinRelation.Correctors
