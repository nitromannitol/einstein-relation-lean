/-! Vocabulary for `EinsteinRelation.Environment.AKMTestIntegralSupport`: the declarations of that library module which the challenge statements use, copied verbatim in their context. -/

open MeasureTheory

namespace EinsteinRelation.Environment.AKMTestIntegralSupport

open EinsteinRelation

abbrev LatticeIndex (d : ℕ) := Fin d → ℤ

def latticeShift {d : ℕ} (z : LatticeIndex d) : Vec d := fun i => (z i : ℝ)

/-- The compactly supported smooth scalar tests used to observe AKM coefficients. -/
structure SmoothCompactTest (d : ℕ) where
  toFun : Vec d → ℝ
  smooth : ContDiff ℝ (⊤ : ℕ∞) toFun
  compact : HasCompactSupport toFun

instance {d : ℕ} : CoeFun (SmoothCompactTest d) (fun _ => Vec d → ℝ) :=
  ⟨SmoothCompactTest.toFun⟩

/-- A coefficient in the locally integrable elliptic carrier of AKM (0.6)--(0.11),
from the pinned 2019 book PDF SHA-256
`fb5da48f60f1a23eb57b82088fd3ede9a45fe2baa1748c84b01cca2262643d65`.
Each entry is locally integrable for volume, with no Borel or continuity condition;
the source coefficient σ-algebra observes these fields only through test integrals. -/
structure Coefficient (d : ℕ) (K : ℝ) where
  field : Vec d → Mat d
  locally_integrable : ∀ i j, LocallyIntegrable (fun x => field x i j) volume
  symmetric : ∀ x, (field x).transpose = field x
  elliptic : ∀ x ξ, euclideanSq ξ ≤ dot ξ ((field x).mulVec ξ) ∧
    dot ξ ((field x).mulVec ξ) ≤ K * euclideanSq ξ

instance {d : ℕ} {K : ℝ} : CoeFun (Coefficient d K) (fun _ => Vec d → Mat d) :=
  ⟨Coefficient.field⟩

/-- The cited AKM sigma algebra is generated by compactly supported smooth test
integrals of every matrix entry. -/
noncomputable def testIntegral {d : ℕ} {K : ℝ} (A : Coefficient d K)
    (u : SmoothCompactTest d) (i j : Fin d) : ℝ :=
  ∫ x, u x * A.field x i j

/-- AKM's full coefficient sigma algebra, defined by the test-integral observables. -/
noncomputable def coefficientSigma {d : ℕ} {K : ℝ} : MeasurableSpace (Coefficient d K) :=
  ⨆ u : SmoothCompactTest d, ⨆ i : Fin d, ⨆ j : Fin d,
    MeasurableSpace.comap (fun A : Coefficient d K => testIntegral A u i j) inferInstance

noncomputable instance {d : ℕ} {K : ℝ} : MeasurableSpace (Coefficient d K) := coefficientSigma

/-- The local coefficient sigma algebra from AKM, generated by tests supported in `U`. -/
noncomputable def localSigma {d : ℕ} {K : ℝ} (U : Set (Vec d)) : MeasurableSpace (Coefficient d K) :=
  ⨆ u : {u : SmoothCompactTest d // tsupport u.toFun ⊆ U},
    ⨆ i : Fin d, ⨆ j : Fin d,
      MeasurableSpace.comap (fun A : Coefficient d K => testIntegral A u.1 i j) inferInstance

def translateDomain {d : ℕ} (y : Vec d) : Vec d ≃ₜ Vec d where
  toFun := fun x => y + x
  invFun := fun x => -y + x
  left_inv := by intro x; simp
  right_inv := by intro x; simp
  continuous_toFun := continuous_const.add continuous_id
  continuous_invFun := continuous_const.add continuous_id

theorem locallyIntegrable_translate {d : ℕ} (y : Vec d) {f : Vec d → ℝ}
    (hf : LocallyIntegrable f volume) : LocallyIntegrable (fun x => f (y + x)) volume := by
  let e := translateDomain y
  have hmp : MeasurePreserving e volume volume := by
    simpa [e, translateDomain] using measurePreserving_add_left (volume : Measure (Vec d)) y
  have hmap : Measure.map e volume = volume := hmp.map_eq
  have hf' : LocallyIntegrable f (Measure.map e volume) := by rw [hmap]; exact hf
  exact (locallyIntegrable_map_homeomorph e).1 hf'

/-- AKM's lattice translation on the concrete locally integrable coefficient carrier. -/
noncomputable def translateCoefficient {d : ℕ} {K : ℝ} (y : Vec d) :
    Coefficient d K → Coefficient d K := fun A => {
  field := fun x => A.field (y + x)
  locally_integrable := by
    intro i j
    exact locallyIntegrable_translate y (A.locally_integrable i j)
  symmetric := fun x => A.symmetric (y + x)
  elliptic := fun x ξ => A.elliptic (y + x) ξ
}

def AKMFiniteRange {d : ℕ} {K : ℝ} (P : Measure (Coefficient d K)) : Prop :=
  ∀ U W : Set (Vec d), MeasurableSet U → MeasurableSet W →
    (∃ s : ℝ, 1 < s ∧ ∀ x ∈ U, ∀ y ∈ W, s ≤ euclideanNorm (x - y)) →
    ProbabilityTheory.Indep (localSigma U) (localSigma W) P

end EinsteinRelation.Environment.AKMTestIntegralSupport
