/-! Vocabulary for `EinsteinRelation.External.WhiteNoise`: the declarations of that library module which the challenge statements use, copied verbatim in their context. -/

open MeasureTheory

namespace EinsteinRelation.External

open Sharpness

/-- The sigma algebra generated by all actual compact smooth test evaluations. -/
noncomputable def noiseSigma (d : ℕ) : MeasurableSpace (NoiseSample d) :=
  ⨆ f : NoiseTest d, (borel ℝ).comap (fun W : NoiseSample d => W f)

noncomputable instance (d : ℕ) : MeasurableSpace (NoiseSample d) := noiseSigma d

/-- Unit-variance scalar white noise, restricted to its legitimate smooth compact
tests. Simultaneous samplewise linearity and continuity are supplied by the
actual `Distribution` carrier, while this clause specifies each Gaussian law. -/
def IsWhiteNoiseLaw {d : ℕ} (P : Measure (NoiseSample d)) : Prop :=
  IsProbabilityMeasure P ∧ ∀ (f : NoiseTest d) (r : ℝ),
    (∫ W, Complex.exp (Complex.I * (r : ℂ) * (W f : ℂ)) ∂P) =
      Complex.exp (((-(1 / 2 : ℝ)) * r ^ 2 * ∫ y : Vec d, (f y) ^ 2) : ℂ)

/-- The permitted generic existence input from AKM Proposition 5.14. This is
only a proposition to be supplied explicitly by a conditional theorem. -/
def WhiteNoiseExistence (d : ℕ) : Prop :=
  ∃ P : Measure (NoiseSample d), IsWhiteNoiseLaw P

end EinsteinRelation.External
