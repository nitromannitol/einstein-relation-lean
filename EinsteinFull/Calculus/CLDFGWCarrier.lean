import EinsteinRelation.Diffusion.Basic
import Mathlib.Probability.Kernel.Basic
import Mathlib.Probability.Martingale.Basic
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic

/-!
# The setting of De Masi–Ferrari–Goldstein–Wick, Section 2

The coordinate sigma-algebras of a process, the reversible ergodic Markov setting of DFGW
Section 2 (pp.789–790) on an abstract carrier, the antisymmetric families (2.3)–(2.5) with
A.1–A.4, and the path of such a family. These are the objects transported to the trajectory
space for the admitted input `EinsteinFull.External.dfgw_invariance`.
-/

namespace EinsteinFull.External.Draft

open MeasureTheory ProbabilityTheory Filter EinsteinRelation
open scoped NNReal Topology

variable {Ω S : Type*} [mΩ : MeasurableSpace Ω] [mS : MeasurableSpace S]

/-- The sigma-algebra `F_I` generated by the coordinates at times in `I` (source p.789). -/
abbrev dfgwSigma (ξ : ℝ → Ω → S) (I : Set ℝ) : MeasurableSpace Ω :=
  ⨆ t ∈ I, MeasurableSpace.comap (ξ t) mS

theorem dfgwSigma_le {ξ : ℝ → Ω → S} (hξ : ∀ t, Measurable (ξ t)) (I : Set ℝ) :
    dfgwSigma ξ I ≤ mΩ :=
  iSup₂_le fun t _ => (hξ t).comap_le

omit mΩ in
theorem dfgwSigma_mono (ξ : ℝ → Ω → S) {I J : Set ℝ} (h : I ⊆ J) :
    dfgwSigma ξ I ≤ dfgwSigma ξ J :=
  iSup₂_le fun t ht => le_iSup₂_of_le t (h ht) le_rfl

/-- The past filtration `F_{(-∞, t]}`, `t ≥ 0`, of the process. -/
def dfgwFiltration {ξ : ℝ → Ω → S} (hξ : ∀ t, Measurable (ξ t)) : Filtration ℝ≥0 mΩ where
  seq t := dfgwSigma ξ (Set.Iic (t : ℝ))
  mono' _ _ hst := dfgwSigma_mono ξ (Set.Iic_subset_Iic.2 (by exact_mod_cast hst))
  le' t := dfgwSigma_le hξ _

/-- Source Section 2, pp.789–790: a two-sided, stationary, reversible, ergodic Markov process
with invariant probability measure `μ`, time translations `θ`, reflections `R` and transition
kernels `T`. -/
structure IsDFGWReversibleErgodicProcess (P : Measure Ω) (μ : Measure S) (ξ : ℝ → Ω → S)
    (θ R : ℝ → Ω → Ω) (T : ℝ≥0 → Kernel S S) : Prop where
  probability : IsProbabilityMeasure P
  invariant_probability : IsProbabilityMeasure μ
  measurable : Measurable fun p : ℝ × Ω => ξ p.1 p.2
  marginal : ∀ t, P.map (ξ t) = μ
  translate_measurable : ∀ τ, Measurable (θ τ)
  translate : ∀ τ t ω, ξ t (θ τ ω) = ξ (t + τ) ω
  stationary : ∀ τ, P.map (θ τ) = P
  reflect_measurable : ∀ τ, Measurable (R τ)
  reflect : ∀ τ t ω, ξ t (R τ ω) = ξ (2 * τ - t) ω
  reversible : ∀ τ, P.map (R τ) = P
  markov_kernel : ∀ t, IsMarkovKernel (T t)
  markov : ∀ (t : ℝ≥0) (f : S → ℝ), Measurable f → (∃ C, ∀ x, |f x| ≤ C) →
    P[fun ω => f (ξ t ω) | dfgwSigma ξ (Set.Iic 0)] =ᵐ[P] fun ω => ∫ y, f y ∂T t (ξ 0 ω)
  ergodic : ∀ A : Set S, MeasurableSet A →
    (∀ t, ∀ᵐ x ∂μ, x ∈ A → T t x A = 1) → μ A = 0 ∨ μ A = 1

/-- Source (2.3)–(2.5) and A.1–A.4, with continuous paths: an antisymmetric, integrable,
covariant and additive family `X a b`, `a ≤ b`, indexed by closed bounded intervals. -/
structure IsDFGWAntisymmetricFamily {d : ℕ} (P : Measure Ω) (ξ : ℝ → Ω → S)
    (θ R : ℝ → Ω → Ω) (X : ℝ → ℝ → Ω → Vec d) : Prop where
  adapted : ∀ a b, a ≤ b → Measurable[dfgwSigma ξ (Set.Icc a b)] (X a b)
  antisymmetric : ∀ a b, a ≤ b →
    (fun ω => X a b (R ((a + b) / 2) ω)) =ᵐ[P] fun ω => -X a b ω
  integrable : ∀ a b, a ≤ b → Integrable (X a b) P
  covariant : ∀ a b τ, a ≤ b → (fun ω => X a b (θ τ ω)) =ᵐ[P] X (a + τ) (b + τ)
  additive : ∀ a b c, a ≤ b → b ≤ c → (fun ω => X a b ω + X b c ω) =ᵐ[P] X a c
  continuous : ∀ ω, Continuous fun t : ℝ≥0 => X 0 t ω

/-- The path `t ↦ X_{[0,t]}` of a family with continuous paths. -/
def dfgwPath {d : ℕ} {P : Measure Ω} {ξ : ℝ → Ω → S} {θ R : ℝ → Ω → Ω}
    {X : ℝ → ℝ → Ω → Vec d} (hX : IsDFGWAntisymmetricFamily P ξ θ R X) (ω : Ω) : Path d :=
  ⟨fun t => X 0 t ω, hX.continuous ω⟩

end EinsteinFull.External.Draft
