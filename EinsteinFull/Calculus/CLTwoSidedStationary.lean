import EinsteinFull.Calculus.CLTwoSidedFdd

/-!
# Stationarity and reversibility of the two-sided environment process

The law of the two-sided process is invariant under every time shift and every time reflection.
The states at the times of a grid window generate, over the windows of the grids `c 2^{-m} ℤ`,
the sigma-algebra of the states; on a window the law is given by the canonical values of the
grid products, which do not change when the window is shifted by a grid time or reflected about
one. A measure carried by the paths vanishing at time zero is determined by its values on the
sigma-algebra of the states, through the state-measurable normalization at time zero.
-/

open MeasureTheory ProbabilityTheory Filter
open scoped NNReal Topology

noncomputable section
namespace EinsteinFull.Blueprint
open EinsteinFull EinsteinRelation

variable {d : ℕ}

/-- The sigma-algebra generated by the states. -/
abbrev tsStateSigma (d : ℕ) : MeasurableSpace (TwoSidedSpace d) :=
  ⨆ t : ℝ, MeasurableSpace.comap (tsState t) inferInstance

theorem tsStateSigma_le :
    tsStateSigma d ≤ (inferInstance : MeasurableSpace (TwoSidedSpace d)) :=
  iSup_le fun t => (measurable_tsState t).comap_le

theorem measurable_tsState_stateSigma (t : ℝ) : Measurable[tsStateSigma d] (tsState (d := d) t) :=
  Measurable.of_comap_le (le_iSup (fun t => MeasurableSpace.comap (tsState (d := d) t)
    inferInstance) t)

private theorem measurable_continuousMap_of_eval {Z : Type*} {m : MeasurableSpace Z}
    {g : Z → C(ℝ, Vec d)} (h : ∀ t, Measurable[m] fun z => g z t) : Measurable[m] g := by
  let _ : MeasurableSpace Z := m
  exact ContinuousMap.measurable_iff_eval.2 h

/-- Normalization at time zero: the identity on the paths vanishing at zero. -/
def tsNormalize (ω : TwoSidedSpace d) : TwoSidedSpace d :=
  (⟨tsState 0 ω, (translate_mem_aperiodicSet_iff _ _).2 ω.1.2⟩,
    ⟨fun t => ω.2 t - ω.2 0, ω.2.continuous.sub continuous_const⟩)

theorem tsNormalize_eq_self {ω : TwoSidedSpace d} (h : ω.2 0 = 0) : tsNormalize ω = ω := by
  rcases ω with ⟨⟨ω₀, hω₀⟩, y⟩
  simp only at h
  refine Prod.ext (Subtype.ext ?_) (ContinuousMap.ext fun t => ?_)
  · simp [tsNormalize, tsState, h]
  · simp [tsNormalize, h]

theorem measurable_tsNormalize_stateSigma :
    Measurable[tsStateSigma d, inferInstance] (tsNormalize (d := d)) := by
  change Measurable[tsStateSigma d] (fun ω => ((tsNormalize ω).1, (tsNormalize ω).2))
  refine Measurable.prodMk ?_ ?_
  · exact (measurable_tsState_stateSigma 0).subtype_mk
  · refine measurable_continuousMap_of_eval fun t => ?_
    have h : (fun ω : TwoSidedSpace d => ω.2 t - ω.2 0) =
        fun ω => displacementInv (tsState 0 ω, tsState t ω) := by
      funext ω
      exact tsDisp_eq_displacementInv 0 t ω
    change Measurable[tsStateSigma d] (fun ω : TwoSidedSpace d => ω.2 t - ω.2 0)
    rw [h]
    exact measurable_displacementInv.comp
      ((measurable_tsState_stateSigma 0).prodMk (measurable_tsState_stateSigma t))

theorem measurable_tsNormalize : Measurable (tsNormalize (d := d)) :=
  measurable_tsNormalize_stateSigma.mono tsStateSigma_le le_rfl

/-- Two finite measures carried by the paths vanishing at time zero and equal on the
sigma-algebra of the states are equal. -/
theorem measure_eq_of_stateSigma {μ ν : Measure (TwoSidedSpace d)}
    (hμ0 : ∀ᵐ ω ∂μ, ω.2 0 = 0) (hν0 : ∀ᵐ ω ∂ν, ω.2 0 = 0)
    (heq : ∀ s, MeasurableSet[tsStateSigma d] s → μ s = ν s) : μ = ν := by
  have hμ : μ.map tsNormalize = μ := by
    rw [Measure.map_congr (show tsNormalize =ᵐ[μ] id from
      hμ0.mono fun ω h => tsNormalize_eq_self h), Measure.map_id]
  have hν : ν.map tsNormalize = ν := by
    rw [Measure.map_congr (show tsNormalize =ᵐ[ν] id from
      hν0.mono fun ω h => tsNormalize_eq_self h), Measure.map_id]
  rw [← hμ, ← hν]
  ext s hs
  rw [Measure.map_apply measurable_tsNormalize hs, Measure.map_apply measurable_tsNormalize hs]
  exact heq _ (measurable_tsNormalize_stateSigma hs)

/-- The states at the window times `(-N + i) h`, `i < 2N + 1`. -/
def tsWindow (h : ℝ≥0) (N : ℕ) (ω : TwoSidedSpace d) : Fin (2 * N + 1) → FieldPair d :=
  fun i => tsState ((-(N : ℝ) + ((i : ℕ) : ℝ)) * h) ω

theorem measurable_tsWindow (h : ℝ≥0) (N : ℕ) : Measurable (tsWindow (d := d) h N) :=
  measurable_pi_iff.mpr fun _ => measurable_tsState _

/-- The sigma-algebra of a window. -/
abbrev tsWindowSigma (h : ℝ≥0) (N : ℕ) : MeasurableSpace (TwoSidedSpace d) :=
  MeasurableSpace.comap (tsWindow h N) MeasurableSpace.pi

theorem tsWindowSigma_eq (h : ℝ≥0) (N : ℕ) :
    tsWindowSigma (d := d) h N =
      ⨆ i : Fin (2 * N + 1), MeasurableSpace.comap
        (tsState ((-(N : ℝ) + ((i : ℕ) : ℝ)) * h)) inferInstance := by
  rw [tsWindowSigma, MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  congr 1
  funext i
  rw [MeasurableSpace.comap_comp]
  rfl

theorem tsWindowSigma_le_stateSigma (h : ℝ≥0) (N : ℕ) :
    tsWindowSigma (d := d) h N ≤ tsStateSigma d := by
  rw [tsWindowSigma_eq]
  exact iSup_le fun i => le_iSup (fun t => MeasurableSpace.comap (tsState (d := d) t)
    inferInstance) _

open Classical in
theorem tsGridProd_ofFn_indicator (h : ℝ≥0) :
    ∀ (n : ℕ) (A : Fin n → Set (FieldPair d)) (t : ℝ) (ω : TwoSidedSpace d),
      tsGridProd h t (List.ofFn fun i => (A i).indicator fun _ => (1 : ℝ)) ω =
        if ∀ i : Fin n, tsState (t + ((i : ℕ) : ℝ) * h) ω ∈ A i then 1 else 0
  | 0, A, t, ω => by simp [tsGridProd]
  | n + 1, A, t, ω => by
    rw [List.ofFn_succ]
    simp only [tsGridProd]
    rw [tsGridProd_ofFn_indicator h n (fun i => A i.succ) (t + h) ω]
    have hiff : (∀ i : Fin (n + 1), tsState (t + ((i : ℕ) : ℝ) * h) ω ∈ A i) ↔
        tsState t ω ∈ A 0 ∧ ∀ i : Fin n, tsState (t + h + ((i : ℕ) : ℝ) * h) ω ∈ A i.succ := by
      rw [Fin.forall_fin_succ]
      have he : ∀ i : Fin n, t + (((i.succ : Fin (n + 1)) : ℕ) : ℝ) * h =
          t + h + ((i : ℕ) : ℝ) * h := by
        intro i
        simp only [Fin.val_succ, Nat.cast_add, Nat.cast_one]
        ring
      simp only [Fin.val_zero, Nat.cast_zero, zero_mul, add_zero, he]
    by_cases h0 : tsState t ω ∈ A 0 <;>
      by_cases h1 : ∀ i : Fin n, tsState (t + h + ((i : ℕ) : ℝ) * h) ω ∈ A i.succ <;>
      simp [hiff, h0, h1]

theorem isUnitList_ofFn_indicator {n : ℕ} {A : Fin n → Set (FieldPair d)}
    (hA : ∀ i, MeasurableSet (A i)) :
    IsUnitList (List.ofFn fun i => (A i).indicator fun _ => (1 : ℝ)) := by
  intro f hf
  obtain ⟨i, rfl⟩ := List.mem_ofFn.1 hf
  refine ⟨measurable_const.indicator (hA i), fun ω => ?_⟩
  by_cases h : ω ∈ A i <;> simp [h]

/-- The measure of a window box event is the integral of the corresponding grid product. -/
theorem measure_window_box (μ : Measure (TwoSidedSpace d)) [IsProbabilityMeasure μ]
    (h : ℝ≥0) (N : ℕ) {A : Fin (2 * N + 1) → Set (FieldPair d)} (hA : ∀ i, MeasurableSet (A i))
    (Φ : TwoSidedSpace d → TwoSidedSpace d) (hΦ : Measurable Φ) :
    μ (Φ ⁻¹' (tsWindow h N ⁻¹' Set.pi Set.univ A)) = ENNReal.ofReal (∫ ω,
      tsGridProd h (-(N : ℝ) * h) (List.ofFn fun i => (A i).indicator fun _ => (1 : ℝ)) (Φ ω)
        ∂μ) := by
  have hS : MeasurableSet (Φ ⁻¹' (tsWindow h N ⁻¹' Set.pi Set.univ A)) :=
    hΦ (measurable_tsWindow h N (MeasurableSet.univ_pi hA))
  have hfun : (fun ω => tsGridProd h (-(N : ℝ) * h)
      (List.ofFn fun i => (A i).indicator fun _ => (1 : ℝ)) (Φ ω)) =
      (Φ ⁻¹' (tsWindow h N ⁻¹' Set.pi Set.univ A)).indicator 1 := by
    funext ω
    rw [tsGridProd_ofFn_indicator]
    have hiff : (∀ i : Fin (2 * N + 1), tsState (-(N : ℝ) * h + ((i : ℕ) : ℝ) * h) (Φ ω) ∈ A i) ↔
        ω ∈ Φ ⁻¹' (tsWindow h N ⁻¹' Set.pi Set.univ A) := by
      simp only [Set.mem_preimage, Set.mem_univ_pi, tsWindow]
      refine forall_congr' fun i => ?_
      rw [show -(N : ℝ) * h + ((i : ℕ) : ℝ) * h = (-(N : ℝ) + ((i : ℕ) : ℝ)) * h by ring]
    by_cases hP : ω ∈ Φ ⁻¹' (tsWindow h N ⁻¹' Set.pi Set.univ A)
    · rw [Set.indicator_of_mem hP]
      simp only [hiff.2 hP, implies_true, ↓reduceIte, Pi.one_apply]
    · have hn : ¬ ∀ i : Fin (2 * N + 1),
          tsState (-(N : ℝ) * h + ((i : ℕ) : ℝ) * h) (Φ ω) ∈ A i := fun h' => hP (hiff.1 h')
      rw [Set.indicator_of_notMem hP]
      simp only [hn, ↓reduceIte]
  rw [hfun, integral_indicator_one hS, ofReal_measureReal (measure_ne_top _ _)]

/-- The mesh `c 2^{-m}`. -/
def dyadicMesh (c : ℝ≥0) (m : ℕ) : ℝ≥0 := c / 2 ^ m

theorem tsWindowSigma_mono (c : ℝ≥0) (m : ℕ) :
    tsWindowSigma (d := d) (dyadicMesh c m) (4 ^ m) ≤
      tsWindowSigma (dyadicMesh c (m + 1)) (4 ^ (m + 1)) := by
  rw [tsWindowSigma_eq, tsWindowSigma_eq]
  refine iSup_le fun i => ?_
  have hi := i.2
  let j : Fin (2 * 4 ^ (m + 1) + 1) := ⟨2 * i + 2 * 4 ^ m, by rw [pow_succ]; omega⟩
  have ht : (-((4 ^ m : ℕ) : ℝ) + ((i : ℕ) : ℝ)) * (dyadicMesh c m : ℝ) =
      (-((4 ^ (m + 1) : ℕ) : ℝ) + ((j : ℕ) : ℝ)) * (dyadicMesh c (m + 1) : ℝ) := by
    simp only [j, dyadicMesh, NNReal.coe_div, NNReal.coe_pow, NNReal.coe_ofNat]
    push_cast
    field_simp
    ring
  rw [ht]
  exact le_iSup (fun j : Fin (2 * 4 ^ (m + 1) + 1) => MeasurableSpace.comap
    (tsState ((-((4 ^ (m + 1) : ℕ) : ℝ) + ((j : ℕ) : ℝ)) * (dyadicMesh c (m + 1) : ℝ)))
    inferInstance) j

/-- The window sets, over the meshes `c 2^{-m}`. -/
def tsWindowSets (d : ℕ) (c : ℝ≥0) : Set (Set (TwoSidedSpace d)) :=
  ⋃ m : ℕ, {s | MeasurableSet[tsWindowSigma (dyadicMesh c m) (4 ^ m)] s}

theorem isPiSystem_tsWindowSets (c : ℝ≥0) : IsPiSystem (tsWindowSets d c) := by
  refine isPiSystem_iUnion_of_directed_le _ (fun m => @MeasurableSpace.isPiSystem_measurableSet _
    (tsWindowSigma (dyadicMesh c m) (4 ^ m))) ?_
  refine Monotone.directed_le (monotone_nat_of_le_succ fun m => ?_)
  exact fun s hs => tsWindowSigma_mono c m s hs

private theorem measurable_of_tendsto_of {α β : Type*} {m : MeasurableSpace α}
    [TopologicalSpace β] [TopologicalSpace.PseudoMetrizableSpace β] [MeasurableSpace β]
    [BorelSpace β]
    {f : ℕ → α → β} {g : α → β} (hf : ∀ i, Measurable[m] (f i))
    (lim : ∀ x, Tendsto (fun i => f i x) atTop (𝓝 (g x))) : Measurable[m] g := by
  let _ : MeasurableSpace α := m
  exact measurable_of_tendsto_metrizable hf (tendsto_pi_nhds.2 lim)

theorem measurable_tsState_generateFrom (c : ℝ≥0) (hc : 0 < c) (t : ℝ) :
    Measurable[MeasurableSpace.generateFrom (tsWindowSets d c)] (tsState (d := d) t) := by
  let G := MeasurableSpace.generateFrom (tsWindowSets d c)
  have hwin : ∀ (m : ℕ) (i : Fin (2 * 4 ^ m + 1)),
      Measurable[G] (tsState (d := d) ((-((4 ^ m : ℕ) : ℝ) + ((i : ℕ) : ℝ)) *
        (dyadicMesh c m : ℝ))) := by
    intro m i
    have hle : tsWindowSigma (d := d) (dyadicMesh c m) (4 ^ m) ≤ G := fun s hs =>
      MeasurableSpace.measurableSet_generateFrom (Set.mem_iUnion.2 ⟨m, hs⟩)
    refine Measurable.of_comap_le (le_trans ?_ hle)
    rw [tsWindowSigma_eq]
    exact le_iSup (fun i : Fin (2 * 4 ^ m + 1) => MeasurableSpace.comap
      (tsState ((-((4 ^ m : ℕ) : ℝ) + ((i : ℕ) : ℝ)) * (dyadicMesh c m : ℝ))) inferInstance) i
  have hcpos : (0 : ℝ) < c := hc
  obtain ⟨M₀, hM₀⟩ := pow_unbounded_of_one_lt (|t| / c + 1) (by norm_num : (1 : ℝ) < 2)
  let hm : ℕ → ℝ := fun n => (dyadicMesh c (n + M₀) : ℝ)
  have hmpos : ∀ n, 0 < hm n := fun n => by
    simp only [hm, dyadicMesh, NNReal.coe_div, NNReal.coe_pow, NNReal.coe_ofNat]
    positivity
  let k : ℕ → ℤ := fun n => ⌊t / hm n⌋
  have hk : ∀ n, -((4 ^ (n + M₀) : ℕ) : ℤ) ≤ k n ∧ k n ≤ ((4 ^ (n + M₀) : ℕ) : ℤ) := by
    intro n
    have h2 : (2 : ℝ) ^ M₀ ≤ 2 ^ (n + M₀) := pow_le_pow_right₀ (by norm_num) (by omega)
    have hhm : hm n = c / 2 ^ (n + M₀) := by
      simp only [hm, dyadicMesh, NNReal.coe_div, NNReal.coe_pow, NNReal.coe_ofNat]
    have hratio : |t / hm n| ≤ (2 ^ (n + M₀) - 1) * 2 ^ (n + M₀) := by
      rw [hhm, abs_div, abs_of_pos (by positivity : (0 : ℝ) < c / 2 ^ (n + M₀)),
        div_div_eq_mul_div, div_le_iff₀ hcpos]
      have ht : |t| ≤ (2 ^ (n + M₀) - 1) * c := by
        have h1 : |t| / c < 2 ^ (n + M₀) - 1 := by linarith
        exact ((div_lt_iff₀ hcpos).1 h1).le
      nlinarith [pow_pos (by norm_num : (0 : ℝ) < 2) (n + M₀)]
    have h4 : ((4 ^ (n + M₀) : ℕ) : ℝ) = 2 ^ (n + M₀) * 2 ^ (n + M₀) := by
      push_cast
      rw [← mul_pow]
      norm_num
    have hfl := Int.floor_le (t / hm n)
    have hlt := Int.lt_floor_add_one (t / hm n)
    have habs := abs_le.1 hratio
    have hone : (1 : ℝ) ≤ 2 ^ (n + M₀) := one_le_pow₀ (by norm_num)
    constructor
    · have : (-((4 ^ (n + M₀) : ℕ) : ℝ)) < (k n : ℝ) + 1 := by
        simp only [k]
        rw [h4]
        nlinarith
      have : -((4 ^ (n + M₀) : ℕ) : ℤ) < k n + 1 := by exact_mod_cast this
      omega
    · have : (k n : ℝ) ≤ ((4 ^ (n + M₀) : ℕ) : ℝ) := by
        simp only [k]
        rw [h4]
        nlinarith
      exact_mod_cast this
  let f : ℕ → TwoSidedSpace d → FieldPair d := fun n => tsState ((k n : ℝ) * hm n)
  have hf : ∀ n, Measurable[G] (f n) := by
    intro n
    let i : Fin (2 * 4 ^ (n + M₀) + 1) := ⟨(k n + ((4 ^ (n + M₀) : ℕ) : ℤ)).toNat, by
      have := hk n
      omega⟩
    have hti : (k n : ℝ) * hm n =
        (-((4 ^ (n + M₀) : ℕ) : ℝ) + ((i : ℕ) : ℝ)) * (dyadicMesh c (n + M₀) : ℝ) := by
      have hnn : ((i : ℕ) : ℤ) = k n + ((4 ^ (n + M₀) : ℕ) : ℤ) := by
        simp only [i]
        have := hk n
        rw [Int.toNat_of_nonneg (by omega)]
      have : ((i : ℕ) : ℝ) = (k n : ℝ) + ((4 ^ (n + M₀) : ℕ) : ℝ) := by
        exact_mod_cast hnn
      rw [this]
      ring
    show Measurable[G] (tsState ((k n : ℝ) * hm n))
    rw [hti]
    exact hwin _ i
  let : PolishSpace (FieldPair d) := fieldPair_polish d
  refine measurable_of_tendsto_of hf fun ω => ?_
  have hcont : Continuous fun s : ℝ => tsState s ω :=
    Probability.continuous_translate.comp (ω.2.continuous.prodMk continuous_const)
  refine (hcont.tendsto t).comp ?_
  have hhm0 : Tendsto hm atTop (𝓝 0) := by
    have : hm = fun n => (c : ℝ) / 2 ^ (n + M₀) := by
      funext n
      simp only [hm, dyadicMesh, NNReal.coe_div, NNReal.coe_pow, NNReal.coe_ofNat]
    rw [this]
    have h := (tendsto_pow_atTop_atTop_of_one_lt (by norm_num : (1 : ℝ) < 2)).comp
      (tendsto_add_atTop_nat M₀)
    exact tendsto_const_nhds.div_atTop h
  have hle : ∀ n, |(k n : ℝ) * hm n - t| ≤ hm n := by
    intro n
    have hfl := Int.floor_le (t / hm n)
    have hlt := Int.lt_floor_add_one (t / hm n)
    have hpos := hmpos n
    rw [abs_le]
    constructor
    · have : t / hm n < (k n : ℝ) + 1 := hlt
      rw [div_lt_iff₀ hpos] at this
      nlinarith
    · have : (k n : ℝ) ≤ t / hm n := hfl
      rw [le_div_iff₀ hpos] at this
      nlinarith
  rw [tendsto_iff_norm_sub_tendsto_zero]
  exact squeeze_zero (fun n => norm_nonneg _) (fun n => by
    rw [Real.norm_eq_abs]
    exact hle n) hhm0

theorem tsStateSigma_eq_generateFrom (c : ℝ≥0) (hc : 0 < c) :
    tsStateSigma d = MeasurableSpace.generateFrom (tsWindowSets d c) := by
  apply le_antisymm
  · exact iSup_le fun t => (measurable_tsState_generateFrom c hc t).comap_le
  · refine MeasurableSpace.generateFrom_le fun s hs => ?_
    obtain ⟨m, hm⟩ := Set.mem_iUnion.1 hs
    exact tsWindowSigma_le_stateSigma _ _ s hm

section Annealed

variable (hd : 2 ≤ d) (D : StructuralData d)
  (Q : EnvironmentLaw d D.ellipticity D.dependenceRange) (hQ : HasSmoothBounds D Q)
  (hunforced : UnforcedAt hd Q) (hpath : PathwiseAt Q)
  (hap : ∀ᵐ ω ∂Q.measure, ω ∈ aperiodicSet d)
  {K : Kernel (FieldPair d × Vec d) (Path d)} [IsMarkovKernel K]
  (hK : ∀ ω : FieldPair d, IsRegular D.ellipticity ω → ∀ x : Vec d,
    SolvesMartingaleProblem (External.Draft.svGenerator (reducedCoefficient ω)
      (forcedDrift (reducedCoefficient ω) (⟨0, by omega⟩ : Fin d) 0)) x (K (ω, x)))

include hQ hunforced hpath hap hK in
/-- Window laws are invariant under a time map that moves grid products to grid products with
the same canonical value. -/
theorem tsLaw_window_eq {Φ : TwoSidedSpace d → TwoSidedSpace d} (hΦ : Measurable Φ)
    (h : ℝ≥0) (N : ℕ)
    (hgrid : ∀ L : List (FieldPair d → ℝ), IsUnitList L →
      ∫ ω, tsGridProd h (-(N : ℝ) * h) L (Φ ω) ∂tsLaw Q K = gridCV Q.measure K h L)
    {s : Set (TwoSidedSpace d)} (hs : MeasurableSet[tsWindowSigma h N] s) :
    tsLaw Q K (Φ ⁻¹' s) = tsLaw Q K s := by
  have := tsLaw_isProbability Q hap K
  obtain ⟨B, hB, rfl⟩ := hs
  have hmap : (tsLaw Q K).map (tsWindow h N ∘ Φ) = (tsLaw Q K).map (tsWindow h N) := by
    refine ext_of_generate_finite _ generateFrom_pi.symm isPiSystem_pi ?_ (by simp)
    rintro _ ⟨A, hA, rfl⟩
    have hA' : ∀ i, MeasurableSet (A i) := fun i => hA i (Set.mem_univ i)
    rw [Measure.map_apply ((measurable_tsWindow h N).comp hΦ) (MeasurableSet.univ_pi hA'),
      Measure.map_apply (measurable_tsWindow h N) (MeasurableSet.univ_pi hA'),
      Set.preimage_comp, measure_window_box _ h N hA' Φ hΦ,
      show tsWindow h N ⁻¹' Set.pi Set.univ A = id ⁻¹' (tsWindow h N ⁻¹' Set.pi Set.univ A)
        from rfl, measure_window_box _ h N hA' id measurable_id,
      hgrid _ (isUnitList_ofFn_indicator hA')]
    simp only [id]
    rw [show -(N : ℝ) * h = ((-(N : ℤ) : ℤ) : ℝ) * h by push_cast; ring,
      integral_tsGridProd hd D Q hQ hunforced hpath hap hK h _ (isUnitList_ofFn_indicator hA')]
  have h1 := congrArg (fun μ : Measure (Fin (2 * N + 1) → FieldPair d) => μ B) hmap
  simp only [Measure.map_apply ((measurable_tsWindow h N).comp hΦ) hB,
    Measure.map_apply (measurable_tsWindow h N) hB, Set.preimage_comp] at h1
  exact h1

include hQ hunforced hpath hap hK in
/-- A time map that lands in the paths vanishing at zero and preserves the canonical values of
the window grid products on the meshes `c 2^{-m}` preserves the law. -/
theorem tsLaw_map_eq_of_grid {Φ : TwoSidedSpace d → TwoSidedSpace d} (hΦ : Measurable Φ)
    (hΦ0 : ∀ ω, (Φ ω).2 0 = 0) (c : ℝ≥0) (hc : 0 < c)
    (hgrid : ∀ (m : ℕ) (L : List (FieldPair d → ℝ)), IsUnitList L →
      ∫ ω, tsGridProd (dyadicMesh c m) (-((4 ^ m : ℕ) : ℝ) * dyadicMesh c m) L (Φ ω)
        ∂tsLaw Q K = gridCV Q.measure K (dyadicMesh c m) L) :
    (tsLaw Q K).map Φ = tsLaw Q K := by
  have := tsLaw_isProbability Q hap K
  have hmeas0 : MeasurableSet {ω : TwoSidedSpace d | ω.2 0 = 0} :=
    measurableSet_eq_fun ((ContinuousMap.measurable_eval 0).comp measurable_snd) measurable_const
  refine measure_eq_of_stateSigma ?_ ?_ fun s hs => ?_
  · exact (ae_map_iff hΦ.aemeasurable hmeas0).2 (ae_of_all _ hΦ0)
  · unfold tsLaw
    exact (ae_map_iff measurable_tsGlue.aemeasurable hmeas0).2
      (ae_of_all _ fun z => gluePath_zero z.2)
  · refine ext_on_measurableSpace_of_generate_finite inferInstance (tsWindowSets d c) ?_
      tsStateSigma_le (tsStateSigma_eq_generateFrom c hc) (isPiSystem_tsWindowSets c)
      (by rw [Measure.map_apply hΦ MeasurableSet.univ, Set.preimage_univ]) hs
    intro t ht
    obtain ⟨m, hm⟩ := Set.mem_iUnion.1 ht
    have hmt : MeasurableSet t := tsStateSigma_le _ (tsWindowSigma_le_stateSigma _ _ _ hm)
    rw [Measure.map_apply hΦ hmt]
    exact tsLaw_window_eq hd D Q hQ hunforced hpath hap hK hΦ _ _ (hgrid m) hm

private theorem exists_dyadic_mesh (τ : ℝ) :
    ∃ c : ℝ≥0, 0 < c ∧ ∀ m : ℕ, ∃ j : ℤ, τ = j * (dyadicMesh c m : ℝ) := by
  rcases eq_or_ne τ 0 with rfl | hτ
  · exact ⟨1, one_pos, fun m => ⟨0, by simp⟩⟩
  · refine ⟨‖τ‖₊, nnnorm_pos.2 hτ, fun m => ?_⟩
    have hm : (dyadicMesh ‖τ‖₊ m : ℝ) = |τ| / 2 ^ m := by
      simp only [dyadicMesh, NNReal.coe_div, NNReal.coe_pow, NNReal.coe_ofNat, coe_nnnorm,
        Real.norm_eq_abs]
    rcases lt_or_gt_of_ne hτ with hneg | hpos
    · refine ⟨-(2 ^ m : ℤ), ?_⟩
      rw [hm, abs_of_neg hneg]
      push_cast
      field_simp
    · refine ⟨(2 ^ m : ℤ), ?_⟩
      rw [hm, abs_of_pos hpos]
      push_cast
      field_simp

include hQ hunforced hpath hap hK in
/-- Stationarity: the law of the two-sided process is invariant under every time shift. -/
theorem tsLaw_map_tsShift (τ : ℝ) : (tsLaw Q K).map (tsShift τ) = tsLaw Q K := by
  obtain ⟨c, hc, hτ⟩ := exists_dyadic_mesh τ
  refine tsLaw_map_eq_of_grid hd D Q hQ hunforced hpath hap hK (measurable_tsShift τ)
    (fun ω => by simp [tsShift, tsShiftPath]) c hc fun m L hL => ?_
  obtain ⟨j, hj⟩ := hτ m
  simp_rw [tsGridProd_shift]
  rw [show -((4 ^ m : ℕ) : ℝ) * dyadicMesh c m + τ =
      ((j - (4 ^ m : ℕ) : ℤ) : ℝ) * dyadicMesh c m by rw [hj]; push_cast; ring]
  exact integral_tsGridProd hd D Q hQ hunforced hpath hap hK _ _ hL

include hQ hunforced hpath hap hK in
/-- Reversibility: the law of the two-sided process is invariant under every time reflection. -/
theorem tsLaw_map_tsRefl (τ : ℝ) : (tsLaw Q K).map (tsRefl τ) = tsLaw Q K := by
  obtain ⟨c, hc, hτ⟩ := exists_dyadic_mesh τ
  refine tsLaw_map_eq_of_grid hd D Q hQ hunforced hpath hap hK (measurable_tsRefl τ)
    (fun ω => by simp [tsRefl, tsReflPath]) c hc fun m L hL => ?_
  obtain ⟨j, hj⟩ := hτ m
  set h := dyadicMesh c m
  have hrw : ∀ ω, tsGridProd h (-((4 ^ m : ℕ) : ℝ) * h) L (tsRefl τ ω) =
      tsGridProd h (((2 * j + (4 ^ m : ℕ) - L.length + 1 : ℤ) : ℝ) * h) L.reverse ω := by
    intro ω
    rw [tsGridProd_refl, tsGridProd_reverse]
    congr 1
    rw [hj]
    push_cast
    ring
  simp_rw [hrw]
  rw [integral_tsGridProd hd D Q hQ hunforced hpath hap hK _ _ hL.reverse,
    gridCV_reverse hd D Q hQ hunforced hpath hK _ hL]

end Annealed

