/-- The canonical filtration at a fixed time is generated by the complete stopped path. -/
theorem u3_pathFiltration_eq_prefix {d : ℕ} (T : ℝ≥0) :
    pathFiltration d T = MeasurableSpace.comap (gmpPrefixPath (d := d) T) inferInstance := by
  rw [comap_gmpPrefixPath_eq_gmpPastSigma]
  simp only [pathFiltration, Filtration.natural, gmpPastSigma, iSup_subtype']
  rfl

/-- A canonical past event cannot distinguish paths with equal stopped prefixes. -/
theorem u3_past_event_mem_iff_of_prefix_eq {d : ℕ} (T : ℝ≥0)
    {A : Set (Path d)} (hA : MeasurableSet[pathFiltration d T] A)
    {γ η : Path d} (h : gmpPrefixPath T γ = gmpPrefixPath T η) : γ ∈ A ↔ η ∈ A := by
  rw [u3_pathFiltration_eq_prefix] at hA
  obtain ⟨B, hB, rfl⟩ := hA
  change gmpPrefixPath T γ ∈ B ↔ gmpPrefixPath T η ∈ B
  rw [h]

/-- Pasting a continuation at a deterministic time leaves the entire past unchanged. -/
def u3AppendPaths {d : ℕ} (T : ℝ≥0) (γ η : Path d) : Path d :=
  ⟨fun t => γ (min t T) + η (t - T) - η 0,
    ((γ.continuous.comp (continuous_id.min continuous_const)).add
      (η.continuous.comp (continuous_id.sub continuous_const))).sub continuous_const⟩

theorem u3_continuous_appendPaths {d : ℕ} (T : ℝ≥0) :
    Continuous (fun q : Path d × Path d => u3AppendPaths T q.1 q.2) := by
  apply ContinuousMap.continuous_of_continuous_uncurry
  exact (((continuous_fst.fst).eval (continuous_snd.min continuous_const)).add
    ((continuous_fst.snd).eval (continuous_snd.sub continuous_const))).sub
      ((continuous_fst.snd).eval continuous_const)

theorem u3_appendPaths_left {d : ℕ} (T : ℝ≥0) (γ η : Path d)
    {t : ℝ≥0} (ht : t ≤ T) : u3AppendPaths T γ η t = γ t := by
  change γ (min t T) + η (t - T) - η 0 = γ t
  rw [min_eq_left ht, tsub_eq_zero_of_le ht, add_sub_cancel_right]

theorem u3_appendPaths_right {d : ℕ} (T : ℝ≥0) (γ η : Path d)
    (hmatch : η 0 = γ T) {t : ℝ≥0} (ht : T ≤ t) :
    u3AppendPaths T γ η t = η (t - T) := by
  change γ (min t T) + η (t - T) - η 0 = η (t - T)
  rw [min_eq_right ht, ← hmatch, add_sub_cancel_left]

theorem u3_appendPaths_prefix {d : ℕ} (T : ℝ≥0) (γ η : Path d) :
    gmpPrefixPath T (u3AppendPaths T γ η) = gmpPrefixPath T γ := by
  apply ContinuousMap.ext
  intro t
  change γ (min (min t T) T) + η (min t T - T) - η 0 = γ (min t T)
  rw [min_eq_left (min_le_right _ _), tsub_eq_zero_of_le (min_le_right _ _), add_sub_cancel_right]

/-- Before the join, a compensated test has exactly its original value. -/
theorem u3_appendPaths_compensated_before {d : ℕ} (T t : ℝ≥0) (ht : t ≤ T)
    (γ η : Path d) (L : (Vec d → ℝ) → Vec d → ℝ) (f : Vec d → ℝ) :
    compensatedTest L f t (u3AppendPaths T γ η) = compensatedTest L f t γ := by
  unfold compensatedTest
  rw [u3_appendPaths_left T γ η ht,
    u3_appendPaths_left T γ η (show (0 : ℝ≥0) ≤ T from bot_le)]
  congr 1
  apply intervalIntegral.integral_congr
  intro r hr
  have hr' : r ∈ Set.Icc (0 : ℝ) t := by
    simpa only [Set.uIcc_of_le t.coe_nonneg] using hr
  have hrt : r.toNNReal ≤ t := by
    exact_mod_cast (show (r.toNNReal : ℝ) ≤ (t : ℝ) by
      rw [Real.coe_toNNReal _ hr'.1]; exact hr'.2)
  change L f (u3AppendPaths T γ η r.toNNReal) = L f (γ r.toNNReal)
  rw [u3_appendPaths_left T γ η (hrt.trans ht)]

theorem u3_appendPaths_mem_past_iff {d : ℕ} (T : ℝ≥0)
    {A : Set (Path d)} (hA : MeasurableSet[pathFiltration d T] A) (γ η : Path d) :
    u3AppendPaths T γ η ∈ A ↔ γ ∈ A :=
  u3_past_event_mem_iff_of_prefix_eq T hA (u3_appendPaths_prefix T γ η)

/-- The past of an appended path through s depends only on the continuation
through the elapsed time s - T. -/
theorem u3_appendPaths_prefix_continuation {d : ℕ} (T s : ℝ≥0)
    (γ η : Path d) :
    gmpPrefixPath s (u3AppendPaths T γ η) =
      gmpPrefixPath s (u3AppendPaths T γ (gmpPrefixPath (s - T) η)) := by
  apply ContinuousMap.ext
  intro t
  change γ (min (min t s) T) + η (min t s - T) - η 0 =
    γ (min (min t s) T) + η (min (min t s - T) (s - T)) - η (min 0 (s - T))
  rw [min_eq_left (tsub_le_tsub_right (min_le_right t s) T)]
  simp

/-- Sections of a pasted past event are continuation-past events. -/
theorem u3_appendPaths_past_section {d : ℕ} (T s : ℝ≥0) (γ : Path d)
    {A : Set (Path d)} (hA : MeasurableSet[pathFiltration d s] A) :
    MeasurableSet[pathFiltration d (s - T)] {η | u3AppendPaths T γ η ∈ A} := by
  rw [u3_pathFiltration_eq_prefix] at hA ⊢
  obtain ⟨B, hB, rfl⟩ := hA
  let F : Path d → Path d := fun η => gmpPrefixPath s (u3AppendPaths T γ η)
  have hF : Measurable F := (measurable_gmpPrefixPath s).comp
    ((u3_continuous_appendPaths T).measurable.comp (measurable_const.prodMk measurable_id))
  refine ⟨F ⁻¹' B, hF hB, ?_⟩
  ext η
  change F (gmpPrefixPath (s - T) η) ∈ B ↔ gmpPrefixPath s (u3AppendPaths T γ η) ∈ B
  exact Iff.of_eq (congrArg (fun z => z ∈ B) (u3_appendPaths_prefix_continuation T s γ η)).symm

/-- On the continuation segment the generator integral shifts with the path. -/
theorem u3_appendPaths_integral_after {d : ℕ} (T t : ℝ≥0) (ht : T ≤ t)
    (γ η : Path d) (hmatch : η 0 = γ T) (g : Vec d → ℝ) :
    (∫ r in (T : ℝ)..(t : ℝ), g (u3AppendPaths T γ η r.toNNReal)) =
      ∫ r in (0 : ℝ)..((t - T : ℝ≥0) : ℝ), g (η r.toNNReal) := by
  have hTt : (T : ℝ) ≤ (t : ℝ) := by exact_mod_cast ht
  have he : ∀ r ∈ Set.uIcc (T : ℝ) (t : ℝ),
      g (u3AppendPaths T γ η r.toNNReal) = g (η (r - (T : ℝ)).toNNReal) := by
    intro r hr
    have hrT : (T : ℝ) ≤ r := (Set.uIcc_of_le hTt ▸ hr).1
    have hr0 : 0 ≤ r := T.coe_nonneg.trans hrT
    have hTr : T ≤ r.toNNReal := by
      exact_mod_cast (show (T : ℝ) ≤ (r.toNNReal : ℝ) by simpa [Real.coe_toNNReal _ hr0] using hrT)
    rw [u3_appendPaths_right T γ η hmatch hTr]
    congr 2
    apply NNReal.eq
    rw [NNReal.coe_sub hTr, Real.coe_toNNReal _ hr0,
      Real.coe_toNNReal _ (sub_nonneg.mpr hrT)]
  rw [intervalIntegral.integral_congr he]
  have hs := intervalIntegral.integral_comp_sub_right (fun r : ℝ => g (η r.toNNReal))
    (T : ℝ) (a := (T : ℝ)) (b := (t : ℝ))
  simpa only [sub_self, NNReal.coe_sub ht] using hs

/-- The compensated test increment after the join is the continuation's
compensated test, started at its matching endpoint. -/
theorem u3_appendPaths_compensated_after {d : ℕ} (T t : ℝ≥0) (ht : T ≤ t)
    (γ η : Path d) (hmatch : η 0 = γ T)
    (L : (Vec d → ℝ) → Vec d → ℝ) (f : Vec d → ℝ)
    (h₀ : IntervalIntegrable (fun r : ℝ => L f (u3AppendPaths T γ η r.toNNReal)) volume 0 T)
    (h₁ : IntervalIntegrable (fun r : ℝ => L f (u3AppendPaths T γ η r.toNNReal)) volume T t) :
    compensatedTest L f t (u3AppendPaths T γ η) -
        compensatedTest L f T (u3AppendPaths T γ η) =
      compensatedTest L f (t - T) η := by
  rw [u3_compensatedTest_interval L f T t (u3AppendPaths T γ η) h₀ h₁,
    u3_appendPaths_right T γ η hmatch ht,
    u3_appendPaths_left T γ η (le_refl T),
    u3_appendPaths_integral_after T t ht γ η hmatch]
  unfold compensatedTest
  rw [hmatch]

/-- A compensated increment entirely after the join is the corresponding
increment of the continuation. -/
theorem u3_appendPaths_compensated_increment_after {d : ℕ} (T s t : ℝ≥0)
    (hs : T ≤ s) (ht : T ≤ t) (γ η : Path d) (hmatch : η 0 = γ T)
    (L : (Vec d → ℝ) → Vec d → ℝ) (f : Vec d → ℝ)
    (hInt : ∀ a b : ℝ, IntervalIntegrable
      (fun r : ℝ => L f (u3AppendPaths T γ η r.toNNReal)) volume a b) :
    compensatedTest L f t (u3AppendPaths T γ η) -
        compensatedTest L f s (u3AppendPaths T γ η) =
      compensatedTest L f (t - T) η - compensatedTest L f (s - T) η := by
  have ht' := u3_appendPaths_compensated_after T t ht γ η hmatch L f
    (hInt 0 T) (hInt T t)
  have hs' := u3_appendPaths_compensated_after T s hs γ η hmatch L f
    (hInt 0 T) (hInt T s)
  linarith

/-- A continuation martingale has zero expected increment on each section of
a past event of the pasted path. -/
theorem u3_appendPaths_post_increment_section {d : ℕ}
    {Λ₀ : ℝ} (hΛ : 0 < Λ₀) {ω : FieldPair d} (hω : IsRegular Λ₀ ω)
    (i : Fin d) (lam : ℝ) (T s t : ℝ≥0) (hs : T ≤ s) (hst : s ≤ t)
    (γ : Path d) {N : Measure (Path d)}
    (hN : SolvesMartingaleProblem (External.Draft.svGenerator
      (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i lam)) (γ T) N)
    (f : Vec d → ℝ) (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hc : HasCompactSupport f)
    {A : Set (Path d)} (hA : MeasurableSet[pathFiltration d s] A) :
    let L := External.Draft.svGenerator (reducedCoefficient ω)
      (forcedDrift (reducedCoefficient ω) i lam)
    ∫ η in {η | u3AppendPaths T γ η ∈ A},
      (compensatedTest L f t (u3AppendPaths T γ η) -
        compensatedTest L f s (u3AppendPaths T γ η)) ∂N = 0 := by
  intro L
  letI : IsProbabilityMeasure N := hN.1
  let E := {η | u3AppendPaths T γ η ∈ A}
  have hE : MeasurableSet[pathFiltration d (s - T)] E :=
    u3_appendPaths_past_section T s γ hA
  obtain ⟨hA', _, ⟨Ma, hAb⟩, _, hb, ⟨Mb, hbb⟩⟩ := reduced_svHypotheses hΛ hω i lam
  have hcoef : BddCoef (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i lam)
      (max Ma Mb) := ⟨fun k j => (hA'.matrix_elem k j).measurable,
        fun k => (measurable_pi_apply k).comp hb,
        fun y k j => (hAb y k j).trans (le_max_left _ _),
        fun y k => (hbb y k).trans (le_max_right _ _)⟩
  obtain ⟨C, hC⟩ := bounded_svGenerator _ _ hAb hbb (contDiff_two_of_top hf) hc
  have hGm : Measurable (fun p : ℝ × Path d => L f (p.2 p.1.toNNReal)) :=
    (hcoef.measurable_gen f).comp
      (continuous_snd.eval (continuous_real_toNNReal.comp continuous_fst)).measurable
  have hInt (η : Path d) (a b : ℝ) : IntervalIntegrable
      (fun r : ℝ => L f (u3AppendPaths T γ η r.toNNReal)) volume a b :=
    u3_intervalIntegrable_bounded_slice hGm (fun r _ (z : Path d) => hC (z r.toNNReal)) _
  have heq := (hN.2.2 f hf hc).2.2.setIntegral_eq (tsub_le_tsub_right hst T) hE
  have hdiff := integral_sub (((hN.2.2 f hf hc).2.1 (t - T)).integrableOn (s := E))
    (((hN.2.2 f hf hc).2.1 (s - T)).integrableOn (s := E))
  calc
    _ = ∫ η in E, (compensatedTest L f (t - T) η -
        compensatedTest L f (s - T) η) ∂N := by
      apply integral_congr_ae
      filter_upwards [ae_restrict_of_ae hN.2.1] with η hmatch
      exact u3_appendPaths_compensated_increment_after T s t hs (hs.trans hst)
        γ η hmatch L f (hInt η)
    _ = 0 := by rw [hdiff, heq, sub_self]

/-- Any Markov continuation preserves the original law on the complete past. -/
theorem u3_pasted_law_apply_past {d : ℕ} (T : ℝ≥0) (Q : Measure (Path d))
    [IsFiniteMeasure Q] (K : Kernel (Path d) (Path d)) [IsMarkovKernel K]
    {A : Set (Path d)} (hA : MeasurableSet[pathFiltration d T] A) :
    ((Q ⊗ₘ K).map (fun q => u3AppendPaths T q.1 q.2)) A = Q A := by
  have hAm : MeasurableSet A := (pathFiltration d).le T A hA
  rw [Measure.map_apply (u3_continuous_appendPaths T).measurable hAm]
  have hpre : (fun q : Path d × Path d => u3AppendPaths T q.1 q.2) ⁻¹' A =
      Prod.fst ⁻¹' A := by
    ext q
    exact u3_appendPaths_mem_past_iff T hA q.1 q.2
  rw [hpre, ← Measure.map_apply measurable_fst hAm]
  exact congrArg (fun μ : Measure (Path d) => μ A) (Measure.fst_compProd Q K)

/-- The continuation martingales give zero post-join increments under the
entire pasted measure. -/
theorem u3_pasted_law_post_increment {d : ℕ}
    {Λ₀ : ℝ} (hΛ : 0 < Λ₀) {ω : FieldPair d} (hω : IsRegular Λ₀ ω)
    (i : Fin d) (lam : ℝ) (T s t : ℝ≥0) (hs : T ≤ s) (hst : s ≤ t)
    (Q : Measure (Path d)) [IsProbabilityMeasure Q]
    (K : Kernel (Path d) (Path d)) [IsMarkovKernel K]
    (hK : ∀ γ, SolvesMartingaleProblem (External.Draft.svGenerator
      (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i lam)) (γ T) (K γ))
    (f : Vec d → ℝ) (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hc : HasCompactSupport f)
    {A : Set (Path d)} (hA : MeasurableSet[pathFiltration d s] A) :
    let L := External.Draft.svGenerator (reducedCoefficient ω)
      (forcedDrift (reducedCoefficient ω) i lam)
    ∫ γ in A, (compensatedTest L f t γ - compensatedTest L f s γ)
      ∂((Q ⊗ₘ K).map (fun q => u3AppendPaths T q.1 q.2)) = 0 := by
  intro L
  let Φ : Path d × Path d → Path d := fun q => u3AppendPaths T q.1 q.2
  let S := (Q ⊗ₘ K).map Φ
  letI : IsProbabilityMeasure S := inferInstanceAs (IsProbabilityMeasure ((Q ⊗ₘ K).map Φ))
  have hΦ : Measurable Φ := (u3_continuous_appendPaths T).measurable
  have hAm : MeasurableSet A := (pathFiltration d).le s A hA
  obtain ⟨had, hint⟩ := u3_forced_compensated_stopped_integrable hΛ hω i lam t f hf hc S
  have hm (v : ℝ≥0) (hv : v ≤ t) : StronglyMeasurable (compensatedTest L f v) := by
    simpa only [min_eq_left hv] using (had v).mono ((pathFiltration d).le v)
  have hi (v : ℝ≥0) (hv : v ≤ t) : Integrable (compensatedTest L f v) S := by
    simpa only [min_eq_left hv] using hint v
  have hmDiff := (hm t le_rfl).sub (hm s hst)
  have hiDiff := (hi t le_rfl).sub (hi s hst)
  have hiComp : Integrable (fun q => (A.indicator (fun γ =>
      compensatedTest L f t γ - compensatedTest L f s γ)) (Φ q)) (Q ⊗ₘ K) := by
    apply (integrable_map_measure (hmDiff.indicator hAm).aestronglyMeasurable
      hΦ.aemeasurable).mp
    exact hiDiff.indicator hAm
  change (∫ γ in A, (compensatedTest L f t - compensatedTest L f s) γ
    ∂((Q ⊗ₘ K).map Φ)) = 0
  rw [setIntegral_map hAm hmDiff.aestronglyMeasurable hΦ.aemeasurable]
  rw [← integral_indicator (hΦ hAm)]
  have heq : (fun q => (Φ ⁻¹' A).indicator
      (fun q => compensatedTest L f t (Φ q) - compensatedTest L f s (Φ q)) q) =
      (fun q => (A.indicator (fun γ => compensatedTest L f t γ -
        compensatedTest L f s γ)) (Φ q)) := by
    funext q
    by_cases hq : Φ q ∈ A <;> simp [hq]
  change (∫ q, (Φ ⁻¹' A).indicator (fun q =>
    compensatedTest L f t (Φ q) - compensatedTest L f s (Φ q)) q ∂(Q ⊗ₘ K)) = 0
  rw [heq, Measure.integral_compProd hiComp]
  apply integral_eq_zero_of_ae
  filter_upwards [] with γ
  have hsec : MeasurableSet {η | u3AppendPaths T γ η ∈ A} :=
    ((u3_continuous_appendPaths T).measurable.comp
      (measurable_const.prodMk measurable_id)) hAm
  have hpoint : (fun η => A.indicator (fun z => compensatedTest L f t z -
      compensatedTest L f s z) (Φ (γ, η))) =
      (fun η => {η | u3AppendPaths T γ η ∈ A}.indicator (fun η =>
        compensatedTest L f t (u3AppendPaths T γ η) -
        compensatedTest L f s (u3AppendPaths T γ η)) η) := by
    funext η
    by_cases hη : u3AppendPaths T γ η ∈ A <;> simp [Φ, hη]
  rw [hpoint, integral_indicator hsec]
  exact u3_appendPaths_post_increment_section hΛ hω i lam T s t hs hst γ
    (hK γ) f hf hc hA

/-- A stopped martingale under the initial law gives the pre-join increments
of the pasted law. -/
theorem u3_pasted_law_pre_increment {d : ℕ} (T s t : ℝ≥0)
    (hst : s ≤ t) (ht : t ≤ T) (Q : Measure (Path d)) [IsProbabilityMeasure Q]
    (K : Kernel (Path d) (Path d)) [IsMarkovKernel K]
    (L : (Vec d → ℝ) → Vec d → ℝ) (f : Vec d → ℝ)
    (hM : Martingale (fun v => compensatedTest L f (min v T)) (pathFiltration d) Q)
    (hInt : ∀ v, Integrable (compensatedTest L f (min v T)) Q)
    {A : Set (Path d)} (hA : MeasurableSet[pathFiltration d s] A) :
    ∫ γ in A, (compensatedTest L f t γ - compensatedTest L f s γ)
      ∂((Q ⊗ₘ K).map (fun q => u3AppendPaths T q.1 q.2)) = 0 := by
  let Φ : Path d × Path d → Path d := fun q => u3AppendPaths T q.1 q.2
  have hs : s ≤ T := hst.trans ht
  have hAm : MeasurableSet A := (pathFiltration d).le s A hA
  have hAT : MeasurableSet[pathFiltration d T] A := (pathFiltration d).mono hs A hA
  have hΦ : Measurable Φ := (u3_continuous_appendPaths T).measurable
  have hm (v : ℝ≥0) (hv : v ≤ T) : StronglyMeasurable (compensatedTest L f v) := by
    simpa only [min_eq_left hv] using (hM.stronglyMeasurable v).mono ((pathFiltration d).le v)
  have hi (v : ℝ≥0) (hv : v ≤ T) : Integrable (compensatedTest L f v) Q := by
    simpa only [min_eq_left hv] using hInt v
  have hmDiff := (hm t ht).sub (hm s hs)
  have hpre : Φ ⁻¹' A = Prod.fst ⁻¹' A := by
    ext q
    exact u3_appendPaths_mem_past_iff T hAT q.1 q.2
  change (∫ γ in A, (compensatedTest L f t - compensatedTest L f s) γ
    ∂((Q ⊗ₘ K).map Φ)) = 0
  rw [setIntegral_map hAm hmDiff.aestronglyMeasurable hΦ.aemeasurable, hpre]
  have heq : (∫ q in Prod.fst ⁻¹' A,
      (compensatedTest L f t - compensatedTest L f s) (Φ q) ∂(Q ⊗ₘ K)) =
      ∫ q in Prod.fst ⁻¹' A,
        (compensatedTest L f t - compensatedTest L f s) q.1 ∂(Q ⊗ₘ K) := by
    apply integral_congr_ae
    exact ae_of_all _ fun q => by
      change compensatedTest L f t (u3AppendPaths T q.1 q.2) -
        compensatedTest L f s (u3AppendPaths T q.1 q.2) = _
      rw [u3_appendPaths_compensated_before T t ht q.1 q.2 L f,
        u3_appendPaths_compensated_before T s hs q.1 q.2 L f]
      rfl
  rw [heq, ← setIntegral_map hAm hmDiff.aestronglyMeasurable measurable_fst.aemeasurable]
  change (∫ γ in A, (compensatedTest L f t - compensatedTest L f s) γ
    ∂(Q ⊗ₘ K).fst) = 0
  rw [Measure.fst_compProd]
  have hmEq := hM.setIntegral_eq hst hA
  simp only [min_eq_left hs, min_eq_left ht] at hmEq
  have hdiff := integral_sub ((hi t ht).integrableOn (s := A))
    ((hi s hs).integrableOn (s := A))
  change (∫ γ in A, compensatedTest L f t γ - compensatedTest L f s γ ∂Q) = 0
  rw [hdiff, hmEq, sub_self]

/-- The pasted compensated test has zero increments across a past event,
including intervals that cross the joining time. -/
theorem u3_pasted_law_increment {d : ℕ}
    {Λ₀ : ℝ} (hΛ : 0 < Λ₀) {ω : FieldPair d} (hω : IsRegular Λ₀ ω)
    (i : Fin d) (lam : ℝ) (T s t : ℝ≥0) (hst : s ≤ t)
    (Q : Measure (Path d)) [IsProbabilityMeasure Q]
    (K : Kernel (Path d) (Path d)) [IsMarkovKernel K]
    (hK : ∀ γ, SolvesMartingaleProblem (External.Draft.svGenerator
      (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i lam)) (γ T) (K γ))
    (f : Vec d → ℝ) (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hc : HasCompactSupport f)
    (hM : Martingale (fun v => compensatedTest (External.Draft.svGenerator
      (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i lam)) f (min v T))
        (pathFiltration d) Q)
    (hInt : ∀ v, Integrable (compensatedTest (External.Draft.svGenerator
      (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i lam)) f (min v T)) Q)
    {A : Set (Path d)} (hA : MeasurableSet[pathFiltration d s] A) :
    let L := External.Draft.svGenerator (reducedCoefficient ω)
      (forcedDrift (reducedCoefficient ω) i lam)
    ∫ γ in A, (compensatedTest L f t γ - compensatedTest L f s γ)
      ∂((Q ⊗ₘ K).map (fun q => u3AppendPaths T q.1 q.2)) = 0 := by
  intro L
  by_cases ht : t ≤ T
  · exact u3_pasted_law_pre_increment T s t hst ht Q K L f hM hInt hA
  · have hTt : T ≤ t := le_of_not_ge ht
    by_cases hs : T ≤ s
    · exact u3_pasted_law_post_increment hΛ hω i lam T s t hs hst Q K hK f hf hc hA
    · have hsT : s ≤ T := le_of_not_ge hs
      have hAT : MeasurableSet[pathFiltration d T] A := (pathFiltration d).mono hsT A hA
      have hpre := u3_pasted_law_pre_increment T s T hsT le_rfl Q K L f hM hInt hA
      have hpost := u3_pasted_law_post_increment hΛ hω i lam T T t le_rfl hTt
        Q K hK f hf hc hAT
      let S := (Q ⊗ₘ K).map (fun q => u3AppendPaths T q.1 q.2)
      letI : IsProbabilityMeasure S := inferInstanceAs (IsProbabilityMeasure
        ((Q ⊗ₘ K).map (fun q => u3AppendPaths T q.1 q.2)))
      obtain ⟨_, hi⟩ := u3_forced_compensated_stopped_integrable hΛ hω i lam t f hf hc S
      have hi' (v : ℝ≥0) (hv : v ≤ t) : Integrable (compensatedTest L f v) S := by
        simpa only [min_eq_left hv] using hi v
      have hsum := integral_add
        (((hi' t le_rfl).sub (hi' T hTt)).integrableOn (s := A))
        (((hi' T hTt).sub (hi' s hst)).integrableOn (s := A))
      have heq : (∫ γ in A, compensatedTest L f t γ - compensatedTest L f s γ ∂S) =
          ∫ γ in A, ((compensatedTest L f t γ - compensatedTest L f T γ) +
            (compensatedTest L f T γ - compensatedTest L f s γ)) ∂S := by
        apply integral_congr_ae
        exact ae_of_all _ fun γ => by ring
      rw [heq]
      change (∫ γ in A, (compensatedTest L f t - compensatedTest L f T) γ +
        (compensatedTest L f T - compensatedTest L f s) γ ∂S) = 0
      rw [hsum]
      change (∫ γ in A, compensatedTest L f t γ - compensatedTest L f T γ ∂S) +
        (∫ γ in A, compensatedTest L f T γ - compensatedTest L f s γ ∂S) = 0
      rw [hpost, hpre, add_zero]

/-- A stopped initial martingale problem followed by the endpoint kernel
solves the full reduced martingale problem. -/
theorem u3_pasted_law_solves {d : ℕ}
    {Λ₀ : ℝ} (hΛ : 0 < Λ₀) {ω : FieldPair d} (hω : IsRegular Λ₀ ω)
    (i : Fin d) (lam : ℝ) (T : ℝ≥0) (x : Vec d)
    (Q : Measure (Path d)) [IsProbabilityMeasure Q]
    (hstart : ∀ᵐ γ ∂Q, γ 0 = x)
    (K : Kernel (Path d) (Path d)) [IsMarkovKernel K]
    (hK : ∀ γ, SolvesMartingaleProblem (External.Draft.svGenerator
      (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i lam)) (γ T) (K γ))
    (hM : ∀ f : Vec d → ℝ, ContDiff ℝ (⊤ : ℕ∞) f → HasCompactSupport f →
      Martingale (fun v => compensatedTest (External.Draft.svGenerator
        (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i lam)) f (min v T))
          (pathFiltration d) Q) :
    SolvesMartingaleProblem (External.Draft.svGenerator (reducedCoefficient ω)
      (forcedDrift (reducedCoefficient ω) i lam)) x
      ((Q ⊗ₘ K).map (fun q => u3AppendPaths T q.1 q.2)) := by
  let L := External.Draft.svGenerator (reducedCoefficient ω)
    (forcedDrift (reducedCoefficient ω) i lam)
  let Φ : Path d × Path d → Path d := fun q => u3AppendPaths T q.1 q.2
  let S := (Q ⊗ₘ K).map Φ
  letI : IsProbabilityMeasure S := inferInstanceAs (IsProbabilityMeasure ((Q ⊗ₘ K).map Φ))
  have hΦ : Measurable Φ := (u3_continuous_appendPaths T).measurable
  obtain ⟨hA, _, ⟨Ma, hAb⟩, _, hb, ⟨Mb, hbb⟩⟩ := reduced_svHypotheses hΛ hω i lam
  have hcoef : BddCoef (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i lam)
      (max Ma Mb) := ⟨fun k j => (hA.matrix_elem k j).measurable,
        fun k => (measurable_pi_apply k).comp hb,
        fun y k j => (hAb y k j).trans (le_max_left _ _),
        fun y k => (hbb y k).trans (le_max_right _ _)⟩
  change SolvesMartingaleProblem L x S
  refine ⟨inferInstance, ?_, ?_⟩
  · have hmeas : MeasurableSet {γ : Path d | γ 0 = x} :=
      (measurable_pathPosition 0) (measurableSet_singleton x)
    have hmap : ∀ᵐ γ ∂((Q ⊗ₘ K).map Prod.fst), γ 0 = x := by
      change ∀ᵐ γ ∂(Q ⊗ₘ K).fst, γ 0 = x
      rw [Measure.fst_compProd]
      exact hstart
    have hp := (ae_map_iff measurable_fst.aemeasurable hmeas).mp hmap
    rw [ae_map_iff hΦ.aemeasurable hmeas]
    filter_upwards [hp] with q hq
    change u3AppendPaths T q.1 q.2 0 = x
    rw [u3_appendPaths_left T q.1 q.2 (show (0 : ℝ≥0) ≤ T from bot_le)]
    exact hq
  · intro f hf hc
    obtain ⟨C, hC⟩ := bounded_svGenerator _ _ hAb hbb (contDiff_two_of_top hf) hc
    have hGm : Measurable (fun p : ℝ × Path d => L f (p.2 p.1.toNNReal)) :=
      (hcoef.measurable_gen f).comp
        (continuous_snd.eval (continuous_real_toNNReal.comp continuous_fst)).measurable
    have hslice (γ : Path d) (a b : ℝ) : IntervalIntegrable
        (fun r : ℝ => L f (γ r.toNNReal)) volume a b :=
      u3_intervalIntegrable_bounded_slice hGm (fun r _ (z : Path d) => hC (z r.toNNReal)) γ
    have had : StronglyAdapted (pathFiltration d) (compensatedTest L f) :=
      stronglyAdapted_compensatedTest_of_measurable L f hf.continuous (hcoef.measurable_gen f)
    have hi (v : ℝ≥0) : Integrable (compensatedTest L f v) S := by
      obtain ⟨_, h⟩ := u3_forced_compensated_stopped_integrable hΛ hω i lam v f hf hc S
      simpa using h v
    have hiQ : ∀ v, Integrable (compensatedTest L f (min v T)) Q :=
      (u3_forced_compensated_stopped_integrable hΛ hω i lam T f hf hc Q).2
    refine ⟨fun v => ae_of_all _ fun γ => hslice γ 0 v, hi, had, ?_⟩
    intro s t hst
    symm
    apply ae_eq_condExp_of_forall_setIntegral_eq ((pathFiltration d).le s) (hi t)
      (fun _ _ _ => (hi s).integrableOn) ?_ (had s).aestronglyMeasurable
    intro A hA _
    have hz := u3_pasted_law_increment hΛ hω i lam T s t hst Q K hK f hf hc
      (hM f hf hc) hiQ hA
    have hdiff := integral_sub ((hi t).integrableOn (s := A)) ((hi s).integrableOn (s := A))
    change (∫ γ in A, compensatedTest L f t γ - compensatedTest L f s γ ∂S) = 0 at hz
    rw [hdiff] at hz
    linarith

/-- The signed terminal tilt agrees with the supplied forced law on the
canonical filtration at the finite horizon. -/
theorem u3_reduced_force_finite_horizon_law {d : ℕ} (hd : 1 ≤ d) {Λ₀ : ℝ} (hΛ : 0 < Λ₀)
    {ω : FieldPair d} (hω : IsRegular Λ₀ ω) (i : Fin d)
    {x : Vec d} {P : Measure (Path d)}
    (hP : SolvesMartingaleProblem (External.Draft.svGenerator
      (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i 0)) x P)
    (lam : ℝ) (T : ℝ≥0)
    {R : Measure (Path d)}
    (hR : SolvesMartingaleProblem (External.Draft.svGenerator
      (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i lam)) x R) :
    let Z : Path d → ℝ := fun γ => Real.exp
      (lam * ((γ T) i - x i) - ∫ u in Set.Ioc (0 : ℝ) (T : ℝ),
        (lam * forcedDrift (reducedCoefficient ω) i 0 (γ u.toNNReal) i +
          (lam ^ 2 / 2) * reducedCoefficient ω (γ u.toNNReal) i i))
    ∀ A : Set (Path d), MeasurableSet[(pathFiltration d) T] A →
      R A = ∫⁻ γ in A, ENNReal.ofReal (Z γ) ∂P := by
  intro Z
  let Q := P.withDensity (fun γ => ENNReal.ofReal (Z γ))
  letI : IsProbabilityMeasure Q := u3_reduced_force_tilt_probability hd hΛ hω i hP lam T
  have hstart : ∀ᵐ γ ∂Q, γ 0 = x :=
    (withDensity_absolutelyContinuous P (fun γ => ENNReal.ofReal (Z γ))).ae_le hP.2.1
  obtain ⟨K₀, hmarkov, hK₀⟩ := u5_reduced_textbook_kernel_all_starts hd hΛ i lam
  letI : IsMarkovKernel K₀ := hmarkov
  let K := K₀.comap (fun γ : Path d => (ω, γ T))
    (measurable_const.prodMk (measurable_pathPosition T))
  letI : IsMarkovKernel K := inferInstance
  have hK : ∀ γ, SolvesMartingaleProblem (External.Draft.svGenerator
      (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i lam)) (γ T) (K γ) := by
    intro γ
    exact hK₀ ω hω (γ T)
  have hM : ∀ f : Vec d → ℝ, ContDiff ℝ (⊤ : ℕ∞) f → HasCompactSupport f →
      Martingale (fun v => compensatedTest (External.Draft.svGenerator
        (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i lam)) f (min v T))
          (pathFiltration d) Q := by
    intro f hf hc
    exact u3_reduced_force_tilted_compensated_martingale hd hΛ hω i hP lam T f hf hc
  let S := (Q ⊗ₘ K).map (fun q => u3AppendPaths T q.1 q.2)
  have hS : SolvesMartingaleProblem (External.Draft.svGenerator (reducedCoefficient ω)
      (forcedDrift (reducedCoefficient ω) i lam)) x S :=
    u3_pasted_law_solves hΛ hω i lam T x Q hstart K hK hM
  obtain ⟨W, hW, huniq⟩ := foundation_reduced_textbook_well_posed hd hΛ hω i lam x
  have hSR : S = R := (huniq S hS).trans (huniq R hR).symm
  intro A hA
  calc
    R A = S A := congrArg (fun μ : Measure (Path d) => μ A) hSR.symm
    _ = Q A := u3_pasted_law_apply_past T Q K hA
    _ = ∫⁻ γ in A, ENNReal.ofReal (Z γ) ∂P :=
      withDensity_apply _ ((pathFiltration d).le T A hA)

/-- At zero force, uniqueness identifies the supplied laws and the density is one. -/
theorem u3_reduced_zero_force_finite_horizon_law {d : ℕ} (hd : 1 ≤ d)
    {Λ₀ : ℝ} (hΛ : 0 < Λ₀) {ω : FieldPair d} (hω : IsRegular Λ₀ ω) (i : Fin d)
    {x : Vec d} {P R : Measure (Path d)}
    (hP : SolvesMartingaleProblem (External.Draft.svGenerator
      (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i 0)) x P)
    (hR : SolvesMartingaleProblem (External.Draft.svGenerator
      (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i 0)) x R)
    (T : ℝ≥0) :
    let Z : Path d → ℝ := fun γ => Real.exp
      ((0 : ℝ) * ((γ T) i - x i) - ∫ u in Set.Ioc (0 : ℝ) (T : ℝ),
        ((0 : ℝ) * forcedDrift (reducedCoefficient ω) i 0 (γ u.toNNReal) i +
          ((0 : ℝ) ^ 2 / 2) * reducedCoefficient ω (γ u.toNNReal) i i))
    ∀ A : Set (Path d), R A = ∫⁻ γ in A, ENNReal.ofReal (Z γ) ∂P := by
  dsimp only
  obtain ⟨Q, hQ, huniq⟩ := foundation_reduced_textbook_well_posed hd hΛ hω i 0 x
  have heq : R = P := (huniq R hR).trans (huniq P hP).symm
  intro A
  rw [heq]
  simp

/-- At source time, every signed-force endpoint law is absolutely continuous
with respect to the supplied zero-force endpoint law. -/
theorem u3_reduced_force_marginal_absolutelyContinuous
    {d : ℕ} (hd : 1 ≤ d) {Λ : ℝ} (hΛ : 0 < Λ)
    {ω : FieldPair d} (hω : IsRegular Λ ω) (i : Fin d) (lam : ℝ)
    {x : Vec d} {P R : Measure (Path d)}
    (hP : SolvesMartingaleProblem (External.Draft.svGenerator
      (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i 0)) x P)
    (hR : SolvesMartingaleProblem (External.Draft.svGenerator
      (reducedCoefficient ω) (forcedDrift (reducedCoefficient ω) i lam)) x R)
    (t : ℝ≥0) :
    Measure.map (fun γ : Path d => γ t) R ≪
      Measure.map (fun γ : Path d => γ t) P := by
  let Z : Path d → ℝ := fun γ => Real.exp
    (lam * ((γ t) i - x i) - ∫ u in Set.Ioc (0 : ℝ) (t : ℝ),
      (lam * forcedDrift (reducedCoefficient ω) i 0 (γ u.toNNReal) i +
        (lam ^ 2 / 2) * reducedCoefficient ω (γ u.toNNReal) i i))
  refine Measure.AbsolutelyContinuous.mk ?_
  intro S hS hzero
  have hpast : MeasurableSet[pathFiltration d t] (pathPosition t ⁻¹' S) := by
    exact (Filtration.stronglyAdapted_natural
      (fun s => (measurable_pathPosition (d := d) s).stronglyMeasurable) t).measurable hS
  change (P.map (pathPosition t)) S = 0 at hzero
  change (R.map (pathPosition t)) S = 0
  rw [Measure.map_apply (measurable_pathPosition t) hS] at hzero ⊢
  have heq := u3_reduced_force_finite_horizon_law hd hΛ hω i hP lam t hR _ hpast
  change R (pathPosition t ⁻¹' S) =
    ∫⁻ γ in pathPosition t ⁻¹' S, ENNReal.ofReal (Z γ) ∂P at heq
  rw [← withDensity_apply _ ((pathFiltration d).le t _ hpast)] at heq
  rw [heq]
  exact (withDensity_absolutelyContinuous P (fun γ => ENNReal.ofReal (Z γ))) hzero

