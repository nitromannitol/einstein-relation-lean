import EinsteinFull.Homogenization.HighContrastCarrier
import Homogenization.Probability.RegCoeffField.EllipticSet

/-!
# Measurability of the uniform ellipticity event on the high-contrast coefficient space

The coefficient space of Armstrong, Kuusi and Loher, *Homogenization at a polynomial scale in
high contrast*, carries the sigma algebra generated by smooth test pairings. Smoothed matrix
entries, recentred at every point and averaged over shrinking normalized bumps, are jointly
measurable in the coefficient and the point; by Lebesgue differentiation their limit superior is
a representative of the coefficient field. Hence the event that the coefficient field is
uniformly elliptic almost everywhere, with given constants, is measurable, and the pushforward of
a source law of Armstrong, Kuusi and Mourrat, *Quantitative Stochastic Homogenization and
Large-Scale Regularity*, is supported on `(1, K)`-elliptic fields.
-/

open MeasureTheory Filter Topology

namespace EinsteinFull.Homogenization

open EinsteinRelation EinsteinRelation.Environment.AKMTestIntegralSupport
  EinsteinRelation.External.AKM
open _root_.Homogenization.HighContrast

variable {d : ℕ}

theorem locallyIntegrable_coeffSpace_entry (b : CoeffSpace d) (i j : Fin d) :
    LocallyIntegrable (fun x => b.1 x i j) volume := by
  rw [locallyIntegrable_iff]
  intro k hk
  obtain ⟨M, hM0, hM⟩ :=
    ae_abs_entry_le_of_aeUniformlyEllipticField b.2 hk.isBounded
  have hentry : AEStronglyMeasurable (fun x => b.1 x i j) volume :=
    (continuous_id.matrix_elem i j).comp_aestronglyMeasurable b.1.aestronglyMeasurable
  refine Integrable.mono' (integrableOn_const (C := M) hk.measure_lt_top.ne) hentry.restrict ?_
  filter_upwards [ae_restrict_of_ae hM, ae_restrict_mem hk.measurableSet] with x hx hxk
  simpa [Real.norm_eq_abs] using hx hxk i j

/-- A smoothed matrix entry of a high-contrast coefficient around the point `x`. -/
noncomputable def coeffSpaceObservation (n : ℕ) (i j : Fin d) (b : CoeffSpace d)
    (x : Vec d) : ℝ :=
  ∫ y, (representativeBump d n).normed volume (x - y) * b.1 y i j

theorem coeffSpaceObservation_eq_coeffPairing (n : ℕ) (i j : Fin d) (b : CoeffSpace d)
    (x : Vec d) :
    coeffSpaceObservation n i j b x =
      coeffPairing (Pi.single j 1) (Pi.single i 1)
        (fun y => (representativeBump d n).normed volume (x - y)) b := by
  unfold coeffSpaceObservation coeffPairing
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  simp only [_root_.Homogenization.vecDot, _root_.Homogenization.matVecMul, Pi.single_apply,
    mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ite_true, ite_mul, one_mul,
    zero_mul]
  ring

theorem measurable_coeffPairing (e e' : Vec d) {φ : Vec d → ℝ}
    (hφ : IsLocalTest (Set.univ : Set (Vec d)) φ) :
    Measurable (coeffPairing e e' φ) := by
  intro t ht
  exact MeasurableSpace.measurableSet_generateFrom ⟨e, e', φ, hφ, t, ht, rfl⟩

theorem continuous_coeffSpaceObservation (n : ℕ) (i j : Fin d) (b : CoeffSpace d) :
    Continuous (coeffSpaceObservation n i j b) := by
  have h := ((representativeBump d n).hasCompactSupport_normed (μ := volume)).continuous_convolution_left
    (ContinuousLinearMap.lsmul ℝ ℝ) ((representativeBump d n).continuous_normed (μ := volume))
    (locallyIntegrable_coeffSpace_entry b i j)
  convert h using 1
  funext x
  exact (convolution_lsmul_swap (μ := (volume : Measure (Vec d)))
    (f := (representativeBump d n).normed volume)
    (g := fun y => b.1 y i j) (x := x)).symm

theorem measurable_coeffSpaceObservation_apply (n : ℕ) (i j : Fin d) (x : Vec d) :
    Measurable (fun b : CoeffSpace d => coeffSpaceObservation n i j b x) := by
  have hfun : (fun b : CoeffSpace d => coeffSpaceObservation n i j b x) =
      coeffPairing (Pi.single j 1) (Pi.single i 1)
        (fun y => (representativeBump d n).normed volume (x - y)) :=
    funext fun b => coeffSpaceObservation_eq_coeffPairing n i j b x
  rw [hfun]
  exact measurable_coeffPairing _ _ ⟨
    (representativeBump d n).contDiff_normed.comp (contDiff_const.sub contDiff_id),
    (representativeBump d n).hasCompactSupport_normed.comp_homeomorph (Homeomorph.subLeft x),
    Set.subset_univ _⟩

set_option maxHeartbeats 400000 in
theorem measurable_coeffSpaceObservation (n : ℕ) (i j : Fin d) :
    Measurable (fun p : CoeffSpace d × Vec d => coeffSpaceObservation n i j p.1 p.2) := by
  have hm : Measurable (Function.uncurry
      (fun (x : Vec d) (b : CoeffSpace d) => coeffSpaceObservation n i j b x)) :=
    measurable_uncurry_of_continuous_of_measurable
      (fun b => continuous_coeffSpaceObservation n i j b)
      (fun x => measurable_coeffSpaceObservation_apply n i j x)
  exact hm.comp measurable_swap

theorem ae_tendsto_coeffSpaceObservation (b : CoeffSpace d) (i j : Fin d) :
    ∀ᵐ x ∂(volume : Measure (Vec d)),
      Tendsto (fun n => coeffSpaceObservation n i j b x) atTop (𝓝 (b.1 x i j)) := by
  have hratio : ∀ᶠ n : ℕ in atTop,
      (representativeBump d n).rOut ≤ (2 : ℝ) * (representativeBump d n).rIn := by
    filter_upwards with n
    dsimp only [representativeBump]
    linarith
  have h := ContDiffBump.ae_convolution_tendsto_right_of_locallyIntegrable
    (μ := (volume : Measure (Vec d))) (φ := representativeBump d)
    tendsto_one_div_add_atTop_nhds_zero_nat hratio (locallyIntegrable_coeffSpace_entry b i j)
  simpa only [convolution_eq_swap, ContinuousLinearMap.lsmul_apply, smul_eq_mul,
    coeffSpaceObservation] using h

/-- A jointly measurable representative of a high-contrast coefficient field. -/
noncomputable def coeffSpaceRepresentative (b : CoeffSpace d) (x : Vec d) : Mat d :=
  fun i j => limsup (fun n => coeffSpaceObservation n i j b x) atTop

theorem measurable_coeffSpaceRepresentative :
    Measurable (fun p : CoeffSpace d × Vec d => coeffSpaceRepresentative p.1 p.2) := by
  refine measurable_pi_iff.mpr fun i => measurable_pi_iff.mpr fun j => ?_
  exact Measurable.limsup (fun n => measurable_coeffSpaceObservation n i j)

theorem coeffSpaceRepresentative_ae_eq (b : CoeffSpace d) :
    coeffSpaceRepresentative b =ᵐ[volume] (b.1 : Vec d → Mat d) := by
  have h := ae_all_iff.mpr (fun i => ae_all_iff.mpr
    (fun j => ae_tendsto_coeffSpaceObservation b i j))
  filter_upwards [h] with x hx
  funext i j
  exact (hx i j).limsup_eq

/-- The event of almost-everywhere `(λ, Λ)`-ellipticity is measurable. -/
theorem measurableSet_ae_isEllipticMatrix (lam Lam : ℝ) :
    MeasurableSet {b : CoeffSpace d |
      ∀ᵐ x ∂(volume : Measure (Vec d)),
        _root_.Homogenization.IsEllipticMatrix lam Lam (b.1 x)} := by
  have hS : MeasurableSet {p : CoeffSpace d × Vec d |
      ¬ _root_.Homogenization.IsEllipticMatrix lam Lam (coeffSpaceRepresentative p.1 p.2)} :=
    (measurable_coeffSpaceRepresentative
      (_root_.Homogenization.measurableSet_isEllipticMatrix (d := d) (lam := lam)
        (Lam := Lam))).compl
  have hmeas := measurable_measure_prodMk_left (ν := (volume : Measure (Vec d))) hS
  have hset : {b : CoeffSpace d |
      ∀ᵐ x ∂(volume : Measure (Vec d)),
        _root_.Homogenization.IsEllipticMatrix lam Lam (b.1 x)} =
      (fun b => volume (Prod.mk b ⁻¹' {p : CoeffSpace d × Vec d |
        ¬ _root_.Homogenization.IsEllipticMatrix lam Lam
          (coeffSpaceRepresentative p.1 p.2)})) ⁻¹' {0} := by
    ext b
    simp only [Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_singleton_iff, Set.preimage_ofPred_eq]
    rw [← ae_iff]
    constructor
    · intro h
      filter_upwards [h, coeffSpaceRepresentative_ae_eq b] with x hx hrep
      rwa [hrep]
    · intro h
      filter_upwards [h, coeffSpaceRepresentative_ae_eq b] with x hx hrep
      rwa [← hrep]
  rw [hset]
  exact hmeas (measurableSet_singleton 0)

/-- The pushforward of a source law is supported on `(1, K)`-elliptic fields. -/
theorem ae_isEllipticMatrix_map_toHighContrast {K : ℝ} (hK : 1 ≤ K)
    {P : Measure (Coefficient d K)} :
    ∀ᵐ b ∂(P.map (toHighContrast hK)),
      ∀ᵐ x ∂(volume : Measure (Vec d)),
        _root_.Homogenization.IsEllipticMatrix 1 K (b.1 x) := by
  rw [ae_map_iff (measurable_toHighContrast hK).aemeasurable
    (measurableSet_ae_isEllipticMatrix 1 K)]
  exact Filter.Eventually.of_forall fun a => ae_isEllipticMatrix_toHighContrast hK a

end EinsteinFull.Homogenization
