import EinsteinFull.WhiteNoise.BoxKernel
import EinsteinFull.WhiteNoise.GaussianSeries
import EinsteinFull.External.Draft.AKMWhiteNoiseExistence

/-!
# Existence of scalar white noise

Armstrong–Kuusi–Mourrat, *Quantitative Stochastic Homogenization and Large-Scale Regularity*,
Proposition 5.14, in the form `EinsteinRelation.External.WhiteNoiseExistence d`: for every `d` there
is a probability measure on the distributions on `Fin d → ℝ`, with the σ-algebra generated by the
evaluations at test functions, whose characteristic functional is `exp (-(1 / 2) * r ^ 2 * ∫ f ^ 2)`
(`whiteNoiseExistence`, `akmWhiteNoiseExistence`).

Construction. Let `b` be a Hilbert basis of `L²(Fin d → ℝ)` and `ξ` an independent family of
standard Gaussians indexed by it. The coefficients `kernelCoeff b k x = ⟪b k, boxKernel x⟫` satisfy
`∑ k, kernelCoeff b k x ^ 2 = ∏ i, |x i|`, so the Brownian sheet `G = ∑ k, ξ k • kernelCoeff b k`
converges in `L²(Ω; L²(weightMeasure d))`. The random distribution is
`W ω f = ⟪G ω, mixedDeriv d f * invWeight⟫`, a continuous linear functional of `f` for every `ω`.
By Fubini and the box-kernel fundamental theorem of calculus,
`⟪mixedDeriv d f * invWeight, kernelCoeff b k⟫ = (-1) ^ d * ⟪b k, f⟫`, so `W f` is a centred
Gaussian with variance `∑ k, ⟪b k, f⟫ ^ 2 = ∫ f ^ 2`.
-/

open MeasureTheory ProbabilityTheory Set Filter Topology
open EinsteinRelation.External EinsteinRelation.Sharpness
open scoped InnerProductSpace RealInnerProductSpace ENNReal NNReal

noncomputable section

namespace EinsteinFull.WhiteNoise

section Assembly

open scoped ContDiff

variable {d : ℕ}

lemma inner_real_eq (a b : ℝ) : ⟪a, b⟫ = a * b := by
  rw [real_inner_eq_re_inner, RCLike.inner_apply, conj_trivial, RCLike.re_to_real]
  ring

lemma abs_le_of_boxSign_ne_zero {t a : ℝ} (h : boxSign t a ≠ 0) : |t| ≤ |a| := by
  unfold boxSign at h
  by_cases h1 : t ≤ a <;> by_cases h2 : t ≤ 0 <;> simp only [h1, h2, ↓reduceIte] at h
  · norm_num at h
  · have h3 : 0 < t := lt_of_not_ge h2
    rw [abs_of_pos h3, abs_of_pos (h3.trans_le h1)]
    exact h1
  · have h3 : a < t := lt_of_not_ge h1
    rw [abs_of_nonpos h2, abs_of_neg (h3.trans_le h2)]
    linarith
  · norm_num at h

lemma norm_le_of_boxKernel_ne_zero {x y : Fin d → ℝ} (h : boxKernel x y ≠ 0) : ‖y‖ ≤ ‖x‖ := by
  refine (pi_norm_le_iff_of_nonneg (norm_nonneg x)).2 fun i => ?_
  have hi : boxSign (y i) (x i) ≠ 0 := fun h0 => h (Finset.prod_eq_zero (Finset.mem_univ i) h0)
  rw [Real.norm_eq_abs]
  exact (abs_le_of_boxSign_ne_zero hi).trans (by rw [← Real.norm_eq_abs]; exact norm_le_pi_norm x i)

lemma abs_boxKernel_le (x y : Fin d → ℝ) : |boxKernel x y| ≤ 1 := by
  rw [boxKernel, Finset.abs_prod]
  exact Finset.prod_le_one₀ (fun _ _ => abs_nonneg _) (fun _ _ => abs_boxSign_le _ _)

section Basis

variable {ι : Type*} (b : HilbertBasis ι ℝ (Lp ℝ 2 (volume : Measure (Fin d → ℝ))))

lemma memLp_kernelCoeff (k : ι) : MemLp (kernelCoeff b k) 2 (weightMeasure d) := by
  refine (memLp_two_iff_integrable_sq (measurable_kernelCoeff b k).aestronglyMeasurable).2 ?_
  refine integrable_prod_abs_weightMeasure.mono'
    ((measurable_kernelCoeff b k).pow_const 2).aestronglyMeasurable (ae_of_all _ fun x => ?_)
  rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
  exact kernelCoeff_sq_le b k x

/-- `kernelCoeff b k` as an element of `L²(weightMeasure d)`. -/
def kernelCoeffL (k : ι) : Lp ℝ 2 (weightMeasure d) := (memLp_kernelCoeff b k).toLp _

lemma norm_kernelCoeffL_sq (k : ι) :
    ‖kernelCoeffL b k‖ ^ 2 = ∫ x, kernelCoeff b k x ^ 2 ∂(weightMeasure d) := by
  rw [← real_inner_self_eq_norm_sq, L2.inner_def]
  refine integral_congr_ae ?_
  filter_upwards [(memLp_kernelCoeff b k).coeFn_toLp] with x h
  rw [kernelCoeffL, h, inner_real_eq, sq]

lemma summable_norm_kernelCoeffL_sq : Summable fun k => ‖kernelCoeffL b k‖ ^ 2 := by
  refine summable_of_sum_le (c := ∫ x, ∏ i, |x i| ∂(weightMeasure d))
    (fun k => sq_nonneg _) (fun s => ?_)
  simp_rw [norm_kernelCoeffL_sq]
  rw [← integral_finsetSum _ (fun k _ => (memLp_kernelCoeff b k).integrable_sq)]
  refine integral_mono (integrable_finsetSum _ fun k _ => (memLp_kernelCoeff b k).integrable_sq)
    integrable_prod_abs_weightMeasure (fun x => ?_)
  exact sum_le_hasSum s (fun _ _ => sq_nonneg _) (hasSum_kernelCoeff_sq b x)

lemma integral_kernelCoeff_mul_mixedDeriv (k : ι) {g : (Fin d → ℝ) → ℝ} (hg : ContDiff ℝ ∞ g)
    (hgc : HasCompactSupport g) :
    ∫ x, kernelCoeff b k x * mixedDeriv d g x =
      (-1) ^ d * ∫ y, (b k : (Fin d → ℝ) → ℝ) y * g y := by
  set Dg := mixedDeriv d g with hDg
  have hDc : Continuous Dg := (contDiff_foldr_pderiv _ hg).continuous
  have hDs : HasCompactSupport Dg := hasCompactSupport_foldr_pderiv _ hgc
  obtain ⟨R, hR⟩ := hDs.isCompact.isBounded.subset_closedBall 0
  set B := Metric.closedBall (0 : Fin d → ℝ) R with hB
  set bk : (Fin d → ℝ) → ℝ := (b k : (Fin d → ℝ) → ℝ) with hbk
  have hbkB : Integrable (B.indicator bk) := by
    have : IsFiniteMeasure ((volume : Measure (Fin d → ℝ)).restrict B) :=
      isFiniteMeasure_restrict.2 measure_closedBall_lt_top.ne
    exact (integrable_indicator_iff measurableSet_closedBall).2
      (((Lp.memLp (b k)).restrict B).integrable one_le_two)
  have hint : Integrable (Function.uncurry fun x y => Dg x * (bk y * boxKernel x y))
      ((volume : Measure (Fin d → ℝ)).prod volume) := by
    refine ((hDc.integrable_of_hasCompactSupport hDs).norm.mul_prod hbkB.norm).mono' ?_
      (ae_of_all _ fun p => ?_)
    · exact (hDc.measurable.comp measurable_fst).aestronglyMeasurable.mul
        ((((Lp.stronglyMeasurable (b k)).comp_measurable measurable_snd).aestronglyMeasurable).mul
          measurable_boxKernel.aestronglyMeasurable)
    · obtain ⟨x, y⟩ := p
      simp only [Function.uncurry_apply_pair, norm_mul, Real.norm_eq_abs]
      by_cases hx : Dg x = 0
      · simp [hx]
      by_cases hk : boxKernel x y = 0
      · simp only [hk, abs_zero, mul_zero]
        positivity
      have hxB : x ∈ B := hR (subset_tsupport _ hx)
      have hyB : y ∈ B := by
        simp only [hB, Metric.mem_closedBall, dist_zero_right] at hxB ⊢
        exact (norm_le_of_boxKernel_ne_zero hk).trans hxB
      rw [Set.indicator_of_mem hyB]
      gcongr
      calc |bk y| * |boxKernel x y| ≤ |bk y| * 1 := by gcongr; exact abs_boxKernel_le x y
        _ = |bk y| := mul_one _
  have h1 : ∀ x, kernelCoeff b k x * Dg x = ∫ y, Dg x * (bk y * boxKernel x y) := by
    intro x
    rw [kernelCoeff_eq_integral, ← integral_mul_const]
    congr 1
    funext y
    ring
  simp_rw [h1]
  rw [integral_integral_swap hint]
  have h2 : ∀ y, ∫ x, Dg x * (bk y * boxKernel x y) = bk y * ((-1) ^ d * g y) := by
    intro y
    rw [← integral_prod_boxSign_mul_mixedDeriv d g hg hgc y, ← integral_const_mul]
    congr 1
    funext x
    simp only [boxKernel, hDg]
    ring
  simp_rw [h2]
  rw [← integral_const_mul]
  congr 1
  funext y
  ring

end Basis

/-- The derivative along the `i`-th coordinate vector, as a continuous linear map. -/
def coordLineDeriv (i : Fin d) : NoiseTest d →L[ℝ] NoiseTest d :=
  TestFunction.lineDerivCLM ℝ (Pi.single i (1 : ℝ))

/-- Iterated coordinate derivatives along a list of coordinates. -/
def foldrLineDeriv (l : List (Fin d)) : NoiseTest d →L[ℝ] NoiseTest d :=
  l.foldr (fun i A => (coordLineDeriv i).comp A) (ContinuousLinearMap.id ℝ (NoiseTest d))

lemma coe_foldrLineDeriv (l : List (Fin d)) (f : NoiseTest d) :
    ⇑(foldrLineDeriv l f) = l.foldr pderiv ⇑f := by
  induction l with
  | nil => rfl
  | cons i l ih =>
    funext x
    have h : foldrLineDeriv (i :: l) f = coordLineDeriv i (foldrLineDeriv l f) := rfl
    rw [h, coordLineDeriv, TestFunction.lineDerivCLM_apply, List.foldr_cons, ← ih]
    simp only [le_top, ↓reduceIte]
    exact ((foldrLineDeriv l f).contDiff.differentiable (by simp) x).lineDeriv_eq_fderiv

/-- The mixed derivative `∂₀ ⋯ ∂_{d-1}` on test functions. -/
def mixedDerivCLM (d : ℕ) : NoiseTest d →L[ℝ] NoiseTest d := foldrLineDeriv (List.finRange d)

lemma coe_mixedDerivCLM (f : NoiseTest d) : ⇑(mixedDerivCLM d f) = mixedDeriv d f :=
  coe_foldrLineDeriv _ f

lemma contDiff_invWeight : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (invWeight (d := d)) := by
  unfold invWeight
  fun_prop

/-- Multiplication by `invWeight` on test functions. -/
def invWeightCLM (d : ℕ) : NoiseTest d →L[ℝ] NoiseTest d :=
  TestFunction.bilinLeftCLM (ContinuousLinearMap.mul ℝ ℝ) contDiff_invWeight

/-- The continuous linear map `f ↦ (∂₀ ⋯ ∂_{d-1} f) · invWeight` into `L²(weightMeasure d)`. -/
def testMap (d : ℕ) : NoiseTest d →L[ℝ] Lp ℝ 2 (weightMeasure d) :=
  (BoundedContinuousFunction.toLp (E := ℝ) 2 (weightMeasure d) ℝ).comp
    ((TestFunction.toBoundedContinuousFunctionCLM ℝ).comp ((invWeightCLM d).comp (mixedDerivCLM d)))

lemma coeFn_testMap (f : NoiseTest d) :
    testMap d f =ᵐ[weightMeasure d] fun x => mixedDeriv d f x * invWeight x := by
  filter_upwards [BoundedContinuousFunction.coeFn_toLp (E := ℝ) (p := 2) (μ := weightMeasure d) ℝ
    (TestFunction.toBoundedContinuousFunctionCLM ℝ (invWeightCLM d (mixedDerivCLM d f)))] with x hx
  rw [testMap, ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.comp_apply, hx, TestFunction.toBoundedContinuousFunctionCLM_apply]
  simp [invWeightCLM, coe_mixedDerivCLM]

lemma memLp_testFunction (f : NoiseTest d) : MemLp (⇑f) 2 (volume : Measure (Fin d → ℝ)) :=
  f.continuous.memLp_of_hasCompactSupport f.hasCompactSupport

/-- A test function as an element of `L²`. -/
def testL2 (f : NoiseTest d) : Lp ℝ 2 (volume : Measure (Fin d → ℝ)) :=
  (memLp_testFunction f).toLp _

lemma norm_testL2_sq (f : NoiseTest d) : ‖testL2 f‖ ^ 2 = ∫ y, f y ^ 2 := by
  rw [← real_inner_self_eq_norm_sq, L2.inner_def]
  refine integral_congr_ae ?_
  filter_upwards [(memLp_testFunction f).coeFn_toLp] with y h
  rw [testL2, h, inner_real_eq, sq]

section Basis2

variable {ι : Type*} (b : HilbertBasis ι ℝ (Lp ℝ 2 (volume : Measure (Fin d → ℝ))))

lemma inner_testMap_kernelCoeffL (f : NoiseTest d) (k : ι) :
    ⟪testMap d f, kernelCoeffL b k⟫ = (-1) ^ d * ⟪b k, testL2 f⟫ := by
  have hL : ⟪b k, testL2 f⟫ = ∫ y, (b k : (Fin d → ℝ) → ℝ) y * f y := by
    rw [L2.inner_def]
    refine integral_congr_ae ?_
    filter_upwards [(memLp_testFunction f).coeFn_toLp] with y h
    rw [testL2, h, inner_real_eq]
  rw [hL, ← integral_kernelCoeff_mul_mixedDeriv b k f.contDiff f.hasCompactSupport, L2.inner_def]
  have h1 : (fun x => ⟪(testMap d f : (Fin d → ℝ) → ℝ) x, (kernelCoeffL b k : (Fin d → ℝ) → ℝ) x⟫)
      =ᵐ[weightMeasure d] fun x => (mixedDeriv d f x * invWeight x) * kernelCoeff b k x := by
    filter_upwards [coeFn_testMap f, (memLp_kernelCoeff b k).coeFn_toLp] with x h1 h2
    rw [h1, kernelCoeffL, h2, inner_real_eq]
  rw [integral_congr_ae h1, weightMeasure,
    integral_withDensity_eq_integral_smul measurable_gaussWeight]
  congr 1
  funext x
  rw [NNReal.smul_def, smul_eq_mul]
  have := gaussWeight_mul_invWeight x
  calc (gaussWeight x : ℝ) * (mixedDeriv d f x * invWeight x * kernelCoeff b k x)
      = ((gaussWeight x : ℝ) * invWeight x) * (kernelCoeff b k x * mixedDeriv d f x) := by ring
    _ = kernelCoeff b k x * mixedDeriv d f x := by rw [this, one_mul]

lemma hasSum_inner_testMap_sq (f : NoiseTest d) :
    HasSum (fun k => ⟪testMap d f, kernelCoeffL b k⟫ ^ 2) (∫ y, f y ^ 2) := by
  have h := b.hasSum_inner_mul_inner (testL2 f) (testL2 f)
  rw [real_inner_self_eq_norm_sq, norm_testL2_sq] at h
  convert h using 2 with k
  rw [inner_testMap_kernelCoeffL, mul_pow, ← pow_mul, mul_comm d 2, pow_mul, neg_one_sq, one_pow,
    one_mul, sq, real_inner_comm]

end Basis2

end Assembly


section Statement

/-- Evaluation at a test function is measurable for the evaluation σ-algebra. -/
lemma measurable_noiseSample_eval {d : ℕ} (f : NoiseTest d) :
    Measurable fun W : NoiseSample d => W f :=
  measurable_iff_comap_le.2 (le_iSup_of_le (α := MeasurableSpace (NoiseSample d)) f le_rfl)

/-- Existence of unit scalar white noise on `Fin d → ℝ` (Armstrong–Kuusi–Mourrat, Proposition 5.14),
for every dimension `d`. -/
theorem whiteNoiseExistence (d : ℕ) : WhiteNoiseExistence d := by
  obtain ⟨w, b, -⟩ := exists_hilbertBasis ℝ (Lp ℝ 2 (volume : Measure (Fin d → ℝ)))
  set G : Lp (Lp ℝ 2 (weightMeasure d)) 2 (gaussSeq w) := ∑' k, coordSMul k (kernelCoeffL b k)
    with hG
  let W : (w → ℝ) → NoiseSample d := fun ω => (innerSL ℝ (G ω)).comp (testMap d)
  have hWf : ∀ f : NoiseTest d, Measurable fun ω => W ω f := by
    intro f
    have h : (fun ω => W ω f) = fun ω => innerSL ℝ (testMap d f) (G ω) := by
      funext ω
      change ⟪G ω, testMap d f⟫ = ⟪testMap d f, G ω⟫
      exact real_inner_comm _ _
    rw [h]
    exact ((innerSL ℝ (testMap d f)).continuous.comp_stronglyMeasurable
      (Lp.stronglyMeasurable G)).measurable
  have hW : Measurable W := by
    rw [measurable_iff_comap_le]
    change MeasurableSpace.comap W (noiseSigma d) ≤ _
    rw [noiseSigma, MeasurableSpace.comap_iSup, iSup_le_iff]
    intro f
    rw [MeasurableSpace.comap_comp]
    exact (hWf f).comap_le
  refine ⟨(gaussSeq w).map W,
    (Measure.isProbabilityMeasure_map_iff hW.aemeasurable).2 inferInstance, fun f r => ?_⟩
  rw [integral_map hW.aemeasurable
    ((by fun_prop : Continuous fun t : ℝ => Complex.exp (Complex.I * r * (t : ℂ))
      ).comp_aestronglyMeasurable
      (measurable_noiseSample_eval f).aestronglyMeasurable)]
  have key := integral_cexp_inner_tsum (fun k => kernelCoeffL b k)
    (summable_norm_kernelCoeffL_sq b) (testMap d f) _ (hasSum_inner_testMap_sq b f) r
  convert key using 1
  · refine integral_congr_ae (ae_of_all _ fun ω => ?_)
    change Complex.exp (Complex.I * r * ((⟪G ω, testMap d f⟫ : ℝ) : ℂ)) = _
    rw [real_inner_comm]
  · push_cast
    ring_nf

/-- Armstrong–Kuusi–Mourrat, Proposition 5.14, in the form of the statement of
`EinsteinFull.External.akm_white_noise_exists`. -/
theorem akmWhiteNoiseExistence : EinsteinFull.External.Draft.akmWhiteNoiseExistenceStmt :=
  fun d _ => whiteNoiseExistence d

end Statement

end EinsteinFull.WhiteNoise
