/-!
# Bass source objects for the continuous elliptic martingale problem

Draft source transcription for Bass, *Diffusions and Elliptic Operators*, V.1,
VI.1 and VI.4.3. These are definitions and proved transport lemmas only.
The proposed literature theorem type at the end is elaborated for review; no
literature theorem is declared or assumed here. Direct source review is pending.

The source path carrier has the cylindrical sigma algebra by definition. The
measurable equivalence with the existing compact-open Borel path carrier is
proved below. Tests are all C² functions, with local martingales for the right
continuation of the natural filtration. Stopped integrability is explicit.
-/

open MeasureTheory ProbabilityTheory
open scoped BigOperators Topology NNReal

namespace EinsteinFull.External.Bass

open EinsteinRelation

/-- Source continuous paths, before equipping them with the cylindrical sigma algebra.
A separate carrier prevents the frozen path carrier's Borel instance from silently
choosing the source sigma algebra. -/
structure Path (d : ℕ) where
  /-- The continuous map represented by a source canonical path. -/
  toContinuousMap : C(ℝ≥0, Vec d)

instance {d : ℕ} : CoeFun (Path d) (fun _ => ℝ≥0 → Vec d) :=
  ⟨fun γ => γ.toContinuousMap⟩

/-- The source sigma algebra is generated by all coordinate evaluations. -/
instance (d : ℕ) : MeasurableSpace (Path d) :=
  ⨆ t : ℝ≥0, (inferInstance : MeasurableSpace (Vec d)).comap (fun γ : Path d => γ t)

/-- The cylindrical sigma algebra is literally generated by Borel evaluations. -/
theorem measurableSpace_eq_iSup_comap_borel (d : ℕ) :
    (inferInstance : MeasurableSpace (Path d)) =
      ⨆ t : ℝ≥0, (borel (Vec d)).comap (fun γ : Path d => γ t) := by
  change (⨆ t : ℝ≥0, (inferInstance : MeasurableSpace (Vec d)).comap
    (fun γ : Path d => γ t)) = _
  rw [BorelSpace.measurable_eq (α := Vec d)]

/-- A source path is continuous in nonnegative real time. -/
theorem Path.continuous {d : ℕ} (γ : Path d) : Continuous (fun t => γ t) :=
  γ.toContinuousMap.continuous

/-- Every coordinate evaluation is measurable for the cylindrical sigma algebra. -/
theorem measurable_eval {d : ℕ} (t : ℝ≥0) :
    Measurable (fun γ : Path d => γ t) := by
  apply measurable_iff_comap_le.mpr
  exact le_iSup (fun s : ℝ≥0 => (inferInstance : MeasurableSpace (Vec d)).comap
    (fun γ : Path d => γ s)) t

/-- A map into the source carrier is measurable exactly when each evaluation is. -/
theorem measurable_iff_eval {d : ℕ} {Ω : Type*} [MeasurableSpace Ω]
    {g : Ω → Path d} : Measurable g ↔ ∀ t : ℝ≥0, Measurable (fun ω => g ω t) := by
  simp only [measurable_iff_comap_le]
  change MeasurableSpace.comap g
    (⨆ t : ℝ≥0, (inferInstance : MeasurableSpace (Vec d)).comap
      (fun γ : Path d => γ t)) ≤ _ ↔ _
  simp only [MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp,
    iSup_le_iff, measurable_iff_comap_le, Function.comp_def]

/-- The underlying continuous map is measurable into the frozen Borel carrier.
This uses the theorem identifying compact-open Borel and evaluation sigma algebras. -/
theorem measurable_toContinuousMap {d : ℕ} :
    Measurable (Path.toContinuousMap : Path d → EinsteinRelation.Path d) :=
  ContinuousMap.measurable_iff_eval.mpr measurable_eval

/-- Wrapping a frozen path gives a measurable map into the cylindrical carrier. -/
theorem measurable_mk {d : ℕ} :
    Measurable (Path.mk : EinsteinRelation.Path d → Path d) :=
  measurable_iff_eval.mpr fun t => EinsteinRelation.measurable_pathPosition t

/-- Source cylindrical paths and frozen Borel paths are measurably equivalent,
without completing either sigma algebra. -/
def pathMeasurableEquiv (d : ℕ) : Path d ≃ᵐ EinsteinRelation.Path d where
  toFun := Path.toContinuousMap
  invFun := Path.mk
  left_inv γ := by cases γ; rfl
  right_inv γ := rfl
  measurable_toFun := measurable_toContinuousMap
  measurable_invFun := measurable_mk

@[simp] theorem pathMeasurableEquiv_apply {d : ℕ} (γ : Path d) (t : ℝ≥0) :
    pathMeasurableEquiv d γ t = γ t := rfl

@[simp] theorem pathMeasurableEquiv_symm_apply {d : ℕ}
    (γ : EinsteinRelation.Path d) (t : ℝ≥0) :
    (pathMeasurableEquiv d).symm γ t = γ t := rfl

/-- Pushing a source law to frozen paths and back recovers the identical law. -/
theorem map_pathMeasurableEquiv_roundtrip {d : ℕ} (P : Measure (Path d)) :
    (P.map (pathMeasurableEquiv d)).map (pathMeasurableEquiv d).symm = P :=
  (pathMeasurableEquiv d).map_symm_map

/-- Pushing a frozen law to source paths and back recovers the identical law. -/
theorem map_pathMeasurableEquiv_symm_roundtrip {d : ℕ}
    (P : Measure (EinsteinRelation.Path d)) :
    (P.map (pathMeasurableEquiv d).symm).map (pathMeasurableEquiv d) = P :=
  (pathMeasurableEquiv d).map_map_symm

/-- Equality of pushed laws is equivalent to equality of source laws. -/
theorem map_pathMeasurableEquiv_injective (d : ℕ) :
    Function.Injective (Measure.map (pathMeasurableEquiv d)) :=
  (pathMeasurableEquiv d).map_measurableEquiv_injective

/-- The raw coordinate filtration on source cylindrical paths. -/
noncomputable def rawFiltration (d : ℕ) :
    Filtration ℝ≥0 (inferInstance : MeasurableSpace (Path d)) :=
  Filtration.natural (fun t (γ : Path d) => γ t)
    (fun t => (measurable_eval t).stronglyMeasurable)

/-- The source raw sigma algebra is exactly the pullback of the frozen raw one. -/
theorem rawFiltration_eq_comap {d : ℕ} (t : ℝ≥0) :
    rawFiltration d t = (EinsteinRelation.pathFiltration d t).comap
      (Path.toContinuousMap : Path d → EinsteinRelation.Path d) := by
  simp only [rawFiltration, EinsteinRelation.pathFiltration, Filtration.natural,
    MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
  rfl

/-- Bass's right-continuous canonical filtration, without probability completion. -/
noncomputable def filtration (d : ℕ) :
    Filtration ℝ≥0 (inferInstance : MeasurableSpace (Path d)) :=
  (rawFiltration d).rightCont

/-- The source filtration is right continuous by construction. -/
instance (d : ℕ) : (filtration d).IsRightContinuous := by
  unfold filtration
  infer_instance

/-- The raw filtration is contained in the source right-continuous filtration. -/
theorem rawFiltration_le_filtration (d : ℕ) : rawFiltration d ≤ filtration d :=
  (rawFiltration d).le_rightCont

/-- A true source martingale whose transported process is raw adapted remains a
martingale under the pushed law and the frozen raw filtration. -/
theorem martingale_map_pathMeasurableEquiv {d : ℕ} {P : Measure (Path d)}
    [IsFiniteMeasure P] {M : ℝ≥0 → EinsteinRelation.Path d → ℝ}
    (hM : Martingale (fun t γ => M t (pathMeasurableEquiv d γ)) (filtration d) P)
    (hadapted : StronglyAdapted (EinsteinRelation.pathFiltration d) M) :
    Martingale M (EinsteinRelation.pathFiltration d) (P.map (pathMeasurableEquiv d)) := by
  have hint (t : ℝ≥0) : Integrable (M t) (P.map (pathMeasurableEquiv d)) :=
    (integrable_map_equiv (pathMeasurableEquiv d) (M t)).mpr (hM.integrable t)
  refine ⟨hadapted, fun s t hst => ?_⟩
  symm
  refine ae_eq_condExp_of_forall_setIntegral_eq ((EinsteinRelation.pathFiltration d).le s)
    (hint t) (fun _ _ _ => (hint s).integrableOn) (fun A hA _ => ?_)
    (hadapted s).aestronglyMeasurable
  have hmeas : Measurable[rawFiltration d s, EinsteinRelation.pathFiltration d s]
      (pathMeasurableEquiv d) := by
    apply measurable_iff_comap_le.mpr
    change MeasurableSpace.comap Path.toContinuousMap
      (EinsteinRelation.pathFiltration d s) ≤ rawFiltration d s
    rw [rawFiltration_eq_comap]
  have hpre : MeasurableSet[filtration d s] ((pathMeasurableEquiv d) ⁻¹' A) :=
    (rawFiltration_le_filtration d s) _ (hA.preimage hmeas)
  simpa only [setIntegral_map_equiv] using hM.setIntegral_eq hst hpre

/-- A frozen raw martingale pulls back to the source raw filtration under the
inverse measurable path equivalence. -/
theorem martingale_map_pathMeasurableEquiv_symm {d : ℕ}
    {P : Measure (EinsteinRelation.Path d)} [IsFiniteMeasure P]
    {M : ℝ≥0 → EinsteinRelation.Path d → ℝ}
    (hM : Martingale M (EinsteinRelation.pathFiltration d) P) :
    Martingale (fun t γ => M t (pathMeasurableEquiv d γ)) (rawFiltration d)
      (P.map (pathMeasurableEquiv d).symm) := by
  have hmeas (t : ℝ≥0) : Measurable[rawFiltration d t, EinsteinRelation.pathFiltration d t]
      (pathMeasurableEquiv d) := by
    apply measurable_iff_comap_le.mpr
    change MeasurableSpace.comap Path.toContinuousMap
      (EinsteinRelation.pathFiltration d t) ≤ rawFiltration d t
    rw [rawFiltration_eq_comap]
  have hadapted : StronglyAdapted (rawFiltration d)
      (fun t γ => M t (pathMeasurableEquiv d γ)) :=
    fun t => (hM.stronglyMeasurable t).comp_measurable (hmeas t)
  have hint (t : ℝ≥0) : Integrable (fun γ => M t (pathMeasurableEquiv d γ))
      (P.map (pathMeasurableEquiv d).symm) := by
    apply (integrable_map_equiv (pathMeasurableEquiv d).symm _).mpr
    simpa only [Function.comp_def, MeasurableEquiv.apply_symm_apply] using hM.integrable t
  refine ⟨hadapted, fun s t hst => ?_⟩
  symm
  refine ae_eq_condExp_of_forall_setIntegral_eq ((rawFiltration d).le s)
    (hint t) (fun _ _ _ => (hint s).integrableOn) (fun A hA _ => ?_)
    (hadapted s).aestronglyMeasurable
  have hsymm : Measurable[EinsteinRelation.pathFiltration d s, rawFiltration d s]
      (pathMeasurableEquiv d).symm := by
    apply measurable_iff_comap_le.mpr
    rw [rawFiltration_eq_comap, MeasurableSpace.comap_comp]
    change MeasurableSpace.comap id (EinsteinRelation.pathFiltration d s) ≤ _
    rw [MeasurableSpace.comap_id]
  have hpre : MeasurableSet[EinsteinRelation.pathFiltration d s]
      ((pathMeasurableEquiv d).symm ⁻¹' A) := hA.preimage hsymm
  simpa only [setIntegral_map_equiv, MeasurableEquiv.apply_symm_apply] using
    hM.setIntegral_eq hst hpre

/-- Continuous martingales with deterministic finite-horizon bounds remain
martingales in the right-continuation of their filtration. -/
theorem martingale_rightCont_of_continuous_bounded
    {Ω : Type*} {m : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 m} {M : ℝ≥0 → Ω → ℝ} (hM : Martingale M F P)
    (hc : ∀ γ, Continuous (fun t => M t γ))
    (hb : ∀ T, ∃ C : ℝ, ∀ t ≤ T, ∀ γ, ‖M t γ‖ ≤ C) :
    Martingale M F.rightCont P := by
  have hadapted : StronglyAdapted F.rightCont M :=
    fun t => (hM.stronglyMeasurable t).mono (F.le_rightCont t)
  refine ⟨hadapted, fun s t hst => ?_⟩
  symm
  refine ae_eq_condExp_of_forall_setIntegral_eq (F.rightCont.le s) (hM.integrable t)
    (fun _ _ _ => (hM.integrable s).integrableOn) (fun A hA _ => ?_)
    (hadapted s).aestronglyMeasurable
  obtain rfl | hst := hst.eq_or_lt
  · rfl
  obtain ⟨u, _, hu, hulim⟩ := exists_seq_strictAnti_tendsto' hst
  obtain ⟨C, hC⟩ := hb t
  have hAu (n : ℕ) : MeasurableSet[F (u n)] A := by
    have hle : F.rightCont s ≤ F (u n) := by
      rw [F.rightCont_eq s]
      exact iInf₂_le_of_le (u n) (hu n).1 le_rfl
    exact hle A hA
  have heq (n : ℕ) : (∫ γ in A, M (u n) γ ∂P) = ∫ γ in A, M t γ ∂P :=
    hM.setIntegral_eq (hu n).2.le (hAu n)
  have hlim : Filter.Tendsto (fun n => ∫ γ in A, M (u n) γ ∂P) Filter.atTop
      (𝓝 (∫ γ in A, M s γ ∂P)) := by
    apply tendsto_integral_of_dominated_convergence (fun _ => C)
    · exact fun n => (hM.integrable (u n)).aestronglyMeasurable.restrict
    · exact integrable_const C
    · exact fun n => ae_of_all _ fun γ => hC (u n) (hu n).2.le γ
    · exact ae_of_all _ fun γ => (hc γ).continuousAt.tendsto.comp hulim
  exact tendsto_nhds_unique hlim (by simpa only [heq] using
    (tendsto_const_nhds : Filter.Tendsto (fun _ : ℕ => ∫ γ in A, M t γ ∂P) Filter.atTop
      (𝓝 (∫ γ in A, M t γ ∂P))))

/-- The nondivergence-form operator in Bass V.1: the factor one half multiplies
only the diffusion term; drift is neither symmetrized nor differentiated. -/
noncomputable def generator {d : ℕ} (a : Vec d → Mat d) (b : Vec d → Vec d)
    (f : Vec d → ℝ) (x : Vec d) : ℝ :=
  (1 / 2 : ℝ) * ∑ i, ∑ j, a x i j *
      fderiv ℝ (fun y => fderiv ℝ f y (unitVector j)) x (unitVector i) +
    ∑ i, b x i * fderiv ℝ f x (unitVector i)

/-- The source and existing draft operators are the identical differential expression. -/
theorem generator_eq_svGenerator {d : ℕ} (a : Vec d → Mat d) (b : Vec d → Vec d) :
    generator a b = Draft.svGenerator a b := rfl

/-- The source compensated process on actual continuous coordinate paths. -/
noncomputable def compensatedTest {d : ℕ} (a : Vec d → Mat d) (b : Vec d → Vec d)
    (f : Vec d → ℝ) (t : ℝ≥0) (γ : Path d) : ℝ :=
  f (γ t) - f (γ 0) - ∫ u in (0 : ℝ)..(t : ℝ), generator a b f (γ u.toNNReal)

/-- Carrier transport does not change the compensated differential expression. -/
theorem compensatedTest_eq_frozen {d : ℕ} (a : Vec d → Mat d) (b : Vec d → Vec d)
    (f : Vec d → ℝ) (t : ℝ≥0) (γ : Path d) :
    compensatedTest a b f t γ = EinsteinRelation.compensatedTest
      (Draft.svGenerator a b) f t (pathMeasurableEquiv d γ) := rfl

/-- Bounded coefficients and a compact C² test give a deterministic bound on
the compensated process over each finite horizon. -/
theorem compensatedTest_bounded {d : ℕ} {a : Vec d → Mat d} {b : Vec d → Vec d}
    {Ma Mb : ℝ} (haBound : ∀ y i j, |a y i j| ≤ Ma)
    (hbBound : ∀ y i, |b y i| ≤ Mb) {f : Vec d → ℝ}
    (hf : ContDiff ℝ 2 f) (hc : HasCompactSupport f) :
    ∀ T : ℝ≥0, ∃ C : ℝ, ∀ t ≤ T, ∀ γ : Path d, ‖compensatedTest a b f t γ‖ ≤ C := by
  obtain ⟨Cf, hCf⟩ := hf.continuous.bounded_above_of_compact_support hc
  obtain ⟨Cg, hCg⟩ := EinsteinFull.bounded_svGenerator a b haBound hbBound hf hc
  have hCg_nonneg : 0 ≤ Cg := (abs_nonneg _).trans (hCg 0)
  intro T
  refine ⟨2 * Cf + Cg * T, fun t ht γ => ?_⟩
  calc
    ‖compensatedTest a b f t γ‖ ≤ 2 * Cf + Cg * t :=
      EinsteinFull.norm_compensatedTest_le (Draft.svGenerator a b) f
        (fun y => by simpa only [Real.norm_eq_abs] using hCf y) hCg t
        (pathMeasurableEquiv d γ)
    _ ≤ 2 * Cf + Cg * T :=
      add_le_add_right (mul_le_mul_of_nonneg_left (NNReal.coe_le_coe.mpr ht) hCg_nonneg) _

/-- Local martingale in the source filtration: an increasing sequence of stopping
times tends almost surely to infinity, and every stopped process is integrable
at each deterministic time and is a martingale. No integrability is inferred
from Mathlib's martingale predicate alone. -/
def IsLocalMartingale {d : ℕ} (M : ℝ≥0 → Path d → ℝ) (P : Measure (Path d)) : Prop :=
  StronglyAdapted (filtration d) M ∧
    ∃ τ : ℕ → Path d → WithTop ℝ≥0, IsLocalizingSequence (filtration d) τ P ∧
      ∀ n, (∀ t, Integrable (stoppedProcess M (τ n) t) P) ∧
        Martingale (stoppedProcess M (τ n)) (filtration d) P

/-- A source local martingale bounded on every deterministic finite horizon is
a true martingale. This is the localization step needed for compact test functions;
it does not identify the raw and right-continuous martingale problems. -/
theorem IsLocalMartingale.martingale_of_bounded {d : ℕ} {M : ℝ≥0 → Path d → ℝ}
    {P : Measure (Path d)} [IsFiniteMeasure P] (hM : IsLocalMartingale M P)
    (hbound : ∀ T : ℝ≥0, ∃ C : ℝ, ∀ t ≤ T, ∀ γ : Path d, ‖M t γ‖ ≤ C) :
    Martingale M (filtration d) P := by
  obtain ⟨hadapted, τ, hτ, hstop⟩ := hM
  have hint (t : ℝ≥0) : Integrable (M t) P := by
    obtain ⟨C, hC⟩ := hbound t
    exact Integrable.of_bound ((hadapted t).mono ((filtration d).le t)).aestronglyMeasurable
      C (ae_of_all _ (hC t le_rfl))
  have hlim (t : ℝ≥0) : ∀ᵐ γ ∂P,
      Filter.Tendsto (fun n => stoppedProcess M (τ n) t γ)
        Filter.atTop (𝓝 (M t γ)) := by
    filter_upwards [hτ.tendsto_top] with γ hγ
    apply tendsto_const_nhds.congr'
    filter_upwards [hγ.eventually (eventually_gt_nhds
      (show (t : WithTop ℝ≥0) < ⊤ from WithTop.coe_lt_top t))] with n hn
    exact (stoppedProcess_eq_of_le hn.le).symm
  have hconv (t : ℝ≥0) (A : Set (Path d)) :
      Filter.Tendsto (fun n => ∫ γ in A, stoppedProcess M (τ n) t γ ∂P)
        Filter.atTop (𝓝 (∫ γ in A, M t γ ∂P)) := by
    obtain ⟨C, hC⟩ := hbound t
    refine tendsto_integral_of_dominated_convergence (fun _ => C)
      (fun n => ((hstop n).1 t).aestronglyMeasurable.restrict)
      (integrable_const _) (fun n => ae_of_all _ fun γ => ?_)
      (ae_restrict_of_ae (hlim t))
    exact hC _ (WithTop.untopA_le (min_le_left (t : WithTop ℝ≥0) (τ n γ))) γ
  refine ⟨hadapted, fun s t hst => ?_⟩
  symm
  refine ae_eq_condExp_of_forall_setIntegral_eq ((filtration d).le s) (hint t)
    (fun _ _ _ => (hint s).integrableOn) (fun A hA _ => ?_)
    (hadapted s).aestronglyMeasurable
  have hconv_s := hconv s A
  have hconv_t := hconv t A
  have heq (n : ℕ) : (∫ γ in A, stoppedProcess M (τ n) s γ ∂P) =
      ∫ γ in A, stoppedProcess M (τ n) t γ ∂P :=
    ((hstop n).2).setIntegral_eq hst hA
  simp_rw [heq] at hconv_s
  exact tendsto_nhds_unique hconv_s hconv_t

/-- The source martingale problem, with all C² tests and local martingales for
the right-continuous canonical filtration. The pathwise time-integrability
clause makes the compensator integral explicit. There is no Markov, Feller,
kernel-measurability, heat-kernel, reversibility or Dirichlet-form assertion. -/
def SolvesMartingaleProblem {d : ℕ} (a : Vec d → Mat d) (b : Vec d → Vec d)
    (x : Vec d) (P : Measure (Path d)) : Prop :=
  IsProbabilityMeasure P ∧ (∀ᵐ γ ∂P, γ 0 = x) ∧
    ∀ f : Vec d → ℝ, ContDiff ℝ 2 f →
      (∀ t : ℝ≥0, ∀ᵐ γ ∂P,
        IntervalIntegrable (fun u : ℝ => generator a b f (γ u.toNNReal))
          volume 0 (t : ℝ)) ∧
      IsLocalMartingale (compensatedTest a b f) P

/-- A source solution gives a solution of the frozen compact-smooth/raw-filtration
martingale problem. This is one direction only: uniqueness for the frozen problem
also requires lifting every frozen solution back to the source problem. -/
theorem SolvesMartingaleProblem.map {d : ℕ} {a : Vec d → Mat d} {b : Vec d → Vec d}
    {x : Vec d} {P : Measure (Path d)} (hP : SolvesMartingaleProblem a b x P)
    (ha : Measurable a) (hb : Measurable b) {Ma Mb : ℝ}
    (haBound : ∀ y i j, |a y i j| ≤ Ma) (hbBound : ∀ y i, |b y i| ≤ Mb) :
    EinsteinRelation.SolvesMartingaleProblem (Draft.svGenerator a b) x
      (P.map (pathMeasurableEquiv d)) := by
  letI : IsProbabilityMeasure P := hP.1
  have hcoef : EinsteinFull.BddCoef a b (max Ma Mb) :=
    ⟨fun i j => (show Continuous (fun A : Mat d => A i j) from
        (continuous_apply j).comp (continuous_apply i)).measurable.comp ha,
      fun i => (measurable_pi_apply i).comp hb,
      fun y i j => (haBound y i j).trans (le_max_left _ _),
      fun y i => (hbBound y i).trans (le_max_right _ _)⟩
  refine ⟨inferInstance, ?_, fun f hf hc => ?_⟩
  · exact (pathMeasurableEquiv d).measurableEmbedding.ae_map_iff.mpr hP.2.1
  have hf2 : ContDiff ℝ 2 f := EinsteinFull.contDiff_two_of_top hf
  have hm : Martingale (EinsteinRelation.compensatedTest (Draft.svGenerator a b) f)
      (EinsteinRelation.pathFiltration d) (P.map (pathMeasurableEquiv d)) :=
    martingale_map_pathMeasurableEquiv
      ((hP.2.2 f hf2).2.martingale_of_bounded
        (compensatedTest_bounded haBound hbBound hf2 hc))
      (EinsteinFull.stronglyAdapted_compensatedTest_of_measurable
        (Draft.svGenerator a b) f hf.continuous (hcoef.measurable_gen f))
  refine ⟨?_, hm.integrable, hm⟩
  intro t
  exact (pathMeasurableEquiv d).measurableEmbedding.ae_map_iff.mpr ((hP.2.2 f hf2).1 t)

/-- The forward bridge uses the literal source ellipticity and drift bounds;
an extra matrix-entry bound is derived, rather than assumed. -/
theorem SolvesMartingaleProblem.map_of_elliptic {d : ℕ}
    {a : Vec d → Mat d} {b : Vec d → Vec d} {x : Vec d} {P : Measure (Path d)}
    (hP : SolvesMartingaleProblem a b x P) (ha : Measurable a) (hb : Measurable b)
    {Λ₁ Λ₂ : ℝ} (hΛ₁ : 0 < Λ₁) (hsym : ∀ y, (a y).transpose = a y)
    (hell : ∀ y ξ, Λ₁ * euclideanSq ξ ≤ dot ξ ((a y).mulVec ξ) ∧
      dot ξ ((a y).mulVec ξ) ≤ Λ₁⁻¹ * euclideanSq ξ)
    (hbound : ∀ y i, |b y i| ≤ Λ₂) :
    EinsteinRelation.SolvesMartingaleProblem (Draft.svGenerator a b) x
      (P.map (pathMeasurableEquiv d)) := by
  apply hP.map ha hb (Mb := Λ₂) (Ma := Λ₁⁻¹) ?_ hbound
  apply EinsteinFull.abs_apply_le_of_isElliptic (inv_pos.mpr hΛ₁)
  intro y
  exact ⟨hsym y, fun ξ => by simpa only [inv_inv] using hell y ξ⟩

/-- Every compact smooth test of a frozen solution becomes a true martingale
in the source right-continuous filtration after inverse carrier transport.
The extension to all C² tests is a separate, still required localization step. -/
theorem compactSmooth_martingale_map_symm {d : ℕ}
    {a : Vec d → Mat d} {b : Vec d → Vec d} {x : Vec d}
    {P : Measure (EinsteinRelation.Path d)}
    (hP : EinsteinRelation.SolvesMartingaleProblem (Draft.svGenerator a b) x P)
    (ha : Measurable a) (hb : Measurable b) {Ma Mb : ℝ}
    (haBound : ∀ y i j, |a y i j| ≤ Ma) (hbBound : ∀ y i, |b y i| ≤ Mb)
    {f : Vec d → ℝ} (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hc : HasCompactSupport f) :
    Martingale (compensatedTest a b f) (filtration d)
      (P.map (pathMeasurableEquiv d).symm) := by
  letI : IsProbabilityMeasure P := hP.1
  have hcoef : EinsteinFull.BddCoef a b (max Ma Mb) :=
    ⟨fun i j => (show Continuous (fun A : Mat d => A i j) from
        (continuous_apply j).comp (continuous_apply i)).measurable.comp ha,
      fun i => (measurable_pi_apply i).comp hb,
      fun y i j => (haBound y i j).trans (le_max_left _ _),
      fun y i => (hbBound y i).trans (le_max_right _ _)⟩
  have hf2 : ContDiff ℝ 2 f := EinsteinFull.contDiff_two_of_top hf
  obtain ⟨Cg, hCg⟩ := EinsteinFull.bounded_svGenerator a b haBound hbBound hf2 hc
  apply martingale_rightCont_of_continuous_bounded
    (martingale_map_pathMeasurableEquiv_symm ((hP.2.2 f hf hc).2.2))
  · intro γ
    exact EinsteinFull.continuous_compensatedTest_time_of_bounded
      (Draft.svGenerator a b) f hf.continuous (hcoef.measurable_gen f) hCg
      (pathMeasurableEquiv d γ)
  · exact compensatedTest_bounded haBound hbBound hf2 hc

/- The following generic mollifier construction is copied from
`C10PhysicalMPCompactC2Martingale` and applies to the source's bounded Borel
coefficients. No continuity of the drift or of the generator is assumed. -/
open Filter Set
open scoped Convolution Pointwise

private theorem martingale_of_dominated_pointwise_limit
    {Ω : Type*} {m : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 m} {M : ℕ → ℝ≥0 → Ω → ℝ} {N : ℝ≥0 → Ω → ℝ}
    (hM : ∀ n, Martingale (M n) F P)
    (hlim : ∀ t γ, Tendsto (fun n => M n t γ) atTop (𝓝 (N t γ)))
    (hb : ∀ t, ∃ C : ℝ, ∀ n γ, ‖M n t γ‖ ≤ C) : Martingale N F P := by
  have had : StronglyAdapted F N := fun t =>
    stronglyMeasurable_of_tendsto atTop (fun n => (hM n).stronglyMeasurable t)
      (tendsto_pi_nhds.mpr (hlim t))
  have hNb (t : ℝ≥0) : ∃ C : ℝ, ∀ γ, ‖N t γ‖ ≤ C := by
    obtain ⟨C, hC⟩ := hb t
    exact ⟨C, fun γ => le_of_tendsto ((hlim t γ).norm)
      (Eventually.of_forall fun n => hC n γ)⟩
  have hNi (t : ℝ≥0) : Integrable (N t) P := by
    obtain ⟨C, hC⟩ := hNb t
    exact Integrable.of_bound ((had t).mono (F.le t)).aestronglyMeasurable C
      (ae_of_all _ hC)
  have hInt (t : ℝ≥0) (B : Set Ω) :
      Tendsto (fun n => ∫ γ in B, M n t γ ∂P) atTop (𝓝 (∫ γ in B, N t γ ∂P)) := by
    obtain ⟨C, hC⟩ := hb t
    apply tendsto_integral_of_dominated_convergence (fun _ => C)
    · exact fun n => ((hM n).integrable t).aestronglyMeasurable.restrict
    · exact integrable_const C
    · exact fun n => ae_of_all _ (hC n)
    · exact ae_of_all _ (hlim t)
  refine ⟨had, fun s t hst => ?_⟩
  apply Filter.EventuallyEq.symm
  refine ae_eq_condExp_of_forall_setIntegral_eq (F.le s) (hNi t)
    (fun _ _ _ => (hNi s).integrableOn) (fun B hB _ => ?_)
    (had s).aestronglyMeasurable
  exact tendsto_nhds_unique (hInt s B)
    (by simpa only [fun n => (hM n).setIntegral_eq hst hB] using hInt t B)

private noncomputable def dynkinConvolution {d : ℕ} {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] (k : Vec d → ℝ) (g : Vec d → E) : Vec d → E :=
  k ⋆[ContinuousLinearMap.lsmul ℝ ℝ, volume] g

/-- Differentiating a compact test under convolution differentiates the test. -/
private theorem fderiv_compact_convolution
    {d : ℕ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {k : Vec d → ℝ} {g : Vec d → E}
    (hk : LocallyIntegrable k volume) (hg : ContDiff ℝ 1 g)
    (hc : HasCompactSupport g) :
    fderiv ℝ (k ⋆[ContinuousLinearMap.lsmul ℝ ℝ, volume] g) =
      k ⋆[ContinuousLinearMap.lsmul ℝ ℝ, volume] (fderiv ℝ g) := by
  have hb : (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] E →L[ℝ] E).precompR (Vec d) =
      ContinuousLinearMap.lsmul ℝ ℝ := by
    ext a A
    rfl
  funext y
  have h := (hc.hasFDerivAt_convolution_right
    (ContinuousLinearMap.lsmul ℝ ℝ) hk hg y).fderiv
  rw [hb] at h
  exact h

private noncomputable def dynkinMollifierScale (n : ℕ) : ℝ := 1 / (n + 1 : ℝ)

private theorem dynkinMollifierScale_pos (n : ℕ) : 0 < dynkinMollifierScale n := by
  unfold dynkinMollifierScale
  positivity

private theorem dynkinMollifierScale_tendsto :
    Tendsto dynkinMollifierScale atTop (𝓝[>] (0 : ℝ)) := by
  refine tendsto_nhdsWithin_iff.mpr ⟨?_, Eventually.of_forall dynkinMollifierScale_pos⟩
  exact tendsto_one_div_add_atTop_nhds_zero_nat

/-- Approximation applies to scalar tests and their derivative-valued fields. -/
private theorem dynkin_mollifier_tendstoLocallyUniformly
    {d : ℕ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [CompleteSpace E] {G : Vec d → E} (hG : Continuous G) :
    TendstoLocallyUniformly
      (fun n => PDE.harmonicKernelScaled (dynkinMollifierScale n)
        ⋆[ContinuousLinearMap.lsmul ℝ ℝ, volume] G) G atTop := by
  have hs : Tendsto
      (fun n => Function.support (PDE.harmonicKernelScaled (d := d) (dynkinMollifierScale n)))
      atTop (𝓝 (0 : Vec d)).smallSets := by
    rw [tendsto_smallSets_iff]
    intro S hS
    obtain ⟨ε, hε, hεS⟩ := Metric.mem_nhds_iff.mp hS
    filter_upwards [(dynkinMollifierScale_tendsto.mono_right nhdsWithin_le_nhds).eventually
      (gt_mem_nhds hε)] with n hn
    intro y hy
    apply hεS
    have hy' := PDE.euclideanBall_subset_supBall (dynkinMollifierScale_pos n)
      (PDE.harmonicKernelScaled_tsupport_subset (dynkinMollifierScale_pos n)
        (subset_tsupport _ hy))
    exact Metric.ball_subset_ball hn.le hy'
  rw [tendstoLocallyUniformly_iff_forall_tendsto]
  intro x
  have hc : Tendsto
      (fun p : ℕ × Vec d =>
        (PDE.harmonicKernelScaled (dynkinMollifierScale p.1)
          ⋆[ContinuousLinearMap.lsmul ℝ ℝ, volume] G) p.2)
      (atTop ×ˢ 𝓝 x) (𝓝 (G x)) :=
    convolution_tendsto_right
      (Eventually.of_forall fun p => PDE.harmonicKernelScaled_nonneg (dynkinMollifierScale_pos p.1))
      (Eventually.of_forall fun p => PDE.harmonicKernelScaled_integral_eq_one
        (dynkinMollifierScale_pos p.1))
      (hs.comp tendsto_fst)
      (Eventually.of_forall fun _ => hG.aestronglyMeasurable)
      ((hG.tendsto x).comp tendsto_snd) tendsto_snd
  exact (((hG.tendsto x).comp tendsto_snd).prodMk_nhds hc).mono_right
    (nhds_le_uniformity (G x))

private noncomputable def dynkinMollification {d : ℕ} (f : Vec d → ℝ) (n : ℕ) : Vec d → ℝ :=
  PDE.harmonicKernelScaled (dynkinMollifierScale n)
    ⋆[ContinuousLinearMap.lsmul ℝ ℝ, volume] f

private theorem dynkinMollification_smooth {d : ℕ} {f : Vec d → ℝ}
    (hf : Continuous f) (n : ℕ) :
    ContDiff ℝ (⊤ : ℕ∞) (dynkinMollification f n) :=
  (PDE.harmonicKernelScaled_hasCompactSupport (dynkinMollifierScale_pos n)).contDiff_convolution_left
    (ContinuousLinearMap.lsmul ℝ ℝ) (PDE.harmonicKernelScaled_smooth _) hf.locallyIntegrable

private theorem dynkinMollification_compact {d : ℕ} {f : Vec d → ℝ}
    (hc : HasCompactSupport f) (n : ℕ) : HasCompactSupport (dynkinMollification f n) :=
  (PDE.harmonicKernelScaled_hasCompactSupport (dynkinMollifierScale_pos n)).convolution
    (ContinuousLinearMap.lsmul ℝ ℝ) hc

private theorem dynkinMollification_fderiv {d : ℕ} {f : Vec d → ℝ}
    (hf : ContDiff ℝ (2 : ℕ∞) f) (hc : HasCompactSupport f) (n : ℕ) :
    fderiv ℝ (dynkinMollification f n) =
      PDE.harmonicKernelScaled (dynkinMollifierScale n)
        ⋆[ContinuousLinearMap.lsmul ℝ ℝ, volume] (fderiv ℝ f) :=
  fderiv_compact_convolution (PDE.harmonicKernelScaled_smooth _).continuous.locallyIntegrable
    (hf.of_le (by norm_num)) hc

private theorem dynkinMollification_fderiv_fderiv {d : ℕ} {f : Vec d → ℝ}
    (hf : ContDiff ℝ (2 : ℕ∞) f) (hc : HasCompactSupport f) (n : ℕ) :
    fderiv ℝ (fderiv ℝ (dynkinMollification f n)) =
      dynkinConvolution (PDE.harmonicKernelScaled (dynkinMollifierScale n))
        (fderiv ℝ (fderiv ℝ f)) := by
  rw [dynkinMollification_fderiv hf hc]
  exact fderiv_compact_convolution (PDE.harmonicKernelScaled_smooth _).continuous.locallyIntegrable
    (hf.fderiv_right (m := 1) (by norm_num)) (hc.fderiv ℝ)

/-- The actual mollified tests converge together with their first two total derivatives. -/
private theorem dynkinMollification_c2_convergence {d : ℕ} {f : Vec d → ℝ}
    (hf : ContDiff ℝ (2 : ℕ∞) f) (hc : HasCompactSupport f) :
    TendstoLocallyUniformly (dynkinMollification f) f atTop ∧
    TendstoLocallyUniformly (fun n => fderiv ℝ (dynkinMollification f n))
      (fderiv ℝ f) atTop ∧
    TendstoLocallyUniformly (fun n => fderiv ℝ (fderiv ℝ (dynkinMollification f n)))
      (fderiv ℝ (fderiv ℝ f)) atTop := by
  refine ⟨dynkin_mollifier_tendstoLocallyUniformly hf.continuous, ?_, ?_⟩
  · simp_rw [dynkinMollification_fderiv hf hc]
    exact dynkin_mollifier_tendstoLocallyUniformly (hf.continuous_fderiv (by norm_num))
  · simp_rw [dynkinMollification_fderiv_fderiv hf hc]
    exact dynkin_mollifier_tendstoLocallyUniformly
      ((hf.fderiv_right (m := 1) (by norm_num)).continuous_fderiv (by norm_num))

/-- Every approximation is supported in a single compact enlargement. -/
private theorem dynkinMollification_common_support {d : ℕ} {f : Vec d → ℝ}
    (hc : HasCompactSupport f) :
    ∃ K : Set (Vec d), IsCompact K ∧ tsupport f ⊆ K ∧
      ∀ n, tsupport (dynkinMollification f n) ⊆ K := by
  let K := tsupport f + Metric.closedBall (0 : Vec d) 1
  have hK : IsCompact K := hc.isCompact.add (isCompact_closedBall 0 1)
  refine ⟨K, hK, ?_, ?_⟩
  · intro y hy
    exact ⟨y, hy, 0, by simp, by simp⟩
  · intro n
    apply closure_minimal ?_ hK.isClosed
    refine (support_convolution_subset_swap (ContinuousLinearMap.lsmul ℝ ℝ)).trans
      (add_subset_add subset_closure ?_)
    intro y hy
    have hb := PDE.euclideanBall_subset_supBall (dynkinMollifierScale_pos n)
      (PDE.harmonicKernelScaled_tsupport_subset (dynkinMollifierScale_pos n)
        (subset_tsupport _ hy))
    have hs : dynkinMollifierScale n ≤ 1 := by
      unfold dynkinMollifierScale
      apply (div_le_one (by positivity)).mpr
      have hn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
      linarith
    exact Metric.ball_subset_closedBall (hb.trans_le hs)


private theorem uniformly_of_common_compact_support {d : ℕ} {E : Type*} [NormedAddCommGroup E] {F : ℕ → Vec d → E}
    {f : Vec d → E} {K : Set (Vec d)} (hK : IsCompact K)
    (hF : ∀ n, Function.support (F n) ⊆ K) (hf : Function.support f ⊆ K)
    (hlim : TendstoLocallyUniformly F f atTop) : TendstoUniformly F f atTop := by
  have hu := (tendstoLocallyUniformlyOn_iff_tendstoUniformlyOn_of_compact hK).mp
    (hlim.tendstoLocallyUniformlyOn (s := K))
  rw [Metric.tendstoUniformly_iff]
  intro ε hε
  filter_upwards [(Metric.tendstoUniformlyOn_iff.mp hu) ε hε] with n hn
  intro y
  by_cases hy : y ∈ K
  · exact hn y hy
  · have hf0 : f y = 0 := Function.notMem_support.mp (fun hy' => hy (hf hy'))
    have hF0 : F n y = 0 := Function.notMem_support.mp (fun hy' => hy (hF n hy'))
    simpa only [hf0, hF0, dist_self] using hε

/-- All members of a uniformly convergent compact continuous sequence share a bound. -/
private theorem uniformly_convergent_compact_bound {d : ℕ} {E : Type*} [NormedAddCommGroup E] {F : ℕ → Vec d → E}
    {f : Vec d → E} (hFc : ∀ n, Continuous (F n))
    (hFk : ∀ n, HasCompactSupport (F n)) (hfc : Continuous f) (hfk : HasCompactSupport f)
    (hlim : TendstoUniformly F f atTop) : ∃ C : ℝ, ∀ n y, ‖F n y‖ ≤ C := by
  obtain ⟨C, hC⟩ := hfc.bounded_above_of_compact_support hfk
  choose B hB using fun n => (hFc n).bounded_above_of_compact_support (hFk n)
  obtain ⟨N, hN⟩ := eventually_atTop.mp ((Metric.tendstoUniformly_iff.mp hlim) 1 zero_lt_one)
  refine ⟨max (C + 1) (∑ n ∈ Finset.range N, max (B n) 0), fun n y => ?_⟩
  by_cases hn : N ≤ n
  · apply le_trans _ (le_max_left _ _)
    calc
      ‖F n y‖ ≤ ‖f y‖ + ‖F n y - f y‖ := norm_le_insert' _ _
      _ ≤ C + 1 := add_le_add (hC y) (by
        simpa only [dist_eq_norm, norm_sub_rev] using (hN n hn y).le)
  · apply le_trans _ (le_max_right _ _)
    exact (hB n y).trans ((le_max_left (B n) 0).trans
      (Finset.single_le_sum (fun k _ => le_max_right (B k) 0)
        (Finset.mem_range.mpr (Nat.lt_of_not_ge hn))))

/-- Iterated coordinate differentiation agrees with the second total derivative
for a C² function. -/
private theorem coordinateSecond_eq {d : ℕ} {f : Vec d → ℝ}
    (hf : ContDiff ℝ 2 f) (i j : Fin d) (y : Vec d) :
    EinsteinFull.D2 f i j y =
      fderiv ℝ (fderiv ℝ f) y (unitVector i) (unitVector j) := by
  unfold EinsteinFull.D2
  rw [fderiv_clm_apply
    ((hf.fderiv_right (m := 1) (by norm_num)).differentiable (by norm_num) y)
    (differentiableAt_const (unitVector j))]
  rw [fderiv_const_apply, ContinuousLinearMap.comp_zero, zero_add]
  rfl

private theorem dynkinMollification_uniform_convergence {d : ℕ} {f : Vec d → ℝ}
    (hf : ContDiff ℝ 2 f) (hc : HasCompactSupport f) :
    TendstoUniformly (dynkinMollification f) f atTop := by
  obtain ⟨K, hK, hfK, hgK⟩ := dynkinMollification_common_support hc
  apply uniformly_of_common_compact_support (F := dynkinMollification f) (f := f) hK
  · exact fun n => (subset_tsupport _).trans (hgK n)
  · exact (subset_tsupport _).trans hfK
  · exact (dynkinMollification_c2_convergence hf hc).1

private theorem dynkinMollification_uniform_fderiv_convergence {d : ℕ} {f : Vec d → ℝ}
    (hf : ContDiff ℝ 2 f) (hc : HasCompactSupport f) :
    TendstoUniformly (fun n => fderiv ℝ (dynkinMollification f n)) (fderiv ℝ f) atTop := by
  obtain ⟨K, hK, hfK, hgK⟩ := dynkinMollification_common_support hc
  apply uniformly_of_common_compact_support
    (F := fun n => fderiv ℝ (dynkinMollification f n)) (f := fderiv ℝ f) hK
  · exact fun n => (support_fderiv_subset ℝ (f := dynkinMollification f n)).trans (hgK n)
  · exact (support_fderiv_subset ℝ (f := f)).trans hfK
  · exact (dynkinMollification_c2_convergence hf hc).2.1

private theorem dynkinMollification_uniform_second_convergence {d : ℕ} {f : Vec d → ℝ}
    (hf : ContDiff ℝ 2 f) (hc : HasCompactSupport f) :
    TendstoUniformly (fun n => fderiv ℝ (fderiv ℝ (dynkinMollification f n)))
      (fderiv ℝ (fderiv ℝ f)) atTop := by
  obtain ⟨K, hK, hfK, hgK⟩ := dynkinMollification_common_support hc
  apply uniformly_of_common_compact_support
    (F := fun n => fderiv ℝ (fderiv ℝ (dynkinMollification f n)))
    (f := fderiv ℝ (fderiv ℝ f)) hK
  · intro n
    exact (support_fderiv_subset ℝ (f := fderiv ℝ (dynkinMollification f n))).trans
      ((tsupport_fderiv_subset ℝ (f := dynkinMollification f n)).trans (hgK n))
  · exact (support_fderiv_subset ℝ (f := fderiv ℝ f)).trans
      ((tsupport_fderiv_subset ℝ (f := f)).trans hfK)
  · exact (dynkinMollification_c2_convergence hf hc).2.2

private theorem dynkinMollification_uniform_c2_bound {d : ℕ} {f : Vec d → ℝ}
    (hf : ContDiff ℝ 2 f) (hc : HasCompactSupport f) :
    ∃ C0 C1 C2 : ℝ, ∀ n y,
      ‖dynkinMollification f n y‖ ≤ C0 ∧
      ‖fderiv ℝ (dynkinMollification f n) y‖ ≤ C1 ∧
      ‖fderiv ℝ (fderiv ℝ (dynkinMollification f n)) y‖ ≤ C2 := by
  have hgu := dynkinMollification_uniform_convergence hf hc
  have hDu := dynkinMollification_uniform_fderiv_convergence hf hc
  have hHu := dynkinMollification_uniform_second_convergence hf hc
  have hgn (n : ℕ) : ContDiff ℝ 2 (dynkinMollification f n) :=
    EinsteinFull.contDiff_two_of_top (dynkinMollification_smooth hf.continuous n)
  obtain ⟨C0, hC0⟩ := uniformly_convergent_compact_bound
    (fun n => (dynkinMollification_smooth hf.continuous n).continuous)
    (dynkinMollification_compact hc) hf.continuous hc hgu
  obtain ⟨C1, hC1⟩ := uniformly_convergent_compact_bound
    (fun n => (hgn n).continuous_fderiv (by norm_num))
    (fun n => (dynkinMollification_compact hc n).fderiv ℝ)
    (hf.continuous_fderiv (by norm_num)) (hc.fderiv ℝ) hDu
  obtain ⟨C2, hC2⟩ := uniformly_convergent_compact_bound
    (fun n => ((hgn n).fderiv_right (m := 1) (by norm_num)).continuous_fderiv (by norm_num))
    (fun n => ((dynkinMollification_compact hc n).fderiv ℝ).fderiv ℝ)
    ((hf.fderiv_right (m := 1) (by norm_num)).continuous_fderiv (by norm_num))
    ((hc.fderiv ℝ).fderiv ℝ) hHu
  exact ⟨C0, C1, C2, fun n y => ⟨hC0 n y, hC1 n y, hC2 n y⟩⟩

/-- Compact C² tests admit compact smooth approximations with pointwise
convergence through order two and a common bound through order two. The
second derivatives need no uniform Lipschitz bound. -/
theorem exists_compactSmooth_c2_approx {d : ℕ} {f : Vec d → ℝ}
    (hf : ContDiff ℝ 2 f) (hc : HasCompactSupport f) :
    ∃ g : ℕ → Vec d → ℝ,
      (∀ n, ContDiff ℝ (⊤ : ℕ∞) (g n) ∧ HasCompactSupport (g n)) ∧
      (∀ y, Tendsto (fun n => g n y) atTop (𝓝 (f y))) ∧
      (∀ j y, Tendsto (fun n => EinsteinFull.D1 (g n) j y) atTop
        (𝓝 (EinsteinFull.D1 f j y))) ∧
      (∀ i j y, Tendsto (fun n => EinsteinFull.D2 (g n) i j y) atTop
        (𝓝 (EinsteinFull.D2 f i j y))) ∧
      ∃ C : ℝ, ∀ n y, |g n y| ≤ C ∧
        (∀ j, |EinsteinFull.D1 (g n) j y| ≤ C) ∧
        ∀ i j, |EinsteinFull.D2 (g n) i j y| ≤ C := by
  have hj := dynkinMollification_c2_convergence hf hc
  have hgn (n : ℕ) : ContDiff ℝ 2 (dynkinMollification f n) :=
    EinsteinFull.contDiff_two_of_top (dynkinMollification_smooth hf.continuous n)
  obtain ⟨C0, C1, C2, hC⟩ := dynkinMollification_uniform_c2_bound hf hc
  refine ⟨dynkinMollification f, fun n =>
    ⟨dynkinMollification_smooth hf.continuous n, dynkinMollification_compact hc n⟩,
    fun y => hj.1.tendstoLocallyUniformlyOn.tendsto_at (Set.mem_univ y), ?_, ?_, max C0 (max C1 C2), ?_⟩
  · intro j y
    exact ((ContinuousLinearMap.apply ℝ ℝ (unitVector j)).continuous.tendsto _).comp
      (hj.2.1.tendstoLocallyUniformlyOn.tendsto_at (Set.mem_univ y))
  · intro i j y
    simp_rw [coordinateSecond_eq (hgn _) i j y, coordinateSecond_eq hf i j y]
    exact ((ContinuousLinearMap.apply ℝ ℝ (unitVector j)).continuous.tendsto _).comp
      (((ContinuousLinearMap.apply ℝ (Vec d →L[ℝ] ℝ) (unitVector i)).continuous.tendsto _).comp
        (hj.2.2.tendstoLocallyUniformlyOn.tendsto_at (Set.mem_univ y)))
  · have hu (i : Fin d) : ‖unitVector i‖ ≤ 1 := by
      simp only [unitVector, Pi.norm_single, norm_one, le_refl]
    intro n y
    refine ⟨?_, ?_, ?_⟩
    · rw [← Real.norm_eq_abs]
      exact ((hC n y).1).trans (le_max_left _ _)
    · intro j
      change |fderiv ℝ (dynkinMollification f n) y (unitVector j)| ≤ _
      rw [← Real.norm_eq_abs]
      exact ((fderiv ℝ (dynkinMollification f n) y).unit_le_opNorm (unitVector j) (hu j)).trans
        (((hC n y).2.1).trans ((le_max_left C1 C2).trans (le_max_right _ _)))
    · intro i j
      rw [coordinateSecond_eq (hgn n) i j y, ← Real.norm_eq_abs]
      exact (((fderiv ℝ (fderiv ℝ (dynkinMollification f n)) y (unitVector i)).unit_le_opNorm
        (unitVector j) (hu j)).trans
          ((fderiv ℝ (fderiv ℝ (dynkinMollification f n)) y).unit_le_opNorm (unitVector i) (hu i))).trans
        (((hC n y).2.2).trans ((le_max_right C1 C2).trans (le_max_right _ _)))

private theorem generator_bound_of_derivatives {d : ℕ} {A : Vec d → Mat d} {b : Vec d → Vec d} {M : ℝ}
    (h : EinsteinFull.BddCoef A b M) {m : ℝ} {u : Vec d → ℝ}
    (h1 : ∀ j y, |EinsteinFull.D1 u j y| ≤ m)
    (h2 : ∀ i j y, |EinsteinFull.D2 u i j y| ≤ m) (y : Vec d) :
    |Draft.svGenerator A b u y| ≤
      (1 / 2 : ℝ) * (d * (d * (M * m))) + d * (M * m) := by
  unfold Draft.svGenerator
  refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
  · rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
    refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    calc ∑ i, |∑ j, A y i j *
          fderiv ℝ (fun z => fderiv ℝ u z (unitVector j)) y (unitVector i)|
        ≤ ∑ _i : Fin d, ((d : ℝ) * (M * m)) := by
          refine Finset.sum_le_sum fun i _ => ?_
          refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
          calc ∑ j, |A y i j * fderiv ℝ (fun z => fderiv ℝ u z (unitVector j)) y (unitVector i)|
              ≤ ∑ _j : Fin d, (M * m) := by
                refine Finset.sum_le_sum fun j _ => ?_
                rw [abs_mul]
                exact mul_le_mul (h.Ab y i j) (h2 i j y) (abs_nonneg _)
                  ((abs_nonneg _).trans (h.Ab y i j))
            _ = d * (M * m) := by simp
      _ = d * (d * (M * m)) := by simp
  · refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    calc ∑ i, |b y i * fderiv ℝ u y (unitVector i)| ≤ ∑ _i : Fin d, (M * m) := by
          refine Finset.sum_le_sum fun i _ => ?_
          rw [abs_mul]
          exact mul_le_mul (h.bb y i) (h1 i y) (abs_nonneg _)
            ((abs_nonneg _).trans (h.bb y i))
      _ = d * (M * m) := by simp

/-- Compact C² tests of a frozen solution are true martingales in the
source right-continuous filtration. Bounded Borel coefficients suffice. -/
theorem compactC2_martingale_map_symm {d : ℕ}
    {a : Vec d → Mat d} {b : Vec d → Vec d} {x : Vec d}
    {P : Measure (EinsteinRelation.Path d)}
    (hP : EinsteinRelation.SolvesMartingaleProblem (Draft.svGenerator a b) x P)
    (ha : Measurable a) (hb : Measurable b) {Ma Mb : ℝ}
    (haBound : ∀ y i j, |a y i j| ≤ Ma) (hbBound : ∀ y i, |b y i| ≤ Mb)
    {f : Vec d → ℝ} (hf : ContDiff ℝ 2 f) (hc : HasCompactSupport f) :
    Martingale (compensatedTest a b f) (filtration d)
      (P.map (pathMeasurableEquiv d).symm) := by
  letI : IsProbabilityMeasure P := hP.1
  have hcoef : EinsteinFull.BddCoef a b (max Ma Mb) :=
    ⟨fun i j => (show Continuous (fun A : Mat d => A i j) from
        (continuous_apply j).comp (continuous_apply i)).measurable.comp ha,
      fun i => (measurable_pi_apply i).comp hb,
      fun y i j => (haBound y i j).trans (le_max_left _ _),
      fun y i => (hbBound y i).trans (le_max_right _ _)⟩
  obtain ⟨g, hgs, hg0, hg1, hg2, C, hCb⟩ := exists_compactSmooth_c2_approx hf hc
  let B : ℝ := (1 / 2 : ℝ) * (d * (d * (max Ma Mb * C))) + d * (max Ma Mb * C)
  have hGb (n : ℕ) (y : Vec d) : |Draft.svGenerator a b (g n) y| ≤ B :=
    generator_bound_of_derivatives hcoef
      (fun j y => (hCb n y).2.1 j) (fun i j y => (hCb n y).2.2 i j) y
  apply martingale_of_dominated_pointwise_limit
    (fun n => compactSmooth_martingale_map_symm hP ha hb haBound hbBound
      (hgs n).1 (hgs n).2)
  · intro t γ
    unfold compensatedTest
    refine ((hg0 (γ t)).sub (hg0 (γ 0))).sub ?_
    refine intervalIntegral.tendsto_integral_filter_of_dominated_convergence
      (fun _ => B) ?_ ?_ intervalIntegrable_const ?_
    · exact Eventually.of_forall fun n =>
        ((hcoef.measurable_gen (g n)).comp
          (γ.continuous.comp continuous_real_toNNReal).measurable).aestronglyMeasurable
    · exact Eventually.of_forall fun n => Eventually.of_forall fun u _ => by
        simpa only [Real.norm_eq_abs, generator_eq_svGenerator] using hGb n (γ u.toNNReal)
    · exact Eventually.of_forall fun u _ => hcoef.gen_tendsto hg1 hg2 (γ u.toNNReal)
  · intro t
    refine ⟨2 * C + B * t, fun n γ => ?_⟩
    exact EinsteinFull.norm_compensatedTest_le (Draft.svGenerator a b) (g n)
      (fun y => (hCb n y).1) (hGb n) t (pathMeasurableEquiv d γ)

/-- Bounded continuous martingales remain martingales after stopping. -/
private theorem martingale_stopped_continuous_bounded
    {Ω : Type*} {m : MeasurableSpace Ω} {P : Measure Ω} [IsFiniteMeasure P]
    {F : Filtration ℝ≥0 m} {M : ℝ≥0 → Ω → ℝ} (hM : Martingale M F P)
    (hc : ∀ γ, Continuous (fun t => M t γ))
    (hb : ∀ v, ∃ C : ℝ, ∀ t ≤ v, ∀ γ, ‖M t γ‖ ≤ C)
    {τ : Ω → WithTop ℝ≥0} (hτ : IsStoppingTime F τ) :
    Martingale (stoppedProcess M τ) F P := by
  classical
  let N := stoppedProcess M τ
  let T : ℝ≥0 → Ω → ℝ≥0 := fun t γ => (min (t : WithTop ℝ≥0) (τ γ)).untopA
  have hTcoe (t : ℝ≥0) (γ : Ω) : (T t γ : WithTop ℝ≥0) = min (t : WithTop ℝ≥0) (τ γ) := by
    have hne : min (t : WithTop ℝ≥0) (τ γ) ≠ ⊤ :=
      ne_top_of_le_ne_top WithTop.coe_ne_top (min_le_left _ _)
    change (((min (t : WithTop ℝ≥0) (τ γ)).untopA : ℝ≥0) : WithTop ℝ≥0) = _
    rw [WithTop.untopA_eq_untop hne, WithTop.coe_untop]
  have hTle (t : ℝ≥0) (γ : Ω) : T t γ ≤ t := by
    rw [← WithTop.coe_le_coe, hTcoe]
    exact min_le_left _ _
  have hTs (t : ℝ≥0) : IsStoppingTime F (fun γ => (T t γ : WithTop ℝ≥0)) := by
    simp only [hTcoe]
    exact (isStoppingTime_const F t).min hτ
  have had : StronglyAdapted F N := hM.stronglyAdapted.stoppedProcess hc hτ
  have hNi (t : ℝ≥0) : Integrable (N t) P := by
    obtain ⟨C, hC⟩ := hb t
    exact Integrable.of_bound ((had t).mono (F.le t)).aestronglyMeasurable C
      (ae_of_all _ fun γ => hC _ (hTle t γ) γ)
  refine ⟨had, fun s t hst => ?_⟩
  apply Filter.EventuallyEq.symm
  refine ae_eq_condExp_of_forall_setIntegral_eq (F.le s) (hNi t)
    (fun _ _ _ => (hNi s).integrableOn) (fun B hB _ => ?_) (had s).aestronglyMeasurable
  let A : Set Ω := B ∩ {γ | (s : WithTop ℝ≥0) < τ γ}
  have hA : MeasurableSet[F s] A := hB.inter (hτ.measurableSet_gt s)
  let V : Ω → ℝ≥0 := fun γ => max s (T t γ)
  have hV : IsStoppingTime F (fun γ => (V γ : WithTop ℝ≥0)) := by
    change IsStoppingTime F (fun γ => ((max s (T t γ) : ℝ≥0) : WithTop ℝ≥0))
    simp only [WithTop.coe_max]
    exact (isStoppingTime_const F s).max (hTs t)
  have hVi : Integrable (fun γ => M (V γ) γ) P := by
    obtain ⟨C, hC⟩ := hb t
    have hmeas := stronglyMeasurable_stoppedValue_of_le (hM.stronglyAdapted.isStronglyProgressive_of_continuous hc)
      hV (fun γ => WithTop.coe_le_coe.mpr (max_le hst (hTle t γ)))
    exact Integrable.of_bound (hmeas.mono (F.le t)).aestronglyMeasurable C
      (ae_of_all _ fun γ => by simpa [V] using hC (V γ) (max_le hst (hTle t γ)) γ)
  have hstop := EinsteinFull.setIntegral_stoppedValue_eq hM hb
    (fun γ v => (hc γ).continuousWithinAt)
    (isStoppingTime_const F s) hV (fun γ => le_max_left _ _)
    (fun _ => hst) (fun γ => max_le hst (hTle t γ)) (hM.integrable s) hVi
    (σ := fun _ => s) (τ := V) (K := t)
    (B := A) (by
      change MeasurableSet[(isStoppingTime_const F s).measurableSpace] A
      rw [IsStoppingTime.measurableSpace_const]
      exact hA)
  have heq : ∀ γ, B.indicator (fun γ => N t γ - N s γ) γ =
      A.indicator (fun γ => M (V γ) γ - M s γ) γ := by
    intro γ
    by_cases hγ : γ ∈ B
    · by_cases hsτ : (s : WithTop ℝ≥0) < τ γ
      · have hsT : s ≤ T t γ := by
          rw [← WithTop.coe_le_coe, hTcoe]
          exact le_min (WithTop.coe_le_coe.mpr hst) hsτ.le
        have hTs0 : T s γ = s := by
          apply WithTop.coe_injective
          rw [hTcoe, min_eq_left hsτ.le]
        simp only [Set.indicator_of_mem hγ, Set.indicator_of_mem (show γ ∈ A from ⟨hγ, hsτ⟩)]
        change M (T t γ) γ - M (T s γ) γ = _
        rw [hTs0, show V γ = T t γ from max_eq_right hsT]
      · have hτs : τ γ ≤ (s : WithTop ℝ≥0) := le_of_not_gt hsτ
        have he : T t γ = T s γ := by
          apply WithTop.coe_injective
          rw [hTcoe, hTcoe, min_eq_right (hτs.trans (WithTop.coe_le_coe.mpr hst)), min_eq_right hτs]
        simp only [Set.indicator_of_mem hγ, Set.indicator_of_notMem (show γ ∉ A from fun h => hsτ h.2)]
        change M (T t γ) γ - M (T s γ) γ = 0
        rw [he, sub_self]
    · simp only [Set.indicator_of_notMem hγ, Set.indicator_of_notMem (show γ ∉ A from fun h => hγ h.1)]
  have hi : ∫ γ in B, N t γ - N s γ ∂P = 0 := by
    rw [← integral_indicator (F.le s _ hB)]
    simp_rw [heq]
    rw [integral_indicator (F.le s _ hA), integral_sub hVi.integrableOn (hM.integrable s).integrableOn, hstop, sub_self]
  rw [integral_sub (hNi t).integrableOn (hNi s).integrableOn] at hi
  exact (sub_eq_zero.mp hi).symm

private theorem norm_path_before_ball_exit {d : ℕ} (R : ℝ) (γ : EinsteinRelation.Path d)
    (h0 : euclideanNorm (γ 0) < R) (t u : ℝ≥0)
    (hu : u ≤ MarkovProcess.ContinuousPath.exitTimeTrunc {y : Vec d | euclideanNorm y < R} t γ) :
    ‖γ u‖ ≤ R := by
  let U := {y : Vec d | euclideanNorm y < R}
  have hU : IsOpen U := isOpen_lt (EinsteinFull.Calculus.Feller.continuous_euclideanNorm d) continuous_const
  have hue : (u : ENNReal) ≤ MarkovProcess.ContinuousPath.exitTime U γ := by
    change (u : WithTop ℝ≥0) ≤ MarkovProcess.ContinuousPath.exitTimeTop U γ
    calc
      (u : WithTop ℝ≥0) ≤ (MarkovProcess.ContinuousPath.exitTimeTrunc U t γ : WithTop ℝ≥0) :=
        WithTop.coe_le_coe.mpr hu
      _ = min (MarkovProcess.ContinuousPath.exitTimeTop U γ) t :=
        MarkovProcess.ContinuousPath.coe_exitTimeTrunc U t γ
      _ ≤ MarkovProcess.ContinuousPath.exitTimeTop U γ := min_le_left _ _
  have hcl : γ u ∈ closure U := by
    rcases lt_or_eq_of_le hue with hlt | heq
    · exact subset_closure (MarkovProcess.ContinuousPath.mem_of_lt_exitTime U γ u hlt)
    · have hfin : MarkovProcess.ContinuousPath.exitTime U γ ≠ ⊤ := by
        rw [← heq]
        exact ENNReal.coe_ne_top
      have hf := MarkovProcess.ContinuousPath.coordinate_exitTime_mem_frontier U hU γ h0 hfin
      rw [← heq, ENNReal.toNNReal_coe] at hf
      exact frontier_subset_closure hf
  have heuc : euclideanNorm (γ u) ≤ R :=
    closure_minimal (fun y hy => le_of_lt hy)
      (isClosed_le (EinsteinFull.Calculus.Feller.continuous_euclideanNorm d) continuous_const) hcl
  exact (EinsteinFull.Calculus.S1.norm_le_euclideanNorm _).trans heuc


/-- A frozen stopping time pulls back to the source right-continuous filtration. -/
private theorem isStoppingTime_comp_pathMeasurableEquiv {d : ℕ}
    {τ : EinsteinRelation.Path d → WithTop ℝ≥0}
    (hτ : IsStoppingTime (EinsteinRelation.pathFiltration d) τ) :
    IsStoppingTime (filtration d) (fun γ => τ (pathMeasurableEquiv d γ)) := by
  intro t
  apply rawFiltration_le_filtration d t
  rw [rawFiltration_eq_comap]
  exact ⟨{γ | τ γ ≤ t}, hτ t, rfl⟩

/-- Stopping at a Euclidean-ball exit makes an arbitrary C² test a true
martingale for the inverse-transported law. -/
theorem c2_ball_stopped_martingale_map_symm {d : ℕ}
    {a : Vec d → Mat d} {b : Vec d → Vec d} {x : Vec d}
    {P : Measure (EinsteinRelation.Path d)}
    (hP : EinsteinRelation.SolvesMartingaleProblem (Draft.svGenerator a b) x P)
    (ha : Measurable a) (hb : Measurable b) {Ma Mb : ℝ}
    (haBound : ∀ y i j, |a y i j| ≤ Ma) (hbBound : ∀ y i, |b y i| ≤ Mb)
    {f : Vec d → ℝ} (hf : ContDiff ℝ 2 f) (R : ℝ) (hR : 0 < R) :
    Martingale (fun (t : ℝ≥0) (γ : Path d) => compensatedTest a b f
      (MarkovProcess.ContinuousPath.exitTimeTrunc {y : Vec d | euclideanNorm y < R}
        t (pathMeasurableEquiv d γ)) γ)
      (filtration d) (P.map (pathMeasurableEquiv d).symm) := by
  classical
  letI : IsProbabilityMeasure P := hP.1
  have hcoef : EinsteinFull.BddCoef a b (max Ma Mb) :=
    ⟨fun i j => (show Continuous (fun A : Mat d => A i j) from
        (continuous_apply j).comp (continuous_apply i)).measurable.comp ha,
      fun i => (measurable_pi_apply i).comp hb,
      fun y i j => (haBound y i j).trans (le_max_left _ _),
      fun y i => (hbBound y i).trans (le_max_right _ _)⟩
  obtain ⟨χ, hχ, _, _, hχ1, hχ0⟩ := EinsteinFull.exists_cutoff d
  let g := EinsteinFull.cutoffFn χ (R + 1) f
  have hRp : 0 < R + 1 := by linarith
  have hg : ContDiff ℝ 2 g :=
    ((hχ.of_le (by norm_num)).comp (contDiff_const_smul (R + 1)⁻¹)).mul hf
  have hgc : HasCompactSupport g := EinsteinFull.hasCompactSupport_cutoffFn f hRp hχ0
  have hM := compactC2_martingale_map_symm hP ha hb haBound hbBound hg hgc
  obtain ⟨Cg, hCg⟩ := EinsteinFull.bounded_svGenerator a b haBound hbBound hg hgc
  have hc : ∀ γ : Path d, Continuous (fun t => compensatedTest a b g t γ) := fun γ =>
    EinsteinFull.continuous_compensatedTest_time_of_bounded (Draft.svGenerator a b) g
      hg.continuous (hcoef.measurable_gen g) hCg (pathMeasurableEquiv d γ)
  let U := {y : Vec d | euclideanNorm y < R}
  have hU : IsOpen U :=
    isOpen_lt (EinsteinFull.Calculus.Feller.continuous_euclideanNorm d) continuous_const
  have hτ : IsStoppingTime (filtration d)
      (fun γ => MarkovProcess.ContinuousPath.exitTimeTop U (pathMeasurableEquiv d γ)) := by
    apply isStoppingTime_comp_pathMeasurableEquiv
    rw [EinsteinFull.pathFiltration_eq_canonical]
    exact MarkovProcess.ContinuousPath.isStoppingTime_exitTime U hU
  have hstopped := martingale_stopped_continuous_bounded hM hc
    (compensatedTest_bounded haBound hbBound hg hgc) hτ
  have hident : stoppedProcess (compensatedTest a b g)
      (fun γ => MarkovProcess.ContinuousPath.exitTimeTop U (pathMeasurableEquiv d γ)) =
      fun t γ => compensatedTest a b f
        (MarkovProcess.ContinuousPath.exitTimeTrunc U t (pathMeasurableEquiv d γ)) γ := by
    funext t γ
    change compensatedTest a b g
      ((min (t : WithTop ℝ≥0)
        (MarkovProcess.ContinuousPath.exitTimeTop U (pathMeasurableEquiv d γ))).untopA) γ = _
    rw [min_comm]
    change compensatedTest a b g
      (MarkovProcess.ContinuousPath.exitTimeTrunc U t (pathMeasurableEquiv d γ)) γ = _
    let T := MarkovProcess.ContinuousPath.exitTimeTrunc U t (pathMeasurableEquiv d γ)
    by_cases h0 : (pathMeasurableEquiv d γ) 0 ∈ U
    · have hpath : ∀ u ≤ T, ‖γ u‖ < R + 1 := fun u hu =>
        lt_of_le_of_lt (norm_path_before_ball_exit R (pathMeasurableEquiv d γ) h0 t u hu)
          (by linarith)
      have hge : ∀ u ≤ T, g =ᶠ[𝓝 (γ u)] f := fun u hu =>
        EinsteinFull.cutoffFn_eventuallyEq f hRp hχ1 (hpath u hu)
      unfold compensatedTest
      rw [(hge T le_rfl).eq_of_nhds, (hge 0 bot_le).eq_of_nhds]
      congr 1
      apply intervalIntegral.integral_congr
      intro u hu
      rw [Set.uIcc_of_le T.coe_nonneg] at hu
      have hut : u.toNNReal ≤ T := Real.toNNReal_le_iff_le_coe.mpr hu.2
      change Draft.svGenerator a b g (γ u.toNNReal) = Draft.svGenerator a b f (γ u.toNNReal)
      exact EinsteinFull.svGenerator_congr a b (hge _ hut)
    · have he0 : MarkovProcess.ContinuousPath.exitTime U (pathMeasurableEquiv d γ) = 0 :=
        le_antisymm (by simpa using (MarkovProcess.ContinuousPath.exitTime_le_of_notMem
          U (pathMeasurableEquiv d γ) 0 h0)) bot_le
      have hT0 : T = 0 := by
        apply WithTop.coe_injective
        rw [MarkovProcess.ContinuousPath.coe_exitTimeTrunc]
        change min (MarkovProcess.ContinuousPath.exitTime U (pathMeasurableEquiv d γ)) _ = _
        rw [he0]
        exact min_eq_left (WithTop.coe_le_coe.mpr (bot_le : (0 : ℝ≥0) ≤ t))
      change compensatedTest a b g T γ = compensatedTest a b f T γ
      rw [hT0]
      simp [compensatedTest]
  rw [hident] at hstopped
  exact hstopped

/-- A single increasing sequence of bounded Euclidean-ball exit times
localizes every C² compensated test of the inverse-transported law. -/
theorem allC2_localizing_sequence_map_symm {d : ℕ}
    {a : Vec d → Mat d} {b : Vec d → Vec d} {x : Vec d}
    {P : Measure (EinsteinRelation.Path d)}
    (hP : EinsteinRelation.SolvesMartingaleProblem (Draft.svGenerator a b) x P)
    (ha : Measurable a) (hb : Measurable b) {Ma Mb : ℝ}
    (haBound : ∀ y i j, |a y i j| ≤ Ma) (hbBound : ∀ y i, |b y i| ≤ Mb) :
    ∃ τ : ℕ → Path d → WithTop ℝ≥0,
      IsLocalizingSequence (filtration d) τ (P.map (pathMeasurableEquiv d).symm) ∧
      ∀ f : Vec d → ℝ, ContDiff ℝ 2 f → ∀ n : ℕ,
        Martingale (stoppedProcess (compensatedTest a b f) (τ n))
          (filtration d) (P.map (pathMeasurableEquiv d).symm) := by
  classical
  let _ : IsProbabilityMeasure P := hP.1
  let U : ℕ → Set (Vec d) := fun n => {y | euclideanNorm y < (n + 1 : ℝ)}
  let K : ℕ → ℝ≥0 := fun n => n + 1
  let τ : ℕ → Path d → WithTop ℝ≥0 := fun n γ =>
    (MarkovProcess.ContinuousPath.exitTimeTrunc (U n) (K n) (pathMeasurableEquiv d γ) : WithTop ℝ≥0)
  have hU (n : ℕ) : IsOpen (U n) :=
    isOpen_lt (EinsteinFull.Calculus.Feller.continuous_euclideanNorm d) continuous_const
  have hstop (n : ℕ) : IsStoppingTime (filtration d) (τ n) := by
    exact isStoppingTime_comp_pathMeasurableEquiv (τ := fun γ =>
      (MarkovProcess.ContinuousPath.exitTimeTrunc (U n) (K n) γ : WithTop ℝ≥0)) (by
      rw [EinsteinFull.pathFiltration_eq_canonical]
      exact MarkovProcess.ContinuousPath.isStoppingTime_exitTimeTrunc (U n) (hU n) (K n))
  refine ⟨τ, ⟨⟨hstop, ?_⟩, ?_⟩, ?_⟩
  · apply ae_of_all
    intro γ
    apply (WithTop.tendsto_nhds_top_iff _).mpr
    intro T
    have hK : ∀ᶠ n : ℕ in atTop, T + 1 ≤ K n := by
      obtain ⟨N, hN⟩ := exists_nat_gt (T + 1)
      filter_upwards [eventually_ge_atTop N] with n hn
      dsimp [K]
      exact (le_of_lt hN).trans ((Nat.cast_le.mpr hn).trans (le_add_of_nonneg_right zero_le_one))
    filter_upwards [EinsteinFull.Blueprint.physical_path_euclidean_ball_exit_exhaustion (pathMeasurableEquiv d γ) (T + 1), hK] with n hn hT
    have hex : ((T + 1 : ℝ≥0) : WithTop ℝ≥0) ≤ MarkovProcess.ContinuousPath.exitTimeTop (U n) (pathMeasurableEquiv d γ) := by
      have he := congrArg (fun u : ℝ≥0 => (u : WithTop ℝ≥0)) (hn (T + 1) le_rfl)
      rw [MarkovProcess.ContinuousPath.coe_exitTimeTrunc] at he
      exact he ▸ min_le_left _ _
    apply lt_of_lt_of_le (WithTop.coe_lt_coe.mpr (lt_add_one T))
    change ((T + 1 : ℝ≥0) : WithTop ℝ≥0) ≤ (MarkovProcess.ContinuousPath.exitTimeTrunc (U n) (K n) (pathMeasurableEquiv d γ) : WithTop ℝ≥0)
    rw [MarkovProcess.ContinuousPath.coe_exitTimeTrunc]
    exact le_min hex (WithTop.coe_le_coe.mpr hT)
  · apply ae_of_all
    intro γ m n hmn
    change (MarkovProcess.ContinuousPath.exitTimeTrunc (U m) (K m) (pathMeasurableEquiv d γ) : WithTop ℝ≥0) ≤
      (MarkovProcess.ContinuousPath.exitTimeTrunc (U n) (K n) (pathMeasurableEquiv d γ) : WithTop ℝ≥0)
    rw [MarkovProcess.ContinuousPath.coe_exitTimeTrunc,
      MarkovProcess.ContinuousPath.coe_exitTimeTrunc]
    apply min_le_min
    · change MarkovProcess.ContinuousPath.exitTime (U m) (pathMeasurableEquiv d γ) ≤ MarkovProcess.ContinuousPath.exitTime (U n) (pathMeasurableEquiv d γ)
      apply sInf_le_sInf
      rintro s ⟨t, rfl, ht⟩
      refine ⟨t, rfl, fun hm => ht ?_⟩
      change euclideanNorm ((pathMeasurableEquiv d γ) t) < (n + 1 : ℝ)
      exact lt_of_lt_of_le hm (by exact_mod_cast Nat.add_le_add_right hmn 1)
    · exact WithTop.coe_le_coe.mpr (by dsimp [K]; exact_mod_cast Nat.add_le_add_right hmn 1)
  · intro f hf n
    have hM := c2_ball_stopped_martingale_map_symm hP ha hb haBound hbBound hf
      (n + 1 : ℝ) (by positivity)
    have hdet : Martingale (fun t γ =>
        compensatedTest a b f
          (MarkovProcess.ContinuousPath.exitTimeTrunc (U n) (min t (K n)) (pathMeasurableEquiv d γ)) γ)
        (filtration d) (P.map (pathMeasurableEquiv d).symm) := by
      refine ⟨fun t => (hM.stronglyMeasurable (min t (K n))).mono
        ((filtration d).mono (min_le_left _ _)), ?_⟩
      intro s t hst
      by_cases hs : s ≤ K n
      · simpa only [min_eq_left hs] using hM.condExp_ae_eq (le_min hst hs)
      · have hKs : K n ≤ s := le_of_not_ge hs
        have hKt : K n ≤ t := hKs.trans hst
        simp only [min_eq_right hKs, min_eq_right hKt]
        exact (condExp_of_stronglyMeasurable ((filtration d).le s)
          ((hM.stronglyMeasurable (K n)).mono ((filtration d).mono hKs))
          (hM.integrable (K n))).eventuallyEq
    convert hdet using 1
    funext t γ
    unfold stoppedProcess
    dsimp only [τ]
    apply congrArg (fun u => compensatedTest a b f u γ)
    apply WithTop.coe_injective
    rw [WithTop.untopA_eq_untop (ne_top_of_le_ne_top WithTop.coe_ne_top (min_le_left _ _)),
      WithTop.coe_untop, MarkovProcess.ContinuousPath.coe_exitTimeTrunc,
      MarkovProcess.ContinuousPath.coe_exitTimeTrunc, WithTop.coe_min]
    exact min_left_comm _ _ _

/-- Along each continuous path, every C² generator is integrable on finite
intervals. A path-dependent cutoff supplies a bounded generator on that interval. -/
theorem intervalIntegrable_generator_path {d : ℕ}
    {a : Vec d → Mat d} {b : Vec d → Vec d}
    (ha : Measurable a) (hb : Measurable b) {Ma Mb : ℝ}
    (haBound : ∀ y i j, |a y i j| ≤ Ma) (hbBound : ∀ y i, |b y i| ≤ Mb)
    {f : Vec d → ℝ} (hf : ContDiff ℝ 2 f) (γ : Path d) (T : ℝ≥0) :
    IntervalIntegrable (fun u : ℝ => generator a b f (γ u.toNNReal)) volume 0 (T : ℝ) := by
  have hcoef : EinsteinFull.BddCoef a b (max Ma Mb) :=
    ⟨fun i j => (show Continuous (fun A : Mat d => A i j) from
        (continuous_apply j).comp (continuous_apply i)).measurable.comp ha,
      fun i => (measurable_pi_apply i).comp hb,
      fun y i j => (haBound y i j).trans (le_max_left _ _),
      fun y i => (hbBound y i).trans (le_max_right _ _)⟩
  obtain ⟨B, hB⟩ := isCompact_Icc.bddAbove_image
    ((continuous_norm.comp γ.continuous).continuousOn :
      ContinuousOn (fun s : ℝ≥0 => ‖γ s‖) (Icc 0 T))
  let R : ℝ := max B 0 + 1
  have hR : 0 < R := by dsimp [R]; linarith [le_max_right B 0]
  obtain ⟨χ, hχ, _, _, hχ1, hχ0⟩ := EinsteinFull.exists_cutoff d
  let g := EinsteinFull.cutoffFn χ R f
  have hg : ContDiff ℝ 2 g :=
    ((hχ.of_le (by norm_num)).comp (contDiff_const_smul R⁻¹)).mul hf
  have hgc : HasCompactSupport g := EinsteinFull.hasCompactSupport_cutoffFn f hR hχ0
  obtain ⟨Cg, hCg⟩ := EinsteinFull.bounded_svGenerator a b haBound hbBound hg hgc
  have hIg : IntervalIntegrable
      (fun u : ℝ => Draft.svGenerator a b g (γ u.toNNReal)) volume 0 (T : ℝ) := by
    refine (intervalIntegrable_const (c := Cg)).mono_fun ?_ ?_
    · exact ((hcoef.measurable_gen g).comp
        (γ.continuous.comp continuous_real_toNNReal).measurable).aestronglyMeasurable
    · exact Eventually.of_forall fun u => by
        simpa only [Real.norm_eq_abs] using (hCg (γ u.toNNReal)).trans (le_abs_self Cg)
  apply hIg.congr
  intro u hu
  rw [Set.uIoc_of_le T.coe_nonneg] at hu
  have hut : u.toNNReal ≤ T := Real.toNNReal_le_iff_le_coe.mpr hu.2
  have hnorm : ‖γ u.toNNReal‖ < R :=
    (hB ⟨u.toNNReal, ⟨bot_le, hut⟩, rfl⟩).trans_lt
      ((le_max_left B 0).trans_lt (lt_add_one (max B 0)))
  exact EinsteinFull.svGenerator_congr a b
    (EinsteinFull.cutoffFn_eventuallyEq f hR hχ1 hnorm)

/-- Every frozen compact-smooth/raw-filtration solution lifts to the source
all-C²/local/right-continuous martingale problem. -/
theorem solves_of_frozen {d : ℕ} {a : Vec d → Mat d} {b : Vec d → Vec d} {x : Vec d}
    {P : Measure (EinsteinRelation.Path d)}
    (hP : EinsteinRelation.SolvesMartingaleProblem (Draft.svGenerator a b) x P)
    (ha : Measurable a) (hb : Measurable b) {Ma Mb : ℝ}
    (haBound : ∀ y i j, |a y i j| ≤ Ma) (hbBound : ∀ y i, |b y i| ≤ Mb) :
    SolvesMartingaleProblem a b x (P.map (pathMeasurableEquiv d).symm) := by
  letI : IsProbabilityMeasure P := hP.1
  have hcoef : EinsteinFull.BddCoef a b (max Ma Mb) :=
    ⟨fun i j => (show Continuous (fun A : Mat d => A i j) from
        (continuous_apply j).comp (continuous_apply i)).measurable.comp ha,
      fun i => (measurable_pi_apply i).comp hb,
      fun y i j => (haBound y i j).trans (le_max_left _ _),
      fun y i => (hbBound y i).trans (le_max_right _ _)⟩
  obtain ⟨τ, hτ, htests⟩ := allC2_localizing_sequence_map_symm hP ha hb haBound hbBound
  refine ⟨inferInstance, ?_, fun f hf => ⟨?_, ?_⟩⟩
  · exact (pathMeasurableEquiv d).symm.measurableEmbedding.ae_map_iff.mpr hP.2.1
  · exact fun t => ae_of_all _ fun γ =>
      intervalIntegrable_generator_path ha hb haBound hbBound hf γ t
  · refine ⟨?_, τ, hτ, fun n => ⟨(htests f hf n).integrable, htests f hf n⟩⟩
    intro t
    have had := EinsteinFull.stronglyAdapted_compensatedTest_of_measurable
      (Draft.svGenerator a b) f hf.continuous (hcoef.measurable_gen f) t
    have hraw : StronglyMeasurable[rawFiltration d t] (compensatedTest a b f t) := by
      rw [rawFiltration_eq_comap]
      exact had.comp_measurable (comap_measurable Path.toContinuousMap)
    exact hraw.mono (rawFiltration_le_filtration d t)

/-- The measurable path equivalence preserves existence and uniqueness of
solutions under bounded measurable coefficients. -/
theorem unique_solution_iff_frozen {d : ℕ} {a : Vec d → Mat d} {b : Vec d → Vec d}
    (ha : Measurable a) (hb : Measurable b) {Ma Mb : ℝ}
    (haBound : ∀ y i j, |a y i j| ≤ Ma) (hbBound : ∀ y i, |b y i| ≤ Mb)
    (x : Vec d) :
    (∃! P : Measure (Path d), SolvesMartingaleProblem a b x P) ↔
      ∃! P : Measure (EinsteinRelation.Path d),
        EinsteinRelation.SolvesMartingaleProblem (Draft.svGenerator a b) x P := by
  constructor
  · rintro ⟨P, hP, huniq⟩
    refine ⟨P.map (pathMeasurableEquiv d), hP.map ha hb haBound hbBound, ?_⟩
    intro Q hQ
    have hQP := huniq (Q.map (pathMeasurableEquiv d).symm)
      (solves_of_frozen hQ ha hb haBound hbBound)
    have heq := congrArg (fun μ : Measure (Path d) => μ.map (pathMeasurableEquiv d)) hQP
    simpa only [map_pathMeasurableEquiv_symm_roundtrip] using heq
  · rintro ⟨P, hP, huniq⟩
    refine ⟨P.map (pathMeasurableEquiv d).symm,
      solves_of_frozen hP ha hb haBound hbBound, ?_⟩
    intro Q hQ
    have hQP := huniq (Q.map (pathMeasurableEquiv d)) (hQ.map ha hb haBound hbBound)
    have heq := congrArg (fun μ : Measure (EinsteinRelation.Path d) =>
      μ.map (pathMeasurableEquiv d).symm) hQP
    simpa only [map_pathMeasurableEquiv_roundtrip] using heq

/-- An entrywise bound gives a uniform Euclidean quadratic-form upper bound. -/
private theorem quadratic_upper_of_entry_bound {d : ℕ} {a : Vec d → Mat d} {M : ℝ}
    (haBound : ∀ y i j, |a y i j| ≤ M) (y ξ : Vec d) :
    dot ξ ((a y).mulVec ξ) ≤ ((d : ℝ) ^ 2 * max M 0) * euclideanSq ξ := by
  have hq : 0 ≤ euclideanSq ξ := by
    unfold euclideanSq dot
    exact Finset.sum_nonneg fun i _ => mul_self_nonneg (ξ i)
  have hterm (i j : Fin d) : ξ i * (a y i j * ξ j) ≤ max M 0 * euclideanSq ξ := by
    calc
      ξ i * (a y i j * ξ j) ≤ |ξ i * (a y i j * ξ j)| := le_abs_self _
      _ = |a y i j| * (|ξ i| * |ξ j|) := by rw [abs_mul, abs_mul]; ring
      _ ≤ max M 0 * (euclideanNorm ξ * euclideanNorm ξ) :=
        mul_le_mul ((haBound y i j).trans (le_max_left _ _))
          (mul_le_mul (EinsteinFull.Calculus.S1.abs_apply_le_euclideanNorm ξ i)
            (EinsteinFull.Calculus.S1.abs_apply_le_euclideanNorm ξ j)
            (abs_nonneg _) (Real.sqrt_nonneg _))
          (mul_nonneg (abs_nonneg _) (abs_nonneg _)) (le_max_right _ _)
      _ = max M 0 * euclideanSq ξ := by
        rw [euclideanNorm, Real.mul_self_sqrt hq]
  change (∑ i, ξ i * ∑ j, a y i j * ξ j) ≤ _
  simp_rw [Finset.mul_sum]
  calc
    (∑ i, ∑ j, ξ i * (a y i j * ξ j)) ≤
        ∑ _i : Fin d, ∑ _j : Fin d, max M 0 * euclideanSq ξ :=
      Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => hterm i j
    _ = _ := by
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      ring

/-- The frozen boundedness and lower ellipticity hypotheses provide the two
positive parameters appearing in the literal source statement. -/
theorem exists_source_parameters {d : ℕ} {a : Vec d → Mat d} {b : Vec d → Vec d}
    (hab : ∃ M : ℝ, ∀ x i j, |a x i j| ≤ M)
    (hell : ∃ c : ℝ, 0 < c ∧ ∀ x ξ,
      c * euclideanSq ξ ≤ dot ξ ((a x).mulVec ξ))
    (hbb : ∃ M : ℝ, ∀ x i, |b x i| ≤ M) :
    ∃ Λ₁ Λ₂ : ℝ, 0 < Λ₁ ∧ 0 < Λ₂ ∧
      (∀ x ξ, Λ₁ * euclideanSq ξ ≤ dot ξ ((a x).mulVec ξ) ∧
        dot ξ ((a x).mulVec ξ) ≤ Λ₁⁻¹ * euclideanSq ξ) ∧
      ∀ x i, |b x i| ≤ Λ₂ := by
  obtain ⟨M, haBound⟩ := hab
  obtain ⟨c, hc, hlow⟩ := hell
  obtain ⟨Mb, hbBound⟩ := hbb
  let K : ℝ := max ((d : ℝ) ^ 2 * max M 0) 1
  have hK : 0 < K := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  let Λ : ℝ := min c K⁻¹
  have hΛ : 0 < Λ := lt_min hc (inv_pos.mpr hK)
  refine ⟨Λ, max Mb 0 + 1, hΛ, by linarith [le_max_right Mb 0], ?_, ?_⟩
  · intro x ξ
    have hq : 0 ≤ euclideanSq ξ := by
      unfold euclideanSq dot
      exact Finset.sum_nonneg fun i _ => mul_self_nonneg (ξ i)
    refine ⟨(mul_le_mul_of_nonneg_right (min_le_left c K⁻¹) hq).trans (hlow x ξ), ?_⟩
    have hKΛ : K ≤ Λ⁻¹ := (le_inv_comm₀ hK hΛ).mpr (min_le_right c K⁻¹)
    exact (quadratic_upper_of_entry_bound haBound x ξ).trans
      (mul_le_mul_of_nonneg_right ((le_max_left _ _).trans hKΛ) hq)
  · intro x i
    exact (hbBound x i).trans ((le_max_left Mb 0).trans (le_add_of_nonneg_right zero_le_one))

end EinsteinFull.External.Bass

namespace EinsteinFull
open EinsteinRelation

/-- Transport a source solution to the frozen martingale problem with its
original existential coefficient bounds. -/
theorem bass_solves_to_frozen {d : ℕ} {a : Vec d → Mat d} {b : Vec d → Vec d}
    (ha : Measurable a) (hb : Measurable b)
    (hab : ∃ M : ℝ, ∀ x i j, |a x i j| ≤ M)
    (hbb : ∃ M : ℝ, ∀ x i, |b x i| ≤ M)
    {x : Vec d} {P : Measure (External.Bass.Path d)}
    (hP : External.Bass.SolvesMartingaleProblem a b x P) :
    SolvesMartingaleProblem (External.Draft.svGenerator a b) x
      (Measure.map (External.Bass.pathMeasurableEquiv d) P) := by
  obtain ⟨Ma, haBound⟩ := hab
  obtain ⟨Mb, hbBound⟩ := hbb
  exact hP.map ha hb haBound hbBound

/-- Inverse transport with the frozen problem's original existential bounds. -/
theorem frozen_solves_to_bass {d : ℕ} {a : Vec d → Mat d} {b : Vec d → Vec d}
    (ha : Measurable a) (hb : Measurable b)
    (hab : ∃ M : ℝ, ∀ x i j, |a x i j| ≤ M)
    (hbb : ∃ M : ℝ, ∀ x i, |b x i| ≤ M)
    {x : Vec d} {P : Measure (EinsteinRelation.Path d)}
    (hP : SolvesMartingaleProblem (External.Draft.svGenerator a b) x P) :
    External.Bass.SolvesMartingaleProblem a b x
      (Measure.map (External.Bass.pathMeasurableEquiv d).symm P) := by
  obtain ⟨Ma, haBound⟩ := hab
  obtain ⟨Mb, hbBound⟩ := hbb
  exact External.Bass.solves_of_frozen hP ha hb haBound hbBound

end EinsteinFull

