import EinsteinFull.External.DFGW.FutureEventProjection
import Mathlib.MeasureTheory.PiSystem

/-! # The future cylinder event system

Finite intersections of future state events form a π-system generating the future-coordinate
sigma-algebra.
-/

open MeasureTheory ProbabilityTheory
open scoped NNReal

namespace EinsteinFull.External.DFGW

variable {S : Type*} [TopologicalSpace S] [MeasurableSpace S] [BorelSpace S]

/-- Finite intersections of measurable future state events. -/
def futureCylinderEvents : Set (Set C(ℝ, S)) :=
  {A | ∃ xs : List (ℝ≥0 × Set S), (∀ p ∈ xs, MeasurableSet p.2) ∧
    A = futureCylinderEvent xs}

omit [BorelSpace S] in
/-- Future cylinder events form a π-system. -/
theorem isPiSystem_futureCylinderEvents : IsPiSystem (futureCylinderEvents (S := S)) := by
  intro A hA B hB _
  obtain ⟨xs, hxs, hx⟩ := hA
  obtain ⟨ys, hys, hy⟩ := hB
  rw [hx, hy]
  refine ⟨xs ++ ys, ?_, ?_⟩
  · intro p hp
    simp only [List.mem_append] at hp
    exact hp.elim (hxs p) (hys p)
  · ext η
    simp only [futureCylinderEvent, Set.mem_inter_iff, Set.mem_ofPred_eq, List.mem_append,
      or_imp, forall_and]

omit [BorelSpace S] in
/-- The future-coordinate sigma-algebra is generated by finite future cylinder events. -/
theorem futureCoordSigma_eq_generateFrom :
    Draft.dfgwCoordSigma (S := S) (Set.Ici 0) =
      MeasurableSpace.generateFrom (futureCylinderEvents (S := S)) := by
  apply le_antisymm
  · apply iSup₂_le
    intro t ht
    apply Measurable.comap_le
    intro A hA
    apply MeasurableSpace.GenerateMeasurable.basic
    refine ⟨[(t.toNNReal, A)], ?_, ?_⟩
    · intro p hp
      simp only [List.mem_singleton] at hp
      rw [hp]
      exact hA
    · ext η
      simp only [Set.mem_preimage, futureCylinderEvent, Set.mem_ofPred_eq,
        List.mem_singleton, forall_eq]
      rw [Real.coe_toNNReal t (show 0 ≤ t from ht)]
  · apply MeasurableSpace.generateFrom_le
    rintro B ⟨xs, hxs, rfl⟩
    induction xs with
    | nil => simp [futureCylinderEvent]
    | cons p xs ih =>
      obtain ⟨t, A⟩ := p
      have hA : MeasurableSet A := hxs (t, A) (by simp)
      have htail : ∀ p ∈ xs, MeasurableSet p.2 := fun p hp => hxs p (by simp [hp])
      have heval : Measurable[Draft.dfgwCoordSigma (S := S) (Set.Ici 0)]
          (fun η : C(ℝ, S) => η t) := by
        apply Measurable.of_comap_le
        exact le_iSup₂_of_le (f := fun u (_ : u ∈ Set.Ici (0 : ℝ)) =>
          MeasurableSpace.comap (fun η : C(ℝ, S) => η u) inferInstance)
          (t : ℝ) (by change (0 : ℝ) ≤ t; exact t.coe_nonneg) le_rfl
      have heq : futureCylinderEvent ((t, A) :: xs) =
          (fun η : C(ℝ, S) => η t) ⁻¹' A ∩ futureCylinderEvent xs := by
        ext η
        simp [futureCylinderEvent]
      rw [heq]
      exact (hA.preimage heval).inter (ih htail)

end EinsteinFull.External.DFGW
