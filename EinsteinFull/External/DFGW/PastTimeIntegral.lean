import EinsteinFull.External.DFGW.TimeAverage

/-! # Adaptedness of time integrals

When the path Borel sigma-algebra is generated by coordinates, the integral of a measurable
state observable up to a fixed time is measurable with respect to the past at that time.
-/

open MeasureTheory ProbabilityTheory
open scoped NNReal

namespace EinsteinFull.External.DFGW

variable {S : Type*} [TopologicalSpace S] [MeasurableSpace S] [BorelSpace S]

/-- Clamping a path at time `t` uses only coordinates up to time `t`. -/
theorem measurable_clamp_path (hcoord : Draft.dfgwCoordSigma (S := S) Set.univ =
    Draft.dfgwTrajectoryMeasurableSpace (S := S)) (t : ℝ) :
    Measurable[Draft.dfgwCoordSigma (Set.Iic t), Draft.dfgwTrajectoryMeasurableSpace]
      (fun η : C(ℝ, S) => η.comp ⟨fun u => min u t, continuous_id.min continuous_const⟩) := by
  apply Measurable.of_comap_le
  rw [← hcoord]
  simp only [Draft.dfgwCoordSigma, MeasurableSpace.comap_iSup, MeasurableSpace.comap_comp]
  refine iSup₂_le fun u hu => ?_
  change MeasurableSpace.comap (fun η : C(ℝ, S) => η (min u t)) inferInstance ≤ _
  exact le_iSup₂_of_le (f := fun v (_ : v ∈ Set.Iic t) =>
    MeasurableSpace.comap (fun η : C(ℝ, S) => η v) inferInstance)
      (min u t) (min_le_right u t) le_rfl

/-- A time integral of a measurable state observable is measurable with respect to the past. -/
theorem stronglyMeasurable_time_integral_past
    (hcoord : Draft.dfgwCoordSigma (S := S) Set.univ =
      Draft.dfgwTrajectoryMeasurableSpace (S := S))
    (g : S → ℝ) (hg : Measurable g) (t : ℝ≥0) :
    StronglyMeasurable[Draft.dfgwCoordSigma (Set.Iic (t : ℝ))]
      (fun η : C(ℝ, S) => ∫ u in (0 : ℝ)..t, g (η u)) := by
  have he : @Measurable (C(ℝ, S) × ℝ) S
      (Draft.dfgwTrajectoryMeasurableSpace.prod (borel ℝ)) inferInstance
      (fun z => z.1 z.2) := continuous_eval.measurable
  let σ := Draft.dfgwCoordSigma (S := S) (Set.Iic (t : ℝ))
  let clamp : C(ℝ, S) → C(ℝ, S) := fun η =>
    η.comp ⟨fun u => min u t, continuous_id.min continuous_const⟩
  have hc : Measurable[σ, Draft.dfgwTrajectoryMeasurableSpace] clamp :=
    measurable_clamp_path hcoord t
  have heval : Measurable[(borel ℝ).prod σ]
      (fun z : ℝ × C(ℝ, S) => clamp z.2 z.1) := by
    have hpair : @Measurable (ℝ × C(ℝ, S)) (C(ℝ, S) × ℝ) ((borel ℝ).prod σ)
        (Draft.dfgwTrajectoryMeasurableSpace.prod (borel ℝ))
        (fun z => (clamp z.2, z.1)) :=
      (hc.comp measurable_snd).prodMk measurable_fst
    exact he.comp hpair
  have hfun : StronglyMeasurable[(borel ℝ).prod σ]
      (fun z : ℝ × C(ℝ, S) => g (clamp z.2 z.1)) := (hg.comp heval).stronglyMeasurable
  have hint := hfun.integral_prod_left' (μ := volume.restrict (Set.Ioc (0 : ℝ) t))
  have heq : (fun η : C(ℝ, S) => ∫ u in (0 : ℝ)..t, g (η u)) =
      fun η => ∫ u, g (clamp η u) ∂(volume.restrict (Set.Ioc (0 : ℝ) t)) := by
    funext η
    rw [intervalIntegral.integral_of_le t.coe_nonneg]
    apply setIntegral_congr_fun measurableSet_Ioc
    intro u hu
    simp only [clamp, ContinuousMap.coe_comp, ContinuousMap.coe_mk, Function.comp_apply,
      min_eq_left hu.2]
  rw [heq]
  exact hint

end EinsteinFull.External.DFGW
