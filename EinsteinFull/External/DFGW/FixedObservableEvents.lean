import EinsteinFull.External.DFGW.FixedObservable

/-! # Events of fixed observables

A measurable function representing a fixed `L²` observable generates only invariant state
events. Ergodicity therefore gives each such event probability zero or one.
-/

open MeasureTheory ProbabilityTheory
open scoped NNReal

namespace EinsteinFull.External.DFGW

variable {S : Type*} [TopologicalSpace S] [MeasurableSpace S] [BorelSpace S]
variable {P : Measure C(ℝ, S)} {μ : Measure S} {T : ℝ≥0 → Kernel S S}

/-- Every measurable event generated by a transition fixed observable has probability zero or one. -/
theorem measure_preimage_eq_zero_or_one_of_fixed
    (hP : Draft.IsDFGWTrajectoryProcess P μ T) (f : Lp ℝ 2 μ)
    {t : ℝ≥0} (ht : 0 < t) (hf : transitionOperator hP t f = f)
    (g : S → ℝ) (hg : Measurable g) (hgf : g =ᵐ[μ] f)
    (B : Set ℝ) (hB : MeasurableSet B) : μ (g ⁻¹' B) = 0 ∨ μ (g ⁻¹' B) = 1 := by
  let : IsProbabilityMeasure P := hP.probability
  let : IsProbabilityMeasure μ := hP.invariant_probability
  have hA : MeasurableSet (g ⁻¹' B) := hg hB
  apply hP.ergodic (g ⁻¹' B) hA
  intro u
  let : IsMarkovKernel (T u) := hP.markov_kernel u
  let ev : C(ℝ, S) → S × S := fun η => (η 0, η u)
  have hev : Measurable ev := (continuous_eval_const 0).measurable.prodMk
    (continuous_eval_const (u : ℝ)).measurable
  have hpair : ∀ᵐ η ∂P, g (η 0) = g (η u) := by
    have h0 := (show MeasurePreserving (fun η : C(ℝ, S) => η 0) P μ from
      ⟨(continuous_eval_const 0).measurable, hP.marginal 0⟩).quasiMeasurePreserving.ae_eq_comp hgf
    have hu := (show MeasurePreserving (fun η : C(ℝ, S) => η u) P μ from
      ⟨(continuous_eval_const (u : ℝ)).measurable, hP.marginal u⟩).quasiMeasurePreserving.ae_eq_comp hgf
    filter_upwards [h0, hu, ae_eval_eq_of_transitionOperator_fixed hP f ht hf 0 u] with η h0 hu heq
    exact h0.trans (heq.trans hu.symm)
  have hprod : ∀ᵐ z ∂(μ ⊗ₘ T u), g z.1 = g z.2 := by
    rw [← map_pair_eq_compProd hP u]
    exact (ae_map_iff hev.aemeasurable (measurableSet_eq_fun (hg.comp measurable_fst)
      (hg.comp measurable_snd))).2 hpair
  filter_upwards [Measure.ae_ae_of_ae_compProd hprod] with x hx hxA
  apply (mem_ae_iff_prob_eq_one hA).1
  filter_upwards [hx] with y hy
  change g y ∈ B
  change g x ∈ B at hxA
  rw [← hy]
  exact hxA

end EinsteinFull.External.DFGW
