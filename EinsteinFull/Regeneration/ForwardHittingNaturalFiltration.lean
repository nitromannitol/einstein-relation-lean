import EinsteinFull.Regeneration.ForwardHittingFromSlabDrift
import EinsteinFull.Regeneration.CappedSlabIncrements

/-!
# Forward hitting and the natural slab filtration

The capped slab increments are adapted to their natural filtration. A positive
conditional drift for these increments therefore yields a forward-hitting bound.
-/

open MeasureTheory ProbabilityTheory EinsteinRelation EinsteinRelation.Regeneration
open scoped NNReal ENNReal ProbabilityTheory

namespace EinsteinFull.Regeneration

/-- The natural filtration generated by the normalized capped slab increments. -/
noncomputable def cappedSlabNaturalFiltration {Ω : Type*} [MeasurableSpace Ω] {d : ℕ}
    (γ : Ω → Path d) (hγ : Measurable γ) (i : Fin d) (r : ℝ) (g : ℝ≥0) :
    Filtration ℕ ‹MeasurableSpace Ω› :=
  Filtration.natural (fun n ω => cappedSlabIncrement (γ ω) i r g n)
    (fun n => ((measurable_cappedSlabIncrement i r g n).comp hγ).stronglyMeasurable)

/-- The capped slab increments are strongly adapted to their natural filtration. -/
theorem stronglyAdapted_cappedSlabIncrement_natural {Ω : Type*} [MeasurableSpace Ω] {d : ℕ}
    (γ : Ω → Path d) (hγ : Measurable γ) (i : Fin d) (r : ℝ) (g : ℝ≥0) :
    StronglyAdapted (cappedSlabNaturalFiltration γ hγ i r g)
      (fun n ω => cappedSlabIncrement (γ ω) i r g n) :=
  Filtration.stronglyAdapted_natural _

/-- Positive drift given the increment history implies a forward-hitting bound. -/
theorem forward_hitting_le_of_natural_slab_conditional_drift {Ω : Type*} [MeasurableSpace Ω]
    [StandardBorelSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    {d : ℕ} (γ : Ω → Path d) (hγ : Measurable γ) (i : Fin d)
    (lam L g : ℝ) (hlam : 0 < lam) (hL : (1 / 20 : ℝ) ≤ L) (hg : 0 < g)
    (hmean0 : (1 / 5 : ℝ) ≤ ∫ ω,
      cappedSlabIncrement (γ ω) i (L / lam) (Real.toNNReal (g / lam ^ 2)) 0 ∂μ)
    (hdrift : ∀ j, ∀ᵐ ω ∂μ, (1 / 5 : ℝ) ≤
      μ[fun ω => cappedSlabIncrement (γ ω) i (L / lam)
        (Real.toNNReal (g / lam ^ 2)) (j + 1) |
        cappedSlabNaturalFiltration γ hγ i (L / lam) (Real.toNNReal (g / lam ^ 2)) j] ω)
    (T : ℝ≥0) (a : ℝ) (ha : 0 ≤ a) :
    μ {ω | (T : ℝ≥0∞) ≤ firstHittingAbove (γ ω) i a} ≤
      ENNReal.ofReal (Real.exp (1 / 200) *
        Real.exp (-(1 / (400 * g)) * lam ^ 2 * (T : ℝ) + lam * a)) :=
  forward_hitting_le_of_capped_slab_conditional_drift μ γ i
    (cappedSlabNaturalFiltration γ hγ i (L / lam) (Real.toNNReal (g / lam ^ 2)))
    lam L g hlam hL hg
    (stronglyAdapted_cappedSlabIncrement_natural γ hγ i _ _) hmean0 hdrift T a ha

end EinsteinFull.Regeneration
