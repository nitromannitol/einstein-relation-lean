import EinsteinFull.Work.W1.GMPDeterministicRestartSupport
import Mathlib.MeasureTheory.Measure.WithDensity

/-!
# Restart of the actual GMP path law under its full deterministic past

The prefix sigma-algebra is proved equal to the sigma-algebra generated by all
positions through the displayed time. Finite-past restart extends to every
event of that sigma-algebra by reconstruction of finite continuous-path laws.
The resulting kernel identity holds for every spatial starting point, includes
null past events, and uses the literal restricted endpoint law.
-/

open MeasureTheory Filter ProbabilityTheory
open scoped NNReal ENNReal Topology
namespace EinsteinFull
open EinsteinRelation
open EinsteinRelation.External.GantertSection7Support
noncomputable section

/-- The complete continuous path prefix through the displayed deterministic time. -/
def gmpPrefixPath {d : ℕ} (s : ℝ≥0) (γ : Path d) : Path d :=
  ⟨fun t => γ (min t s), γ.continuous.comp (continuous_id.min continuous_const)⟩

/-- The literal path prefix is measurable on the actual continuous-path carrier. -/
theorem measurable_gmpPrefixPath {d : ℕ} (s : ℝ≥0) :
    Measurable (gmpPrefixPath (d := d) s) := by
  apply Continuous.measurable
  apply ContinuousMap.continuous_of_continuous_uncurry
  exact continuous_fst.eval (continuous_snd.min continuous_const)

/-- The natural past sigma-algebra generated by every position at times at most s. -/
def gmpPastSigma {d : ℕ} (s : ℝ≥0) : MeasurableSpace (Path d) :=
  ⨆ t : Set.Iic s, MeasurableSpace.comap (pathPosition (d := d) t.val) inferInstance

/-- The complete prefix generates exactly the natural past sigma-algebra. -/
theorem comap_gmpPrefixPath_eq_gmpPastSigma {d : ℕ} (s : ℝ≥0) :
    MeasurableSpace.comap (gmpPrefixPath (d := d) s) inferInstance = gmpPastSigma s := by
  apply le_antisymm
  · haveI : PolishSpace (Path d) := by
      haveI : CompleteSpace (Path d) := inferInstance
      haveI : Filter.IsCountablyGenerated (uniformity (Path d)) := inferInstance
      haveI : SecondCountableTopology (Path d) := inferInstance
      infer_instance
    obtain ⟨D, hD, hdecode⟩ :=
      EinsteinRelation.Probability.exists_measurable_continuousMap_decoder (X := ℝ≥0) (E := Vec d)
    have hraw : Measurable[gmpPastSigma (d := d) s]
        (fun γ : Path d => fun t : ℝ≥0 => γ (min t s)) := by
      letI : MeasurableSpace (Path d) := gmpPastSigma s
      apply Measurable.of_eval
      intro t
      exact Measurable.of_comap_le (le_iSup
        (fun u : Set.Iic s => MeasurableSpace.comap (pathPosition (d := d) u.val) inferInstance)
        ⟨min t s, show min t s ≤ s from min_le_right _ _⟩)
    have he : (fun γ : Path d => D (fun t => γ (min t s))) = gmpPrefixPath s :=
      funext (fun γ => hdecode (gmpPrefixPath s γ))
    have hm : Measurable[gmpPastSigma (d := d) s] (gmpPrefixPath s) := by
      rw [← he]
      exact hD.comp hraw
    exact hm.comap_le
  · apply iSup_le
    intro t
    have hp : Measurable[MeasurableSpace.comap (gmpPrefixPath (d := d) s) inferInstance]
        (gmpPrefixPath s) := Measurable.of_comap_le le_rfl
    have ht := (measurable_pathPosition t.val).comp hp
    have he : pathPosition t.val ∘ gmpPrefixPath (d := d) s = pathPosition t.val := by
      funext γ
      exact congrArg γ (min_eq_left t.property)
    rw [he] at ht
    exact ht.comap_le

/-- Every natural-past event is a Borel event of the actual continuous path. -/
theorem gmpPastSigma_le {d : ℕ} (s : ℝ≥0) :
    gmpPastSigma (d := d) s ≤ (inferInstance : MeasurableSpace (Path d)) := by
  rw [← comap_gmpPrefixPath_eq_gmpPastSigma]
  exact (measurable_gmpPrefixPath s).comap_le

private theorem continuous_listGetD {E : Type*} [TopologicalSpace E] (e : E) (n : ℕ) :
    Continuous (fun z : List E => z.getD n e) := by
  apply continuous_iff_continuousAt.mpr
  induction n with
  | zero =>
    apply List.tendsto_nhds
    · exact tendsto_pure_nhds _ _
    · intro l a _
      simpa only [List.getD_cons_zero] using
        (tendsto_fst : Tendsto (fun p : E × List E => p.1) (𝓝 a ×ˢ 𝓝 l) (𝓝 a))
  | succ n ih =>
    apply List.tendsto_nhds
    · exact tendsto_pure_nhds _ _
    · intro l a _
      have h : Tendsto (fun p : E × List E => p.2.getD n e) (𝓝 a ×ˢ 𝓝 l)
          (𝓝 (l.getD n e)) := Filter.Tendsto.comp (ih l) tendsto_snd
      simpa only [List.getD_cons_succ] using h

private theorem continuous_listRead {d : ℕ} (indices : List ℕ) :
    Continuous (fun z : List (Vec d) => indices.map (fun n => z.getD n 0)) := by
  induction indices with
  | nil => exact continuous_const
  | cons n ns ih =>
    exact List.continuous_cons.comp ((continuous_listGetD (0 : Vec d) n).prodMk ih)

private theorem cumulativeTimesFrom_getLastD (s : ℝ≥0) (inc : List ℝ≥0) :
    (cumulativeTimesFrom s inc).getLastD s = s + inc.sum := by
  induction inc generalizing s with
  | nil => simp only [cumulativeTimesFrom, List.getLastD_nil, List.sum_nil, add_zero]
  | cons t ts ih =>
    rw [cumulativeTimesFrom, List.getLastD_cons, ih, List.sum_cons, add_assoc]

private theorem prefix_observations {d : ℕ} (s : ℝ≥0) (ts : List ℝ≥0) :
    ∃ (pre : List ℝ≥0) (read : List (Vec d) → List (Vec d)),
      pre.sum = s ∧ Measurable read ∧ ∀ γ : Path d,
        pathPositionsAtTimes ts (gmpPrefixPath s γ) =
          read (pathPositionsAtTimes (cumulativeTimes pre) γ) := by
  classical
  let I := (ts.map (min · s)).toFinset
  let ordered := I.sort (· ≤ ·)
  let times := ordered ++ [s]
  have hbound : ∀ t ∈ ordered, t ≤ s := by
    intro t ht
    have : t ∈ ts.map (min · s) := List.mem_toFinset.mp ((Finset.mem_sort _).mp ht)
    obtain ⟨u, _, rfl⟩ := List.mem_map.mp this
    exact min_le_right _ _
  have hp : times.Pairwise (· ≤ ·) := by
    apply List.pairwise_append.mpr
    exact ⟨I.pairwise_sort _, by simp, fun a ha b hb => by
      obtain rfl : b = s := by simpa using hb
      exact hbound a ha⟩
  obtain ⟨pre, hpre⟩ := exists_cumulativeTimes_eq times hp
  have hsum : pre.sum = s := by
    have h := cumulativeTimesFrom_getLastD 0 pre
    change (cumulativeTimes pre).getLastD 0 = 0 + pre.sum at h
    rw [hpre] at h
    simpa only [times, List.getLastD_concat,
      zero_add] using h.symm
  let read : List (Vec d) → List (Vec d) := fun z =>
    ts.map (fun t => z.getD (times.idxOf (min t s)) 0)
  have hread : Measurable read := by
    have he : read = fun z : List (Vec d) =>
        (ts.map (fun t => times.idxOf (min t s))).map (fun n => z.getD n 0) := by
      funext z
      simp [read, List.map_map, Function.comp_def]
    rw [he]
    exact (continuous_listRead (d := d) (ts.map (fun t => times.idxOf (min t s)))).measurable
  refine ⟨pre, read, hsum, hread, ?_⟩
  intro γ
  rw [hpre]
  change ts.map (fun t => γ (min t s)) =
    ts.map (fun t => (times.map (fun r => γ r)).getD (times.idxOf (min t s)) 0)
  apply List.map_congr_left
  intro t ht
  have hm : min t s ∈ times := List.mem_append_left _ ((Finset.mem_sort _).mpr
    (List.mem_toFinset.mpr (List.mem_map.mpr ⟨t, ht, rfl⟩)))
  have hb : times.idxOf (min t s) < (times.map (fun r => γ r)).length := by
    simpa only [List.length_map] using List.idxOf_lt_length_iff.mpr hm
  rw [List.getD_eq_getElem _ _ hb, List.getElem_map,
    List.getElem_idxOf (List.idxOf_lt_length_iff.mpr hm)]


private theorem pathMeasure_eq_of_ordered_cylinder_measures {d : ℕ}
    (μ ν : Measure (Path d)) [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    (h : ∀ (inc : List ℝ≥0) (A : Set (List (Vec d))), MeasurableSet A →
      μ ((pathPositionsAtTimes (cumulativeTimes inc)) ⁻¹' A) =
        ν ((pathPositionsAtTimes (cumulativeTimes inc)) ⁻¹' A)) : μ = ν := by
  apply pathMeasure_eq_of_ordered_cylinder_integrals
  intro inc F hF _
  have he : μ.map (pathPositionsAtTimes (cumulativeTimes inc)) =
      ν.map (pathPositionsAtTimes (cumulativeTimes inc)) := by
    apply Measure.ext
    intro A hA
    rw [Measure.map_apply (measurable_pathPositionsAtTimes _) hA,
      Measure.map_apply (measurable_pathPositionsAtTimes _) hA]
    exact h inc A hA
  have hi := congrArg (fun m => ∫ z, F z ∂m) he
  simpa only [integral_map (measurable_pathPositionsAtTimes _).aemeasurable
    hF.aestronglyMeasurable] using hi

variable {d : ℕ} {hd : 2 ≤ d} {L : ℝ} {hL : 1 ≤ L} {ω : FieldPair d}
  {hω : IsRegular L ω} {lam : ℝ} {h₀ : 0 ≤ lam} {h₁ : lam ≤ 1}
  (G : GantertFixedEnvironmentRealization hd L hL ω hω lam h₀ h₁)

private theorem finitePast_restart_apply (pre : List ℝ≥0)
    (A : Set (List (Vec d))) (hA : MeasurableSet A)
    (B : Set (Path d)) (hB : MeasurableSet B) (x : Vec d) :
    (G.pathLaw x) ((gmpShiftPath pre.sum) ⁻¹' B ∩
      (pathPositionsAtTimes (cumulativeTimes pre)) ⁻¹' A) =
      ∫⁻ γ in (pathPositionsAtTimes (cumulativeTimes pre)) ⁻¹' A,
        G.pathLaw (γ pre.sum) B ∂G.pathLaw x := by
  letI := G.pathLaw_isMarkovKernel
  letI := isFiniteKernel_gmpPastCylinderKernel G pre A hA
  have h := congrArg (fun κ : Kernel (Vec d) (Path d) => κ x B)
    (gmpPastCylinderKernel_map_shift G pre A hA)
  rw [Kernel.map_apply _ (measurable_gmpShiftPath _),
    Measure.map_apply (measurable_gmpShiftPath _) hB, Kernel.comp_apply' _ _ _ hB,
    Kernel.map_apply _ (measurable_pathPosition _),
    lintegral_map (G.pathLaw.measurable_coe hB) (measurable_pathPosition _)] at h
  change ((G.pathLaw x).restrict
    ((pathPositionsAtTimes (cumulativeTimes pre)) ⁻¹' A))
      ((gmpShiftPath pre.sum) ⁻¹' B) = _ at h
  rw [Measure.restrict_apply (hB.preimage (measurable_gmpShiftPath _))] at h
  exact h

/-- Complete prefix laws weighted by a future event agree with the actual endpoint
transition probability; this holds for every starting point and Borel future event. -/
theorem gmpPathLaw_prefix_future (s : ℝ≥0) (B : Set (Path d))
    (hB : MeasurableSet B) (x : Vec d) :
    ((G.pathLaw x).restrict ((gmpShiftPath s) ⁻¹' B)).map (gmpPrefixPath s) =
      ((G.pathLaw x).withDensity (fun γ => G.pathLaw (γ s) B)).map (gmpPrefixPath s) := by
  letI := G.pathLaw_isMarkovKernel
  have hweight : (G.pathLaw x).withDensity (fun γ => G.pathLaw (γ s) B) ≤ G.pathLaw x := by
    calc
      _ ≤ (G.pathLaw x).withDensity 1 :=
        withDensity_mono (ae_of_all _ fun γ => prob_le_one)
      _ = _ := withDensity_one
  letI : IsFiniteMeasure ((G.pathLaw x).withDensity (fun γ => G.pathLaw (γ s) B)) :=
    isFiniteMeasure_of_le (G.pathLaw x) hweight
  apply pathMeasure_eq_of_ordered_cylinder_measures
  intro inc A hA
  obtain ⟨pre, read, hsum, hread, hobs⟩ := prefix_observations (d := d) s (cumulativeTimes inc)
  have hset : (gmpPrefixPath s) ⁻¹'
      ((pathPositionsAtTimes (cumulativeTimes inc)) ⁻¹' A) =
      (pathPositionsAtTimes (cumulativeTimes pre)) ⁻¹' (read ⁻¹' A) := by
    ext γ
    change pathPositionsAtTimes (cumulativeTimes inc) (gmpPrefixPath s γ) ∈ A ↔ _
    rw [hobs]
    rfl
  rw [Measure.map_apply (measurable_gmpPrefixPath _) (hA.preimage
      (measurable_pathPositionsAtTimes _)),
    Measure.map_apply (measurable_gmpPrefixPath _) (hA.preimage
      (measurable_pathPositionsAtTimes _)), hset,
    Measure.restrict_apply ((hA.preimage hread).preimage (measurable_pathPositionsAtTimes _)),
    withDensity_apply _ ((hA.preimage hread).preimage (measurable_pathPositionsAtTimes _))]
  rw [Set.inter_comm, ← hsum]
  exact finitePast_restart_apply G pre (read ⁻¹' A) (hA.preimage hread) B hB x


/-- The actual path kernel restricted to a Borel event of its complete prefix. -/
def gmpPastKernel (s : ℝ≥0) (A : Set (Path d)) (hA : MeasurableSet A) :
    Kernel (Vec d) (Path d) :=
  G.pathLaw.restrict (hA.preimage (measurable_gmpPrefixPath s))

/-- Restricting to any complete-prefix event gives a finite kernel, including null events. -/
theorem isFiniteKernel_gmpPastKernel (s : ℝ≥0) (A : Set (Path d)) (hA : MeasurableSet A) :
    IsFiniteKernel (gmpPastKernel G s A hA) := by
  letI := G.pathLaw_isMarkovKernel
  unfold gmpPastKernel
  infer_instance

/-- Deterministic restart under every Borel event of the complete past prefix,
for every starting point and as an equality of complete future path kernels. -/
theorem gmpPastKernel_map_shift (s : ℝ≥0) (A : Set (Path d)) (hA : MeasurableSet A) :
    (gmpPastKernel G s A hA).map (gmpShiftPath s) =
      G.pathLaw ∘ₖ ((gmpPastKernel G s A hA).map (pathPosition s)) := by
  letI := G.pathLaw_isMarkovKernel
  letI := isFiniteKernel_gmpPastKernel G s A hA
  apply Kernel.ext
  intro x
  apply Measure.ext
  intro B hB
  have h := congrArg (fun μ : Measure (Path d) => μ A) (gmpPathLaw_prefix_future G s B hB x)
  rw [Measure.map_apply (measurable_gmpPrefixPath _) hA,
    Measure.map_apply (measurable_gmpPrefixPath _) hA,
    Measure.restrict_apply (hA.preimage (measurable_gmpPrefixPath _)),
    withDensity_apply _ (hA.preimage (measurable_gmpPrefixPath _)), Set.inter_comm] at h
  rw [Kernel.map_apply _ (measurable_gmpShiftPath _),
    Measure.map_apply (measurable_gmpShiftPath _) hB, Kernel.comp_apply' _ _ _ hB,
    Kernel.map_apply _ (measurable_pathPosition _),
    lintegral_map (G.pathLaw.measurable_coe hB) (measurable_pathPosition _)]
  change ((G.pathLaw x).restrict ((gmpPrefixPath s) ⁻¹' A)) ((gmpShiftPath s) ⁻¹' B) = _
  rw [Measure.restrict_apply (hB.preimage (measurable_gmpShiftPath _))]
  exact h

/-- Complete deterministic restart under every event of the natural past
sigma-algebra, without a stopping-time or restart assumption. -/
theorem gmpPathLaw_restrict_past_map_shift (s : ℝ≥0) (E : Set (Path d))
    (hE : MeasurableSet[gmpPastSigma s] E) :
    (G.pathLaw.restrict (gmpPastSigma_le s E hE)).map (gmpShiftPath s) =
      G.pathLaw ∘ₖ ((G.pathLaw.restrict (gmpPastSigma_le s E hE)).map (pathPosition s)) := by
  have hp : MeasurableSet[MeasurableSpace.comap (gmpPrefixPath s) inferInstance] E := by
    rw [comap_gmpPrefixPath_eq_gmpPastSigma]
    exact hE
  obtain ⟨A, hA, hpre⟩ := MeasurableSpace.measurableSet_comap.mp hp
  simpa only [gmpPastKernel, hpre] using gmpPastKernel_map_shift G s A hA

end
end EinsteinFull
